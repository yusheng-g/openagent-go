          "description": "云硬盘创建时间。\n时间格式:UTC YYYY-MM-DDTHH:MM:SS.XXXXXX"
        },
        "os-vol-tenant-attr:tenant_id": {
          "type": "string",
          "description": "云硬盘所属的租户ID。租户ID就是项目ID。"
        },
