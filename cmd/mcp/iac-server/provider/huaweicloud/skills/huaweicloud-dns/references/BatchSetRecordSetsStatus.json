  "definitions": {
    "BatchSetRecordSetsStatusRequestBody": {
      "required": [
        "status",
        "recordset_ids"
      ],
      "properties": {
        "status": {
          "type": "string",
          "pattern": "DISABLE|ENABLE",
          "description": "**参数解释:**\n待设置记录集状态。\n**约束限制:**\n不涉及。\n**取值范围:**\n- DISABLE:暂停解析\n- ENABLE:启用解析\n\n**默认取值:**\n不涉及。"
        },
        "recordset_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 50,
          "description": "**参数解释:**\n待设置记录集ID列表。\n**约束限制:**\n最多支持50个。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。"
        }
      }
    },
    "metadata": {
      "properties": {
        "total_count": {
          "type": "integer",
          "description": "**参数解释:**\n满足查询条件的资源总数,不受分页(即limit、offset参数)影响。\n**取值范围:**\n不涉及。",
          "format": "int32",
          "readOnly": true
        }
      },
      "description": "**参数解释:**\n返回满足过滤条件的资源总数。\n**取值范围:**\n不涉及。"
    },
    "ErrorResponse": {
      "description": "**参数解释:**\n失败时返回的错误对象。\n**取值范围:**\n不涉及。",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "description": "**参数解释:**\n错误码。\n**取值范围:**\n不涉及。",
          "type": "string",
          "minLength": 8,
          "maxLength": 36
        },
        "message": {
          "description": "**参数解释:**\n错误描述。\n**取值范围:**\n不涉及。",
          "type": "string",
          "minLength": 2,
          "maxLength": 512
        }
      }
    },
    "RecordsetData": {
      "properties": {
        "id": {
          "type": "string",
          "description": "**参数解释:**\n记录集的ID。\n**取值范围:**\n不涉及。"
        },
        "name": {
          "type": "string",
          "description": "**参数解释:**\n记录集的名称。\n**取值范围:**\n不涉及。"
        },
        "description": {
          "type": "string",
          "description": "**参数解释:**\n记录集的描述信息。\n**取值范围:**\n长度不超过255个字符。"
        },
        "type": {
          "type": "string",
          "description": "**参数解释:**\n记录类型。\n**取值范围:**\n- A:将域名解析到指定的IPv4地址。\n- AAAA:将域名解析到指定的IPv6地址。\n- MX:指定域名对应的邮件服务器。\n- CNAME:将域名解析到另一域名,或者多个域名映射到同一域名上。\n- TXT:用于对域名进行标识和说明。\n- SRV:用于记录某台服务器对外提供了哪些服务。\n- NS:指定域名的权威DNS服务器。\n- SOA:提供域名的基本信息和权威服务器的详细信息。\n- CAA:指定为域名颁发HTTPS证书的授权CA机构,仅支持公网域名解析。\n- PTR:指定IP地址反向解析记录,仅支持内网域名解析。"
        },
        "ttl": {
          "type": "integer",
          "description": "**参数解释:**\n解析记录在本地DNS服务器的缓存时间,缓存时间越长更新生效越慢,以秒为单位。\n**取值范围:**\n1~2147483647。",
          "format": "int32"
        },
        "records": {
          "type": "array",
          "description": "**参数解释:**\n域名解析后的值。\n**取值范围:**\n不涉及。",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string",
          "description": "**参数解释:**\n记录集状态。\n**取值范围:**\n- ACTIVE:正常\n- PENDING_CREATE:创建中\n- PENDING_UPDATE:更新中\n- PENDING_DELETE:删除中\n- PENDING_FREEZE:冻结中\n- FREEZE:冻结\n- ILLEGAL:违规冻结\n- POLICE:公安冻结\n- PENDING_DISABLE:暂停中\n- DISABLE:暂停\n- ERROR:失败"
        },
        "zone_id": {
          "type": "string",
          "description": "**参数解释:**\n托管该记录的域名ID。\n**取值范围:**\n不涉及。"
        },
        "zone_name": {
          "type": "string",
          "description": "**参数解释:**\n托管该记录的域名。\n**取值范围:**\n不涉及。"
        },
        "line": {
          "type": "string",
          "description": "**参数解释:**\n解析线路ID。\n**取值范围:**\n不涉及。"
        },
        "alias_target": {
          "$ref": "#/definitions/alias_target",
          "description": "**参数解释:**\n别名记录。\n**取值范围:**\n不涉及。"
        },
        "created_at": {
          "type": "string",
          "description": "**参数解释:**\n创建时间。\n格式:yyyy-MM-dd'T'HH:mm:ss.SSS。\n**取值范围:**\n不涉及。"
        },
        "updated_at": {
          "type": "string",
          "description": "**参数解释:**\n更新时间。\n格式:yyyy-MM-dd'T'HH:mm:ss.SSS。\n**取值范围:**\n不涉及。"
        },
        "health_check_id": {
          "type": "string",
          "description": "**参数解释:**\n健康检查ID。\n**取值范围:**\n不涉及。"
        },
        "default": {
          "type": "boolean",
          "description": "**参数解释:**\n标识是否由系统默认生成,系统默认生成的记录集不能删除。\n**取值范围:**\n不涉及。"
        },
        "project_id": {
          "type": "string",
          "description": "**参数解释:**\n该记录集所属的项目ID。\n**取值范围:**\n不涉及。"
        },
        "links": {
          "$ref": "#/definitions/Link"
        },
        "weight": {
          "type": "integer",
          "description": "**参数解释:**\n解析记录的权重。\n**取值范围:**\n0~1000。",
          "format": "int32"
        }
      }
    },
    "alias_target": {
