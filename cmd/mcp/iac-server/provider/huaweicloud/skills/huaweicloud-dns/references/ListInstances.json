  "definitions": {
    "ZoneResolutionInstances": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "**参数解释:**\n域名ID。\n**取值范围:**\n不涉及。",
          "readOnly": true
        },
        "name": {
          "type": "string",
          "description": "**参数解释:**\n域名。\n**取值范围:**\n不涉及。",
          "readOnly": true
        },
        "status": {
          "type": "string",
          "description": "**参数解释:**\n域名状态。\n**取值范围:**\n- ACTIVE:正常\n- PENDING_CREATE:创建中\n- PENDING_UPDATE:更新中\n- PENDING_DELETE:删除中\n- PENDING_FREEZE:冻结中\n- FREEZE:冻结\n- ILLEGAL:违规冻结\n- POLICE:公安冻结\n- PENDING_DISABLE:暂停中\n- DISABLE:暂停\n- ERROR:失败",
          "readOnly": true
        },
        "region": {
          "type": "string",
          "description": "**参数解释:**\n域名所属的区域。\n**取值范围:**\n不涉及。",
          "default": "global",
          "readOnly": true
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "**参数解释:**\n企业项目ID。\n**取值范围:**\n不涉及。",
          "default": "0",
          "readOnly": true
        }
      }
    },
    "ListInstancesRequestBody": {
      "required": [
        "dim_name",
        "ids"
      ],
      "properties": {
        "dim_name": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "description": "**参数解释:**\nDNS批量查询接口支持查询的维度。\n**约束限制:**\n不涉及。\n**取值范围:**\n- dns_public_zone_id:公网域名ID\n- dns_public_recordset_id:公网记录集ID,需与dns_public_zone_id组合使用\n- dns_private_zone_id:内网域名ID\n- vpc_id:VPC ID,需与dns_private_zone_id组合使用\n**默认取值:**\n不涉及。",
          "items": {
            "type": "string",
            "pattern": "dns_zone_id|dns_recordset_id|dns_public_zone_id|dns_public_recordset_id|dns_private_zone_id|vpc_id"
          }
        },
        "ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "description": "DNS上报的资源ID列表。",
          "items": {
            "type": "array",
            "minItems": 0,
            "maxItems": 2,
            "items": {
              "type": "string",
              "pattern": "^[0-9a-zA-Z]{32}$|^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
              "description": "DNS上报资源ID,可包含域名ID、记录集ID、VPC ID。"
            }
          }
        }
      }
    },
    "RsetResolutionInstances": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "**参数解释:**\n记录集ID。\n**取值范围:**\n不涉及。",
          "readOnly": true
        },
        "name": {
          "type": "string",
          "description": "**参数解释:**\n记录集域名。\n**取值范围:**\n不涉及。",
          "readOnly": true
        },
        "status": {
          "type": "string",
          "description": "**参数解释:**\n记录集状态。\n**取值范围:**\n- ACTIVE:正常\n- PENDING_CREATE:创建中\n- PENDING_UPDATE:更新中\n- PENDING_DELETE:删除中\n- PENDING_FREEZE:冻结中\n- FREEZE:冻结\n- ILLEGAL:违规冻结\n- POLICE:公安冻结\n- PENDING_DISABLE:暂停中\n- DISABLE:暂停\n- ERROR:失败",
          "readOnly": true
        },
        "type": {
          "type": "string",
          "description": "**参数解释:**\n记录集类型。\n**取值范围:**\n- A:将域名解析到指定的IPv4地址。\n- AAAA:将域名解析到指定的IPv6地址。\n- MX:指定域名对应的邮件服务器。\n- CNAME:将域名解析到另一域名,或者多个域名映射到同一域名上。\n- TXT:用于对域名进行标识和说明。\n- SRV:用于记录某台服务器对外提供了哪些服务。\n- NS:指定域名的权威DNS服务器。\n- SOA:提供域名的基本信息和权威服务器的详细信息。\n- CAA:指定为域名颁发HTTPS证书的授权CA机构,仅支持公网域名解析。\n- PTR:指定IP地址反向解析记录,仅支持内网域名解析。",
          "readOnly": true
        }
      }
    },
    "VpcResolutionInstances": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "**参数解释:**\nVPC ID。\n**取值范围:**\n不涉及。",
          "readOnly": true
        },
        "name": {
          "type": "string",
          "description": "**参数解释:**\nVPC名称。\n**取值范围:**\n不涉及。",
          "readOnly": true
        }
      }
    },
    "ListInstancesResponseBody": {
      "type": "object",
      "properties": {
        "instances": {
          "type": "array",
          "description": "返回查询到的解析量资源实例。",
          "readOnly": true,
          "items": {
            "$ref": "#/definitions/ResolutionInstances"
          }
        }
      }
    },
    "ResolutionInstances": {
      "type": "object",
      "properties": {
        "dns_public_zone_id": {
          "description": "公网域名的资源详情。",
          "$ref": "#/definitions/ZoneResolutionInstances"
        },
        "dns_public_recordset_id": {
          "description": "公网记录集的资源详情,需与dns_public_zone_id组合使用。",
          "$ref": "#/definitions/RsetResolutionInstances"
        },
        "dns_private_zone_id": {
          "description": "内网域名的资源详情。",
          "$ref": "#/definitions/ZoneResolutionInstances"
        },
        "vpc_id": {
          "description": "VPC的资源详情,需与dns_private_zone_id组合使用。",
          "$ref": "#/definitions/VpcResolutionInstances"
        }
      },
      "description": "**参数解释:**\nDNS批量查询接口支持响应的维度。\n**取值范围:**\n- dns_public_zone_id:公网域名ID\n- dns_public_recordset_id:公网记录集ID,需与dns_public_zone_id组合使用\n- dns_private_zone_id:内网域名ID\n- vpc_id:VPC ID,需与dns_private_zone_id组合使用"
    }
  },
