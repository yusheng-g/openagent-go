  "definitions": {
    "Floatingips": {
      "properties": {
        "id": {
          "type": "string",
          "description": "反向解析记录的ID,格式形如{region}:{floatingip_id}。"
        },
        "ptrdname": {
          "type": "string",
          "description": "反向解析记录对应的域名。"
        },
        "description": {
          "type": "string",
          "description": "对反向解析记录的描述。"
        },
        "ttl": {
          "type": "integer",
          "description": "反向解析记录在本地DNS服务器的缓存时间,缓存时间越长更新生效越慢,以秒为单位。",
          "format": "int32"
        },
        "address": {
          "type": "string",
          "description": "弹性公网IP的IP地址。"
        },
        "status": {
          "type": "string",
          "description": "**参数解释:**\n资源状态。\n**取值范围:**\n- ACTIVE:正常\n- PENDING_CREATE:创建中\n- PENDING_UPDATE:更新中\n- PENDING_DELETE:删除中\n- PENDING_FREEZE:冻结中\n- FREEZE:冻结\n- ILLEGAL:违规冻结\n- POLICE:公安冻结\n- ERROR:失败"
        },
        "action": {
          "type": "string",
          "description": "**参数解释:**\n对该资源的当前操作。\n**取值范围:**\n- CREATE:创建操作\n- UPDATE:更新操作\n- DELETE:删除操作\n- NONE:无操作"
        },
        "links": {
          "$ref": "#/definitions/pageLink"
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "反向解析关联的企业项目ID,长度不超过36个字符。"
        }
      }
    },
    "pageLink": {
      "properties": {
        "self": {
          "type": "string",
          "description": "**参数解释:**\n当前页面的链接。\n**取值范围:**\n不涉及。",
          "readOnly": true
        },
        "next": {
          "type": "string",
          "description": "**参数解释:**\n下一页的链接。\n**取值范围:**\n不涉及。",
          "readOnly": true
        }
      },
      "description": "**参数解释:**\n指向当前页或者其他页的链接。当查询需要分页时,需要包含一个next链接指向下一页。\n**取值范围:**\n不涉及。"
