  "definitions": {
    "ErrorResponse": {
      "description": "**参数解释:**\n失败时返回的错误对象。\n**取值范围:**\n不涉及。",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "description": "**参数解释:**\n错误码。\n**取值范围:**\n不涉及。",
          "type": "string",
          "minLength": 8,
          "maxLength": 36
        },
        "message": {
          "description": "**参数解释:**\n错误描述。\n**取值范围:**\n不涉及。",
          "type": "string",
          "minLength": 2,
          "maxLength": 512
        }
      }
    },
    "Ipaddresses": {
      "required": [
        "ipaddress"
      ],
      "properties": {
        "ipaddress": {
          "description": "待绑定IP对象。",
          "$ref": "#/definitions/IpaddressInfo"
        }
      }
    },
    "AssociateEndpointIpaddressResp": {
      "properties": {
        "endpoint": {
          "description": "终端节点对象。",
          "$ref": "#/definitions/EndpointResp"
        }
      }
    },
    "EndpointResp": {
      "properties": {
        "id": {
          "type": "string",
          "description": "终端节点的ID,UUID形式的一个资源标识。",
          "readOnly": true
        },
        "name": {
          "type": "string",
          "description": "终端节点的名称。"
        },
        "direction": {
          "type": "string",
          "description": "终端节点方向。\n取值:\ninbound,表示入站终端节点。\noutbound,表示出站终端节点。",
          "readOnly": true
        },
        "status": {
          "type": "string",
          "description": "**参数解释:**\n资源状态。\n**取值范围:**\n- ACTIVE:正常\n- PENDING_CREATE:创建中\n- PENDING_DELETE:删除中\n- ERROR:失败",
          "readOnly": true
        },
        "vpc_id": {
          "type": "string",
          "description": "终端节点所属的VPC ID。",
          "readOnly": true
        },
        "ipaddress_count": {
          "type": "integer",
          "description": "该终端节点下的IP地址数量。",
          "format": "int32",
          "readOnly": true
        },
        "resolver_rule_count": {
          "type": "integer",
          "description": "该终端节点下的转发规则数量。\n仅创建出站终端节点时返回该参数。",
          "format": "int32",
          "readOnly": true
        },
        "create_time": {
          "type": "string",
          "description": "创建时间。\n格式:yyyy-MM-dd'T'HH:mm:ss.SSS。",
          "readOnly": true
        },
        "update_time": {
          "type": "string",
          "description": "更新时间。\n格式:yyyy-MM-dd'T'HH:mm:ss.SSS。",
          "readOnly": true
        }
      }
    },
    "IpaddressInfo": {
      "required": [
        "subnet_id"
      ],
      "properties": {
        "subnet_id": {
          "type": "string",
          "description": "子网的ID。",
          "pattern": "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"
        },
        "ip": {
          "type": "string",
          "description": "自定义IP地址,需在子网的网段内部。",
          "pattern": "^(1\\d{2}|2[0-4]\\d|25[0-5]|[1-9]\\d|[1-9])\\.(1\\d{2}|2[0-4]\\d|25[0-5]|[1-9]\\d|\\d)\\.(1\\d{2}|2[0-4]\\d|25[0-5]|[1-9]\\d|\\d)\\.(1\\d{2}|2[0-4]\\d|25[0-5]|[1-9]\\d|\\d)$"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "EndpointIdInPath": {
      "name": "endpoint_id",
      "in": "path",
      "required": true,
      "type": "string",
      "description": "终端节点ID。",
      "pattern": "[0-9a-fA-F]{32}"
    },
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "**参数解释:**\n用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。\n获取用户Token请参见[获取用户Token](https://support.huaweicloud.com/api-dns/dns_api_30003.html)。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。",
      "required": true,
      "type": "string",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    }
  },
