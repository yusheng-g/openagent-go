{
  "name": "ListEndpoints",
  "summary": "查询终端节点列表",
  "tags": "解析器管理",
  "productshort": "DNS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v2.1/endpoints": {
      "get": {
        "tags": [
          "解析器管理"
        ],
        "operationId": "ListEndpoints",
        "summary": "查询终端节点列表",
        "description": "查询终端节点列表。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "name": "direction",
            "in": "query",
            "required": true,
            "type": "string",
            "description": "终端节点方向。\n取值:\ninbound,表示入站终端节点。\noutbound,表示出站终端节点。",
            "pattern": "inbound|outbound"
          },
          {
            "name": "vpc_id",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "待查询的终端节点所属VPC的ID。",
            "pattern": "[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"
          },
          {
            "name": "name",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "终端节点名称。",
            "pattern": "[\\w\\一-\\龥\\._-]{0,64}"
          },
          {
            "$ref": "#/parameters/limit"
          },
          {
            "$ref": "#/parameters/offset"
          }
        ],
        "responses": {
          "200": {
            "description": "查询终端节点列表响应。",
            "schema": {
              "$ref": "#/definitions/ListEndpointsResp"
            },
            "examples": {
              "application/json": {
                "endpoints": [
                  {
                    "id": "ff80808169bf16c70169bf1d02270000",
                    "name": "poi-666",
                    "direction": "inbound",
                    "status": "ACTIVE",
                    "vpc_id": "02443811-acf1-4c22-8f44-e3adf19f6097",
                    "ipaddress_count": 6,
                    "resolver_rule_count": 0,
                    "create_time": "2019-03-27T12:25:43.181",
                    "update_time": "2019-03-27T12:25:43.181"
                  },
                  {
                    "id": "ff80808169be28130169be2e9dc40004",
                    "name": "poi-667",
                    "direction": "inbound",
                    "status": "ERROR",
                    "vpc_id": "02443811-acf1-4c22-8f44-e3adf19f6097",
                    "ipaddress_count": 6,
                    "resolver_rule_count": 0,
                    "create_time": "2019-03-27T08:05:19.916",
                    "update_time": "2019-03-27T08:05:19.916"
                  }
                ],
                "metadata": {
                  "total_count": 33
                }
              }
            }
          },
          "400": {
            "description": "接口错误响应。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "500": {
            "description": "接口错误响应。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "x-order": 1
      }
    }
  },
  "definitions": {
    "metadata": {
      "properties": {
        "total_count": {
          "type": "integer",
          "description": "**参数解释:**\n满足查询条件的资源总数,不受分页(即limit、offset参数)影响。\n**取值范围:**\n不涉及。",
          "format": "int32",
          "readOnly": true
        }
      },
      "description": "**参数解释:**\n返回满足过滤条件的资源总数。\n**取值范围:**\n不涉及。"
    },
    "ErrorResponse": {
      "description": "**参数解释:**\n失败时返回的错误对象。\n**取值范围:**\n不涉及。",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "description": "**参数解释:**\n错误码。\n**取值范围:**\n不涉及。",
          "type": "string",
          "minLength": 8,
          "maxLength": 36
        },
        "message": {
          "description": "**参数解释:**\n错误描述。\n**取值范围:**\n不涉及。",
          "type": "string",
          "minLength": 2,
          "maxLength": 512
        }
      }
    },
    "EndpointResp": {
      "properties": {
        "id": {
          "type": "string",
          "description": "终端节点的ID,UUID形式的一个资源标识。",
          "readOnly": true
        },
        "name": {
          "type": "string",
          "description": "终端节点的名称。"
        },
        "direction": {
          "type": "string",
          "description": "终端节点方向。\n取值:\ninbound,表示入站终端节点。\noutbound,表示出站终端节点。",
          "readOnly": true
        },
        "status": {
          "type": "string",
          "description": "**参数解释:**\n资源状态。\n**取值范围:**\n- ACTIVE:正常\n- PENDING_CREATE:创建中\n- PENDING_DELETE:删除中\n- ERROR:失败",
          "readOnly": true
        },
        "vpc_id": {
          "type": "string",
          "description": "终端节点所属的VPC ID。",
          "readOnly": true
        },
        "ipaddress_count": {
          "type": "integer",
          "description": "该终端节点下的IP地址数量。",
          "format": "int32",
          "readOnly": true
        },
        "resolver_rule_count": {
          "type": "integer",
          "description": "该终端节点下的转发规则数量。\n仅创建出站终端节点时返回该参数。",
          "format": "int32",
          "readOnly": true
        },
        "create_time": {
          "type": "string",
          "description": "创建时间。\n格式:yyyy-MM-dd'T'HH:mm:ss.SSS。",
          "readOnly": true
        },
        "update_time": {
          "type": "string",
          "description": "更新时间。\n格式:yyyy-MM-dd'T'HH:mm:ss.SSS。",
          "readOnly": true
        }
      }
    },
    "ListEndpointsResp": {
      "properties": {
        "endpoints": {
          "type": "array",
          "description": "查询终端节点列表响应。",
          "items": {
            "$ref": "#/definitions/EndpointResp"
          },
          "readOnly": true
        },
        "metadata": {
          "description": "返回满足过滤条件的资源总数。",
          "$ref": "#/definitions/metadata",
          "readOnly": true
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "**参数解释:**\n用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。\n获取用户Token请参见[获取用户Token](https://support.huaweicloud.com/api-dns/dns_api_30003.html)。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。",
      "required": true,
      "type": "string",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    },
    "offset": {
      "name": "offset",
      "in": "query",
      "required": false,
      "description": "**参数解释:**\n分页查询起始偏移量,表示从偏移量的下一个资源开始查询。\n**约束限制:**\n当设置marker不为空时,以marker为分页起始标识,offset不生效。\n**取值范围:**\n0~2147483647。\n**默认取值:**\n0",
      "type": "integer",
      "format": "int32",
      "minimum": 0
    },
    "limit": {
      "name": "limit",
      "in": "query",
      "required": false,
      "description": "**参数解释:**\n分页查询时配置每页返回的资源个数。\n**约束限制:**\n不涉及。\n**取值范围:**\n0~500。\n**默认取值:**\n500",
      "type": "integer",
      "format": "int32",
      "minimum": 0,
      "maximum": 500
    }
  },
  "host": "dns.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}