{
  "name": "ListLineGroups",
  "summary": "查询线路分组列表",
  "tags": "自定义线路管理",
  "productshort": "DNS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v2.1/linegroups": {
      "get": {
        "tags": [
          "自定义线路管理"
        ],
        "operationId": "ListLineGroups",
        "summary": "查询线路分组列表",
        "description": "查询线路分组列表。该接口部分区域未上线,如需使用请提交工单申请开通。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "name": "line_id",
            "type": "string",
            "in": "query",
            "required": false,
            "description": "线路分组ID。\n模糊匹配。",
            "pattern": "[0-9a-zA-Z_]{0,50}"
          },
          {
            "name": "name",
            "type": "string",
            "in": "query",
            "required": false,
            "description": "线路分组名称。\n模糊匹配。",
            "pattern": "[\\w\\一-\\龥\\._-]{0,64}"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "分页查询时配置每页返回的资源个数。\n\n取值范围:0~500\n\n取值一般为10,20,50。默认值为500。",
            "type": "integer",
            "format": "int32",
            "minimum": 0,
            "maximum": 500
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "分页查询起始偏移量,表示从偏移量的下一个资源开始查询。\n\n取值范围:0~2147483647\n\n默认值为0。\n\n当设置marker不为空时,以marker为分页起始标识,offset不生效。",
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        ],
        "responses": {
          "200": {
            "description": "查询线路分组列表响应。",
            "schema": {
              "$ref": "#/definitions/ListLineGroupsResp"
            },
            "examples": {
              "application/json": {
                "linegroups": [
                  {
                    "name": "linegroup",
                    "lines": [
                      "ST",
                      "LA"
                    ],
                    "status": "ACTIVE",
                    "description": "123",
                    "line_id": "lgroup_ff8080826c33046a016c3ce46a3322cf",
                    "created_at": "2019-07-29T08:41:38.096",
                    "updated_at": "2019-07-29T08:41:38.610"
                  },
                  {
                    "name": "20190729034848812group",
                    "lines": [
                      "Liantong",
                      "Dianxin_Guangdong"
                    ],
                    "status": "ACTIVE",
                    "description": "auto create",
                    "line_id": "lgroup_4011afa26c33050b016c3cbeaf650f84",
                    "created_at": "2019-07-29T08:00:25.443",
                    "updated_at": "2019-07-29T08:00:26.040"
                  }
                ],
                "metadata": {
                  "total_count": 2
                }
              }
            }
          },
          "400": {
            "description": "接口错误响应。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "500": {
            "description": "接口错误响应。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "x-order": 5
      }
    }
  },
  "definitions": {
    "metadata": {
      "properties": {
        "total_count": {
          "type": "integer",
          "description": "**参数解释:**\n满足查询条件的资源总数,不受分页(即limit、offset参数)影响。\n**取值范围:**\n不涉及。",
          "format": "int32",
          "readOnly": true
        }
      },
      "description": "**参数解释:**\n返回满足过滤条件的资源总数。\n**取值范围:**\n不涉及。"
    },
    "ErrorResponse": {
      "description": "**参数解释:**\n失败时返回的错误对象。\n**取值范围:**\n不涉及。",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "description": "**参数解释:**\n错误码。\n**取值范围:**\n不涉及。",
          "type": "string",
          "minLength": 8,
          "maxLength": 36
        },
        "message": {
          "description": "**参数解释:**\n错误描述。\n**取值范围:**\n不涉及。",
          "type": "string",
          "minLength": 2,
          "maxLength": 512
        }
      }
    },
    "ListLineGroupsResp": {
      "properties": {
        "linegroups": {
          "type": "array",
          "description": "列表对象。",
          "items": {
            "$ref": "#/definitions/CreateLineGroupsResp"
          }
        },
        "metadata": {
          "$ref": "#/definitions/metadata"
        }
      }
    },
    "CreateLineGroupsResp": {
      "properties": {
        "name": {
          "type": "string",
          "description": "线路分组名称。"
        },
        "lines": {
          "type": "array",
          "description": "线路分组包含的线路列表。\n解析线路ID。",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string",
          "description": "**参数解释:**\n资源状态。\n**取值范围:**\n- ACTIVE:正常\n- PENDING_CREATE:创建中\n- PENDING_UPDATE:更新中\n- PENDING_DELETE:删除中\n- PENDING_FREEZE:冻结中\n- FREEZE:冻结\n- ERROR:失败"
        },
        "description": {
          "type": "string",
          "description": "线路分组的描述信息"
        },
        "line_id": {
          "type": "string",
          "description": "线路分组的ID。"
        },
        "created_at": {
          "type": "string",
          "description": "创建时间。\n格式:yyyy-MM-dd'T'HH:mm:ss.SSS。"
        },
        "updated_at": {
          "type": "string",
          "description": "更新时间。\n格式:yyyy-MM-dd'T'HH:mm:ss.SSS。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "**参数解释:**\n用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。\n获取用户Token请参见[获取用户Token](https://support.huaweicloud.com/api-dns/dns_api_30003.html)。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。",
      "required": true,
      "type": "string",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    }
  },
  "host": "dns.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}