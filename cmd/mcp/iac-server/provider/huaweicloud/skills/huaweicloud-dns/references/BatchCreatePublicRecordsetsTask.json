              "$ref": "#/definitions/BatchCreatePublicRecordsetsTaskRequestBody"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "批量创建公网记录集响应。",
            "examples": {
              "application/json": {
                "task_id": "97a820bba45f04abba75f9f82525fb11"
              }
            },
            "schema": {
              "$ref": "#/definitions/BatchOperationTaskResponseBody"
            }
          }
        },
        "x-request-examples-description-1": "批量创建公网记录集。",
        "x-request-examples-url-1": "POST https://{endpoint}/v2.1/operation-task/batch-create-recordset",
        "x-request-examples-1": {
          "recordsets": [
            {
              "zone_name": "example.com.",
