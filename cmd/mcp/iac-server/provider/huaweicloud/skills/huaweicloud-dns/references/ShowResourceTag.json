{
  "name": "ShowResourceTag",
  "summary": "查询指定实例的标签信息",
  "tags": "标签管理",
  "productshort": "DNS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v2/{project_id}/{resource_type}/{resource_id}/tags": {
      "get": {
        "tags": [
          "标签管理"
        ],
        "operationId": "ShowResourceTag",
        "summary": "查询指定实例的标签信息",
        "description": "查询指定实例的标签信息",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "项目ID。"
          },
          {
            "name": "resource_type",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "**参数解释:**\n资源的类型。\n**约束限制:**\n不涉及。\n**取值范围:**\n- DNS-public_zone:公网域名\n- DNS-private_zone:内网域名\n- DNS-public_recordset:公网记录集\n- DNS-private_recordset:内网记录集\n- DNS-ptr_record:反向解析\n\n**默认取值:**\n不涉及。"
          },
          {
            "name": "resource_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "资源ID。"
          },
          {
            "$ref": "#/parameters/X-Auth-Token"
          }
        ],
        "responses": {
          "200": {
            "description": "查询资源tag响应。",
            "schema": {
              "$ref": "#/definitions/QueryResourceTagResp"
            },
            "examples": {
              "application/json": {
                "tags": [
                  {
                    "key": "key1",
                    "value": "value1"
                  },
                  {
                    "key": "key2",
                    "value": "value2"
                  }
                ]
              }
            }
          }
        },
        "x-order": 3
      }
    }
  },
  "definitions": {
    "tag": {
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "**参数解释:**\n标签键。\n**取值范围:**\n- 不能为空。\n- 对于同一资源键的取值唯一。\n- 长度不超过128个字符。\n- 取值可以包含任意语种字母、数字、空格,以及_ . : = + - @特殊字符,但首尾不能含有空格,不能以_sys_开头。"
        },
        "value": {
          "type": "string",
          "description": "**参数解释:**\n标签值。\n**取值范围:**\n- 可以为空。\n- 长度不超过255个字符。\n- 取值可以包含任意语种字母、数字、空格,以及_ . : / = + - @特殊字符。"
        }
      }
    },
    "QueryResourceTagResp": {
      "properties": {
        "tags": {
          "type": "array",
          "description": "指定实例的标签列表。",
          "items": {
            "$ref": "#/definitions/tag"
          }
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "**参数解释:**\n用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。\n获取用户Token请参见[获取用户Token](https://support.huaweicloud.com/api-dns/dns_api_30003.html)。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。",
      "required": true,
      "type": "string",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    }
  },
  "host": "dns.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
