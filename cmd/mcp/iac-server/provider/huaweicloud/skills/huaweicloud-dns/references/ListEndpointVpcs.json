{
  "name": "ListEndpointVpcs",
  "summary": "查询终端节点VPC列表",
  "tags": "解析器管理",
  "productshort": "DNS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v2.1/vpcs": {
      "get": {
        "tags": [
          "解析器管理"
        ],
        "operationId": "ListEndpointVpcs",
        "summary": "查询终端节点VPC列表",
        "description": "查询终端节点VPC列表。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/limit"
          },
          {
            "$ref": "#/parameters/offset"
          },
          {
            "name": "vpc_id",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "待查询的VPC的ID。",
            "pattern": "^(|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
          }
        ],
        "responses": {
          "200": {
            "description": "查询终端节点VPC列表响应。",
            "schema": {
              "$ref": "#/definitions/ListEndpointVpcsResp"
            },
            "examples": {
              "application/json": {
                "vpcs": [
                  {
                    "id": "02443811-acf1-4c22-8f44-e3adf19f6097",
                    "inbound_endpoint_count": 32
                  }
                ],
                "metadata": {
                  "total_count": 1
                }
              }
            }
          },
          "400": {
            "description": "接口错误响应。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          },
          "500": {
            "description": "接口错误响应。",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "x-order": 8
      }
    }
  },
  "definitions": {
    "metadata": {
      "properties": {
        "total_count": {
          "type": "integer",
          "description": "**参数解释:**\n满足查询条件的资源总数,不受分页(即limit、offset参数)影响。\n**取值范围:**\n不涉及。",
          "format": "int32",
          "readOnly": true
        }
      },
      "description": "**参数解释:**\n返回满足过滤条件的资源总数。\n**取值范围:**\n不涉及。"
    },
    "ErrorResponse": {
      "description": "**参数解释:**\n失败时返回的错误对象。\n**取值范围:**\n不涉及。",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "description": "**参数解释:**\n错误码。\n**取值范围:**\n不涉及。",
          "type": "string",
          "minLength": 8,
          "maxLength": 36
        },
        "message": {
          "description": "**参数解释:**\n错误描述。\n**取值范围:**\n不涉及。",
          "type": "string",
          "minLength": 2,
          "maxLength": 512
        }
      }
    },
    "ListEndpointVpcsResp": {
      "properties": {
        "vpcs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/VpcsData"
          },
          "description": "终端节点VPC列表。",
          "readOnly": true
        },
        "metadata": {
          "$ref": "#/definitions/metadata"
        }
      }
    },
    "VpcsData": {
      "properties": {
        "id": {
          "type": "string",
          "description": "VPC的ID,UUID形式的一个资源标识。",
          "readOnly": true
        },
        "inbound_endpoint_count": {
          "type": "integer",
          "description": "VPC下入站终端节点的数量。",
          "format": "int32",
          "readOnly": true
        },
        "outbound_endpoint_count": {
          "type": "integer",
          "description": "VPC下出站终端节点的数量。",
          "format": "int32",
          "readOnly": true
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "**参数解释:**\n用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。\n获取用户Token请参见[获取用户Token](https://support.huaweicloud.com/api-dns/dns_api_30003.html)。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。",
      "required": true,
      "type": "string",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    },
    "offset": {
      "name": "offset",
      "in": "query",
      "required": false,
      "description": "**参数解释:**\n分页查询起始偏移量,表示从偏移量的下一个资源开始查询。\n**约束限制:**\n当设置marker不为空时,以marker为分页起始标识,offset不生效。\n**取值范围:**\n0~2147483647。\n**默认取值:**\n0",
      "type": "integer",
      "format": "int32",
      "minimum": 0
    },
    "limit": {
      "name": "limit",
      "in": "query",
      "required": false,
      "description": "**参数解释:**\n分页查询时配置每页返回的资源个数。\n**约束限制:**\n不涉及。\n**取值范围:**\n0~500。\n**默认取值:**\n500",
      "type": "integer",
      "format": "int32",
      "minimum": 0,
      "maximum": 500
    }
  },
  "host": "dns.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}