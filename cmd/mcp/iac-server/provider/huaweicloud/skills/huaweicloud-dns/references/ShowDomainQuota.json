{
  "name": "ShowDomainQuota",
  "summary": "查询租户配额",
  "tags": "配额管理",
  "productshort": "DNS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v2/quotamg/dns/quotas": {
      "get": {
        "tags": [
          "配额管理"
        ],
        "operationId": "ShowDomainQuota",
        "summary": "查询租户配额",
        "description": "查询租户在DNS服务下的资源配额,包括公网域名配额、内网域名配额、记录集配额、反向解析配额、自定义线路配额、线路分组配额、入站终端节点配额、出站终端节点配额、转发规则配额等。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "name": "domain_id",
            "in": "query",
            "required": true,
            "type": "string",
            "description": "租户ID。",
            "pattern": "[0-9a-zA-Z]{1,32}"
          }
        ],
        "responses": {
          "200": {
            "description": "查询租户配额响应。",
            "schema": {
              "$ref": "#/definitions/DomainQuotaResponse"
            },
            "examples": {
              "application/json": {
                "quotas": [
                  {
                    "quota_key": "zone",
                    "quota_limit": 50,
                    "used": 30,
                    "unit": "count"
                  },
                  {
                    "quota_key": "record_set",
                    "quota_limit": 500,
                    "used": 300,
                    "unit": "count"
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "DomainQuotaResponse": {
      "properties": {
        "quotas": {
          "items": {
            "properties": {
              "quota_key": {
                "type": "string",
                "example": "zone",
                "description": "**参数解释:**\n资源类型。\n**取值范围:**\n- zone:公网域名配额\n- private_zone:内网域名配额\n- record_set:记录集配额\n- url_record:显性/隐性URL记录集配额\n- ptr_record:反向解析配额\n- custom_line:自定义线路配额\n- line_group:线路分组配额\n- inbound_endpoint:入站终端节点配额\n- outbound_endpoint:出站终端节点配额\n- resolver_rule:转发规则配额"
              },
              "quota_limit": {
                "type": "integer",
                "format": "int32",
                "example": 50,
                "description": "资源配额的最大值。"
              },
              "used": {
                "type": "integer",
                "format": "int32",
                "example": 30,
                "description": "配额已使用数量。"
              },
              "unit": {
                "type": "string",
                "example": "count",
                "description": "配额统计单位,取固定值“count”。"
              }
            },
            "required": [
              "quota_key",
              "quota_limit",
              "used",
              "unit"
            ]
          },
          "type": "array",
          "description": "配额项数据。"
        }
      },
      "required": [
        "quotas"
      ]
    }
  },
  "version": "2.0",
  "parameters": {
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "**参数解释:**\n用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。\n获取用户Token请参见[获取用户Token](https://support.huaweicloud.com/api-dns/dns_api_30003.html)。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。",
      "required": true,
      "type": "string",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    }
  },
  "host": "dns.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "get",
  "uri": null
}