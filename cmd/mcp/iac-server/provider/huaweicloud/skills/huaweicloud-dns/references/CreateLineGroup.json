  "definitions": {
    "CreateLineGroupsReq": {
      "required": [
        "name",
        "lines"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "线路分组名称。\n不能与自定义线路名称、预制线路名称重复。\n取值范围:1-64个字符,支持数字、字母、中文、_(下划线)、-(中划线)、.(点)。",
          "pattern": "[\\w\\一-\\龥\\._-]{1,64}"
        },
        "description": {
          "type": "string",
          "description": "线路分组的描述信息。\n长度不超过255个字符。默认值为空。",
          "maxLength": 255
        },
        "lines": {
          "type": "array",
          "description": "线路分组包含的线路列表。最少为2个线路。\n解析线路ID。",
          "items": {
            "type": "string",
            "pattern": "(?!null)[0-9a-zA-Z-_]{1,64}"
          },
          "minItems": 2,
          "maxItems": 500
        }
      }
    },
    "ErrorResponse": {
      "description": "**参数解释:**\n失败时返回的错误对象。\n**取值范围:**\n不涉及。",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "description": "**参数解释:**\n错误码。\n**取值范围:**\n不涉及。",
          "type": "string",
          "minLength": 8,
          "maxLength": 36
        },
        "message": {
          "description": "**参数解释:**\n错误描述。\n**取值范围:**\n不涉及。",
          "type": "string",
          "minLength": 2,
          "maxLength": 512
        }
      }
    },
    "CreateLineGroupsResp": {
      "properties": {
        "name": {
          "type": "string",
          "description": "线路分组名称。"
        },
        "lines": {
          "type": "array",
          "description": "线路分组包含的线路列表。\n解析线路ID。",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string",
          "description": "**参数解释:**\n资源状态。\n**取值范围:**\n- ACTIVE:正常\n- PENDING_CREATE:创建中\n- PENDING_UPDATE:更新中\n- PENDING_DELETE:删除中\n- PENDING_FREEZE:冻结中\n- FREEZE:冻结\n- ERROR:失败"
        },
        "description": {
          "type": "string",
          "description": "线路分组的描述信息"
        },
        "line_id": {
          "type": "string",
          "description": "线路分组的ID。"
        },
        "created_at": {
          "type": "string",
          "description": "创建时间。\n格式:yyyy-MM-dd'T'HH:mm:ss.SSS。"
        },
        "updated_at": {
          "type": "string",
          "description": "更新时间。\n格式:yyyy-MM-dd'T'HH:mm:ss.SSS。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
    "X-Auth-Token": {
      "name": "X-Auth-Token",
      "in": "header",
      "description": "**参数解释:**\n用户Token。\n通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。\n获取用户Token请参见[获取用户Token](https://support.huaweicloud.com/api-dns/dns_api_30003.html)。\n**约束限制:**\n不涉及。\n**取值范围:**\n不涉及。\n**默认取值:**\n不涉及。",
      "required": true,
      "type": "string",
      "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
    }
  },
