            "schema": {
              "$ref": "#/definitions/UpdateEndpointRequestBody"
            },
            "description": "修改终端节点请求。"
          }
        ],
        "responses": {
          "202": {
            "description": "修改终端节点响应。",
            "schema": {
              "$ref": "#/definitions/UpdateEndpointResp"
            },
            "examples": {
              "application/json": {
                "endpoint": {
                  "id": "ff80808169bf16c70169bf1d02270000",
                  "name": "2118",
                  "direction": "inbound",
                  "status": "ACTIVE",
                  "vpc_id": "02443811-acf1-4c22-8f44-e3adf19f6097",
                  "ipaddress_count": 6,
                  "resolver_rule_count": 0,
