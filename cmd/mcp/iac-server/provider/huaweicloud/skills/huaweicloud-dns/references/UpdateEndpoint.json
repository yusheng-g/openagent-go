  "tags": "解析器管理",
  "productshort": "DNS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v2.1/endpoints/{endpoint_id}": {
      "put": {
        "tags": [
          "解析器管理"
        ],
        "x-request-examples-description-1": "修改终端节点名称。",
        "x-request-examples-url-1": "PUT https://{endpoint}/v2.1/endpoints/{endpoint_id}",
        "x-request-examples-1": {
          "name": "2118"
        },
        "operationId": "UpdateEndpoint",
        "summary": "修改终端节点",
        "description": "修改终端节点",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/X-Auth-Token"
          },
          {
            "$ref": "#/parameters/EndpointIdInPath"
          },
          {
            "name": "UpdateEndpointRequestBody",
            "in": "body",
