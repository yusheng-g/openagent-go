  "definitions": {
    "QuotaInfo": {
      "description": "**参数解释**:配额信息,包括总配额和已使用配额。",
      "required": [
        "quota_key",
        "quota_limit",
        "used",
        "unit"
      ],
      "properties": {
        "quota_key": {
          "type": "string",
          "description": "**参数解释**:配额类型。\n\n**取值范围**:\n- loadbalancer:负载均衡器配额。\n- listener:监听器配额。\n- ipgroup:IP地址组配额。\n- pool:后端服务器组配额。\n- member:后端服务器配额。\n- healthmonitor:健康检查配额。\n- l7policy:转发策略配额。\n- certificate:证书配额。\n- security_policy:自定义安全策略配额。\n- listeners_per_loadbalancer:单个LB实例下的监听器配额。\n- listeners_per_pool:单个pool关联的监听器配额。\n- members_per_pool:单个pool下的member的配额。\n- condition_per_policy:单个转发策略下所有转发规则的condition总数配额。\n- ipgroup_bindings:单个IP地址组可以关联的监听器数量配额。\n- ipgroup_max_length:单个监听器下关联的所有IP地址组的ip列表中的IP总数不能超过ipgroup_max_length。\n- ipgroups_per_listener:单个监听器下的IP地址组配额。\n- pools_per_l7policy:单个转发策略下的后端服务器组配额。\n- l7policies_per_listener:单个监听器下的转发策略配额。\n- free_instance_members_per_pool:单个pool实例下的免费member配额。\n- free_instance_listeners_per_loadbalancer:单个LB实例下的免费监听器配额。"
        },
        "quota_limit": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:总配额。\n\n**取值范围**:\n- 大于等于0:表示当前配额数量。\n- -1:表示无配额限制。"
        },
        "used": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:已使用配额。\n\n**取值范围**:大于等于0。"
        },
        "unit": {
          "type": "string",
          "description": "**参数解释**:配额单位。\n\n**取值范围**:count,表示个数。"
        }
      },
      "type": "object"
    },
    "ListQuotaDetailsResponseBody": {
      "properties": {
        "request_id": {
          "type": "string",
          "description": "**参数解释**:请求ID。\n\n**取值范围**:由数字、小写字母和中划线(-)组成的字符串,自动生成。"
        },
