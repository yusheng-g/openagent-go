  "definitions": {
    "QueryCustomersBalancesRsp": {
      "properties": {
        "customer_balances": {
          "description": "账户余额列表。只有成功的时候才返回。 此列表不包含非代售类子客户的数据。批量查询客户余额时,若入参携带了非代售类子客户,会被过滤。 具体请参见表2。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/CustomerBalancesV2"
          }
        }
      }
    },
    "CustomerBalancesV2": {
      "required": [
        "customer_id"
      ],
      "properties": {
        "customer_id": {
          "type": "string",
          "description": "客户账号ID。",
          "example": ""
        },
        "debt_amount": {
          "description": "客户欠款总额度。",
          "type": "number",
          "format": "bigdecimal"
        },
        "amount": {
          "description": "客户可用总额度。",
          "type": "number",
          "format": "bigdecimal"
        },
        "currency": {
          "type": "string",
          "description": "币种。 CNY:人民币。",
          "example": ""
        },
        "measure_id": {
          "description": "度量单位: 1:元",
          "type": "integer",
          "format": "int32",
          "x-allowNull": false,
          "example": ""
        }
      }
    },
    "CustomerInfoV2": {
      "required": [
        "customer_id"
      ],
      "properties": {
        "customer_id": {
          "type": "string",
          "description": "客户账号ID。您可以调用[查询客户列表](https://support.huaweicloud.com/api-bpconsole/mc_00021.html)接口获取customer_id。",
          "minLength": 1,
          "maxLength": 64,
          "example": ""
        }
      }
    },
    "QueryCustomersBalancesReq": {
      "required": [
        "customer_infos"
      ],
      "properties": {
        "customer_infos": {
          "description": "客户信息列表。 具体请参见表1。",
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "x-maxLength": 100,
          "x-minLength": 1,
          "items": {
