        "tags": [
          "管理客户(伙伴)"
        ],
        "operationId": "ListSubCustomers",
        "x-constraint": "该接口只允许使用合作伙伴AK/SK或者Token调用。",
        "x-externalURL": "/v2/partners/sub-customers/query",
        "x-open-region-cloud": "hc,hk",
