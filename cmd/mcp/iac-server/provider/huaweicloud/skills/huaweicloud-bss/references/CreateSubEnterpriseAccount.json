          "type": "string",
          "description": "企业子账号登录名。",
          "minLength": 1,
          "maxLength": 32,
          "example": ""
        },
        "mobile_phone": {
          "type": "string",
          "description": "企业管理员的手机号码。如果use_pri_mobile_phone取值为Y,则这个参数无效,否则必选。",
          "minLength": 0,
          "maxLength": 20,
          "example": "17069622XXX",
          "x-site": "HC"
        },
        "use_pri_mobile_phone": {
          "type": "string",
          "description": "是否使用企业主账号手机号码作为子账号手机号码: Y:是N:否(默认值) 当为Y时,mobile_phone输入无效。",
          "minLength": 0,
          "maxLength": 10,
          "example": "Y",
          "x-site": "HC"
        },
