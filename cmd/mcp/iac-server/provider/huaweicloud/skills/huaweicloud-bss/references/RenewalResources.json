  "definitions": {
    "RenewalResourcesReq": {
      "required": [
        "resource_ids",
        "period_type",
        "period_num"
      ],
      "properties": {
        "resource_ids": {
          "description": "资源ID列表。 只支持传入主资源ID,最多10个资源ID。 哪些资源是主资源请根据“查询客户包年/包月资源列表”接口响应参数中的“is_main_resource”来标识。",
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "x-maxLength": 10,
          "x-minLength": 1,
          "items": {
            "type": "string"
          }
        },
        "period_type": {
          "description": "周期类型: 2:月3:年",
          "type": "integer",
          "format": "int32",
          "x-allowNull": true,
          "example": "2",
          "maximum": 3,
          "minimum": 2
        },
        "period_num": {
          "description": "周期数目: 如果是月,目前支持1-11如果是年,目前支持1-3",
          "type": "integer",
          "format": "int32",
          "x-allowNull": true,
          "example": "1",
          "maximum": 11,
          "minimum": 1
        },
        "is_auto_pay": {
          "description": "是否自动支付。 0:否1:是 此参数不携带或携带值为null时,默认值为“0:否”,即不自动支付。",
          "type": "integer",
          "format": "int32",
          "x-allowNull": true,
          "example": "1",
          "maximum": 1,
          "minimum": 0,
          "default": 0
        }
      }
    },
    "RenewalResourcesRsp": {
      "properties": {
        "order_ids": {
          "description": "续订资源生成的订单ID的列表。",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fail_resource_infos": {
          "description": "|参数名称:失败的资源信息列表| |参数的约束及描述:套餐包使用量信息|",
          "type": "array",
          "items": {
