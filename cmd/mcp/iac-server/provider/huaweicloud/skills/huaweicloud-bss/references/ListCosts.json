          "minLength": 1,
          "maxLength": 256,
          "example": ""
        },
        "value": {
          "description": "过滤器值",
          "type": "array",
          "maxItems": 100,
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "example": ""
        }
