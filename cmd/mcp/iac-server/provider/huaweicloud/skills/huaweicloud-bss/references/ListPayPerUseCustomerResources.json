        "is_main_resource": {
          "description": "是否是主资源。 0:非主资源1:主资源",
          "type": "integer",
          "format": "int32",
          "x-allowNull": true,
          "example": "1"
        },
        "status": {
          "description": "资源状态。状态说明请参见资源状态说明。 2:使用中3:已关闭(页面不展示这个状态)4:已冻结5:已过期",
          "type": "integer",
          "format": "int32",
          "x-allowNull": true,
          "example": "2"
        },
        "effective_time": {
          "type": "string",
          "description": "资源生效时间。 UTC时间,格式:yyyy-MM-dd'T'HH:mm:ss'Z',如“2019-05-06T08:05:01Z”。",
          "example": "2019-12-25T07:32:04Z"
        },
        "expire_time": {
          "type": "string",
