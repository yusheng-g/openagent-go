        "update_time": {
          "type": "string",
          "description": "|参数名称:资源更新时间。| |参数约束及描述:资源更新时间。UTC时间,格式:yyyy-MM-ddTHH:mm:ssZ,如“2019-12-25T07:32:04Z”。|",
          "example": "2019-12-25T07:32:04Z"
        },
        "enterprise_project": {
