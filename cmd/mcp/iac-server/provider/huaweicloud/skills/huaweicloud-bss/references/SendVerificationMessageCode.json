          "description": "发送验证码的类型: 1:发送短信验证码",
          "type": "integer",
          "format": "int32",
          "x-allowNull": true,
          "example": 1,
          "maximum": 2,
          "minimum": 1
        },
        "timeout": {
          "description": "验证码超时时间。此参数不携带或携带值为null时,采用系统默认超时时间10分钟。此参数值超过60时,取值固定为5分钟。单位:分钟",
          "type": "integer",
          "format": "int32",
          "x-allowNull": true,
          "example": 5,
          "maximum": 3000,
          "minimum": 1
        },
        "mobile_phone": {
          "type": "string",
          "description": "指定发送验证码的手机号。 目前系统只支持中国手机号。 示例:13XXXXXXXXX",
          "minLength": 0,
          "maxLength": 32,
          "example": "13XXXXXXXXX",
          "x-site": "HC"
        },
        "lang": {
          "type": "string",
          "description": "根据该参数的取值选择发送短信验证码的语言。此参数默认值为“zh-cn:中文”。 zh-cn:中文en-us:英文",
          "minLength": 0,
          "maxLength": 16,
          "example": "zh-cn"
        },
        "scene": {
