      "post": {
        "summary": "申请企业实名认证",
        "description": "企业客户可以进行企业实名认证申请。\n\n客户登录帐号中心进行企业实名认证的方式及流程请参见[这里](https://support.huaweicloud.com/usermanual-account/zh-cn_topic_0077914253.html)。",
        "tags": [
          "实名认证(伙伴)"
        ],
        "operationId": "CreateEnterpriseRealnameAuthentication",
        "x-constraint": "接口只允许使用合作伙伴账号AK/SK或者Token调用。",
        "x-externalURL": "/v2/customers/realname-auths/enterprise",
        "x-open-region-cloud": "hc,hk",
        "x-flowControl": 20,
        "x-lastAnalysisDate": "2020-04-11",
        "x-readOnly": false,
        "x-delayTime": "1000ms",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
