        "original_amount": {
          "type": "string",
          "description": "资源原始额度,针对可重置资源包,是指每个重置周期内的总量。",
          "example": ""
        },
        "measure_id": {
          "description": "度量单位,免费资源套餐额度度量单位。您可以调用查询度量单位列表接口获取。",
          "type": "integer",
          "format": "int32",
          "x-allowNull": false,
          "example": ""
        }
      }
    },
    "FreeResourcePackageV3": {
      "properties": {
        "order_instance_id": {
          "type": "string",
          "description": "订购资源包产品后,系统生成的ID,是这个资源包列表的标识字段。",
          "example": "01154-244800315-0"
        },
        "order_id": {
          "type": "string",
          "description": "订单ID,如果source_type为“1:软开云赠送”,该字段为空。",
          "example": "TCB0701025VC5DIOIA7U7A9DLO0A1"
        },
        "product_id": {
          "type": "string",
          "description": "产品ID,即资源包ID。",
          "example": "00301-46032-0--0_merge"
        },
        "product_name": {
          "type": "string",
          "description": "产品名称,即资源包名称。",
          "example": "OBS存储包 100GB_包月"
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "企业项目ID。",
          "example": "0"
        },
        "enterprise_project_scope": {
          "description": "企业项目应用范围: 0:应用所有1:应用到具体企业项目",
          "type": "integer",
          "format": "int32",
          "x-allowNull": false,
          "example": 0
        },
        "effective_time": {
          "type": "string",
          "description": "生效时间,购买资源包的时间,格式UTC。",
          "example": "2021-07-31T07:20:47Z"
        },
        "expire_time": {
          "type": "string",
          "description": "失效时间,资源包到期时间,格式UTC。",
          "example": "2021-08-31T15:59:59Z"
        },
        "status": {
          "description": "状态: 0:未生效1:生效中2:已用完3:已失效4:已退订",
          "type": "integer",
          "format": "int32",
          "x-allowNull": false,
          "example": 1
        },
        "service_type_code": {
          "type": "string",
          "description": "云服务类型编码,例如OBS的云服务类型编码为“hws.service.type.obs”。您可以调用查询云服务类型列表接口获取。",
          "example": "hws.service.type.obs"
        },
        "service_type_name": {
          "type": "string",
          "description": "云服务类型名称。例如ECS的云服务类型名称为“弹性云服务器”。",
          "example": ""
        },
        "region_code": {
          "type": "string",
          "description": "云服务区编码,例如:“cn-north-1”。具体请参见地区和终端节点对应云服务的“区域”列的值。",
          "example": "global-cbc-1"
        },
        "source_type": {
          "description": "资源包的来源类型: 0:订单1:软开云赠送",
          "type": "integer",
          "format": "int32",
          "x-allowNull": false,
          "example": 0
        },
        "bundle_type": {
          "type": "string",
          "description": "套餐绑定类型: ATOMIC_PKG:原子套餐BUNDLE_PKG:组合套餐",
          "example": "ATOMIC_PKG"
        },
        "quota_reuse_mode": {
          "description": "使用模式。 1:可重置表示购买的资源包能够按照一定的周期恢复使用量。例如购买一个1年的按需资源包,使用量是40G,可重置,重置周期为1个月,表示1年内每个月会给予40G的使用量。 2:不可重置表示购买的资源包的使用量不会恢复。例如购买一个1年的按需资源包,使用量是40G,不可重置,表示1年内一共给予40G的使用量。",
          "type": "integer",
          "format": "int32",
          "x-allowNull": false,
          "example": 1
        },
        "free_resources": {
          "description": "资源套餐内的资源项信息(资源项ID级的详情),具体参见表3。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/FreeResourceV3"
          }
        }
      }
    },
    "ListFreeResourceInfosRsp": {
      "properties": {
