  "definitions": {
    "FreeResourceV3": {
      "properties": {
        "free_resource_id": {
          "type": "string",
          "description": "资源项ID,一个资源包中会含有多个资源项,一个使用量类型对应一个资源项。",
          "example": ""
        },
        "usage_type_name": {
          "type": "string",
          "description": "使用量类型名称。",
          "example": ""
