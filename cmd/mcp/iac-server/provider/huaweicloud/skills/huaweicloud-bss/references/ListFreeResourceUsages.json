  "definitions": {
    "FreeResourceDetail": {
      "properties": {
        "free_resource_id": {
          "type": "string",
          "description": "资源项ID,一个资源包中会含有多个资源项,一个使用量类型对应一个资源项。",
          "example": ""
        },
        "free_resource_type_name": {
          "type": "string",
          "description": "资源项类型名称。",
          "example": ""
        },
        "quota_reuse_cycle": {
          "description": "重置周期,只有quota_reuse_mode为可重置,该字段才有意义。 1:小时2:天3:周4:月5:年",
          "type": "integer",
          "format": "int32",
          "x-allowNull": true,
          "example": ""
        },
        "quota_reuse_cycle_type": {
          "description": "重置周期类别,只有quota_reuse_mode为可重置,该字段才有意义。 1:按自然周期重置是指重置周期是按照自然月/年来重置,例如如果周期是月,按自然周期重置,表示每个月的1号重置。 2:按订购周期重置。是指重置周期是按照订购时间来重置,例如如果周期是月,按订购周期重置,15号订购了该套餐,表示每个月的15号重置。",
          "type": "integer",
          "format": "int32",
          "x-allowNull": true,
          "example": ""
        },
        "usage_type_name": {
          "type": "string",
          "description": "使用量类型名称。",
          "example": ""
        },
        "start_time": {
          "type": "string",
          "description": "开始时间,格式UTC。 如果quota_reuse_mode为可重置,则此时间为当前时间所在的重置周期的开始时间。如果quota_reuse_mode为不可重置,则此时间为订购实例的生效时间。",
          "example": ""
        },
        "end_time": {
          "type": "string",
          "description": "结束时间,格式UTC。 如果quota_reuse_mode为可重置,则此时间为当前时间所在的重置周期的结束时间。如果quota_reuse_mode为不可重置,则此时间为订购实例的失效时间。",
          "example": ""
        },
        "amount": {
          "description": "资源剩余额度,针对可重置资源包,是指当前重置周期内的剩余量。",
          "type": "number",
          "format": "bigdecimal",
          "x-allowNull": true,
          "example": "100.0"
        },
        "original_amount": {
          "description": "资源原始额度,针对可重置资源包,是指每个重置周期内的总量。",
          "type": "number",
          "format": "bigdecimal",
          "x-allowNull": true,
          "example": ""
        },
        "measure_id": {
          "description": "度量单位,免费资源套餐额度度量单位。您可以调用查询度量单位列表接口获取。",
          "type": "integer",
          "format": "int32",
          "x-allowNull": true,
          "example": ""
        }
      }
    },
    "ListFreeResourceUsagesReq": {
      "required": [
        "free_resource_ids"
      ],
      "properties": {
        "free_resource_ids": {
          "description": "资源项ID列表,每个最大64字节。 资源项ID,一个资源包中会含有多个资源项,一个使用量类型对应一个资源项。资源项ID来自查询资源包列表接口的响应。",
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "x-minLength": 1,
          "x-maxLength": 100,
          "items": {
            "type": "string"
          },
          "example": ""
        }
      }
    },
    "ListFreeResourceUsagesRsp": {
      "properties": {
        "free_resources": {
          "description": "资源套餐内的资源项信息(资源项ID级的详情),具体参见表2。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/FreeResourceDetail"
          }
        }
      }
    }
  },
