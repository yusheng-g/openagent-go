{
  "name": "CheckUserIdentity",
  "summary": "校验客户注册信息",
  "tags": "注册客户(伙伴)",
  "productshort": "BSS",
  "region_id": "cn-north-1",
  "paths": {
    "/v2/partners/sub-customers/users/check-identity": {
      "post": {
        "summary": "校验客户注册信息",
        "description": "客户注册时可检查客户的登录名称、手机号或者邮箱是否可以用于注册。\n\n>![](public_sys-resources/icon-note.gif) **说明:** \n>针对校验手机号场景,目前仅支持校验手机号注册数量是否超过上限。",
        "tags": [
          "注册客户(伙伴)"
        ],
        "operationId": "CheckUserIdentity",
        "x-constraint": "该接口只允许使用合作伙伴AK/SK或者Token调用。",
        "x-readOnly": true,
        "x-delayTime": "1000ms",
        "x-importanceLevel": "high",
        "produces": [
          "application/json"
        ],
        "consumes": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "合作伙伴Token调用",
            "type": "string"
          },
          {
            "name": "req",
            "in": "body",
            "description": "校验客户注册信息请求",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CheckSubcustomerUserReq"
            }
          }
        ],
        "x-request-examples-url-1": "POST https://bss.myhuaweicloud.com/v2/partners/sub-customers/users/check-identity",
        "x-request-examples-1": {
          "search_type": "name",
          "search_value": "ceshiyonghu001"
        },
        "responses": {
          "200": {
            "description": "校验客户注册信息响应",
            "schema": {
              "$ref": "#/definitions/CheckSubcustomerUserRsp"
            },
            "examples": {
              "application/json": {
                "error_code": "CBC.0000",
                "error_msg": "success",
                "check_result": "available",
                "mobile_remain_available_num": 0
              }
            }
          },
          "400": {
            "description": "参数错误"
          }
        },
        "x-externalURL": "/v2/partners/sub-customers/users/check-identity",
        "x-open-region-cloud": "hc,hk",
        "x-flowControl": 10,
        "x-category": "注册客户(伙伴)",
        "x-support-sdk": "Y",
        "x-is-registered": "Y"
      }
    }
  },
  "definitions": {
    "CheckSubcustomerUserRsp": {
      "properties": {
        "error_code": {
          "description": "状态码。具体请参考状态码。",
          "type": "string",
          "default": "CBC.0000"
        },
        "error_msg": {
          "description": "错误描述信息。",
          "type": "string",
          "default": "success"
        },
        "check_result": {
          "description": "是否可以继续注册。该参数非必填,且只允许字符串,available: 该登录名称/手机号/邮箱可以继续注册,used_by_user: 该登录名称/手机号/邮箱不可以继续注册|",
          "example": "available",
          "type": "string"
        },
        "mobile_remain_available_num": {
          "description": "手机号剩余可注册客户数量。该参数非必填,只有search_type=mobile时,该字段才返回值。表示可以继续使用该手机号注册客户的数量。",
          "example": 0,
          "type": "integer",
          "format": "int32",
          "x-allowNull": true
        }
      }
    },
    "CheckSubcustomerUserReq": {
      "required": [
        "search_type",
        "search_value"
      ],
      "properties": {
        "search_type": {
          "description": "校验类型。该参数必填,email:邮箱 mobile:手机号 name:登录名称|",
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "x-allowNull": true
        },
        "search_value": {
          "description": "校验内容。该参数必填,且只允许最大长度64的字符串。手机号需符合正则表达式 ^\\d{4}-\\d+$;包括国家码,以00开头,格式:00XX-XXXXXXXX。目前手机号仅支持以86开头的国家码。邮箱需为含有@的正确格式的完整邮箱地址。登录名称需符合正则表达式^([a-zA-Z-]([a-zA-Z0-9_-]){4,31})$,长度5-32;不能以“op_”或“shadow_”开头且不能全为数字,且只能以字母(不区分大小写)或者-开头。",
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "x-allowNull": true
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "bss.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v2",
  "method": "post",
  "uri": null
}