{
  "name": "GetBucketVersioning",
  "summary": "获取桶的多版本状态",
  "tags": "桶的高级配置",
  "productshort": "OBS",
  "region_id": "af-north-1",
  "paths": {
    "/": {
      "get": {
        "tags": [
          "桶的高级配置"
        ],
        "operationId": "GetBucketVersioning",
        "consumes": [
          "application/xml"
        ],
        "summary": "获取桶的多版本状态",
        "description": "桶的所有者可以获取指定桶的多版本状态。\n\n如果从未设置桶的多版本状态,则此操作不会返回桶的多版本状态。",
        "x-is-registered": "Y",
        "x-support-sdk": "N",
        "produces": [
          "application/xml"
        ],
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "description": "请求消息中可带的签名信息。\n",
            "type": "string",
            "required": true
          },
          {
            "name": "Date",
            "in": "header",
            "description": "请求发起端的日期和时间,例如:Wed, 27 Jun 2018 13:39:15 +0000。\n默认值:无。\n条件:如果消息头中带了x-obs-date字段,则可以不带该字段,其他情况下必选。\n",
            "type": "string",
            "required": false,
            "x-apiexplorer-format": "date-gmt"
          },
          {
            "name": "bucket_name",
            "in": "query",
            "required": true,
            "description": "请求的桶名称。\n",
            "type": "string",
            "minLength": 3,
            "maxLength": 63,
            "x-location-cname": true
          },
          {
            "name": "versioning",
            "in": "query",
            "required": true,
            "description": "versioning表示请求桶的多版本状态API。\n",
            "type": "string",
            "allowEmptyValue": true,
            "minLength": 0,
            "maxLength": 0
          }
        ],
        "responses": {
          "200": {
            "description": "成功响应消息。\n",
            "headers": {
              "Content-Length": {
                "type": "string",
                "description": "响应消息体的字节长度。\n"
              },
              "Connection": {
                "type": "string",
                "description": "指明与服务器的连接是长连接还是短连接。\n"
              },
              "Date": {
                "type": "string",
                "description": "OBS系统响应的时间。\n"
              },
              "ETag": {
                "description": "对象的128位MD5摘要,通过十六进制字符串表示。ETag是对象内容的唯一标识,可以通过该值识别对象内容是否有变化。比如上传对象时ETag为A,下载对象时ETag为B,则说明对象内容发生了变化。实际的ETag是对象的哈希值。ETag只反映变化的内容,而不是其元数据。上传的对象或拷贝操作创建的对象,通过MD5加密后都有唯一的ETag。如果通过多段上传对象,则无论加密方法如何,MD5会拆分ETag,此类情况ETag就不是MD5的摘要。\n",
                "type": "string"
              },
              "x-obs-id-2": {
                "description": "帮助定位问题的特殊符号。\n",
                "type": "string"
              },
              "x-obs-request-id": {
                "description": "由OBS创建来唯一确定本次请求的值,可以通过该值来定位问题。\n",
                "type": "string"
              }
            },
            "schema": {
              "$ref": "#/definitions/GetBucketVersioningResponseBody"
            },
            "examples": {
              "application/xml": "HTTP/1.1 status_code\nDate: date\nContent-Type: type\nContent-Length: length\n\n<VersioningConfiguration xmlns=\"http://obs.cn-north-4.myhuaweicloud.com/doc/2015-06-30/\">\n    <Status>status</Status>\n</VersioningConfiguration>\n"
            }
          },
          "400": {
            "description": "请求失败响应消息。\n",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "Error": {
      "description": "错误响应消息体\n",
      "properties": {
        "Code": {
          "type": "string",
          "description": "错误响应消息体XML中错误响应对应的HTTP消息返回码,具体的错误码请参见[错误码-表2](https://support.huaweicloud.com/api-obs/obs_04_0115.html#obs_04_0115__d0e843)。\n"
        },
        "Message": {
          "type": "string",
          "description": "错误响应消息体XML中具体错误更全面、详细的英文解释,具体的错误消息请参见[错误码-表2](https://support.huaweicloud.com/api-obs/obs_04_0115.html#obs_04_0115__d0e843)。\n"
        },
        "RequestId": {
          "type": "string",
          "description": "本次错误请求的请求ID,用于错误定位。\n"
        },
        "HostId": {
          "type": "string",
          "description": "返回该消息的服务端ID。\n"
        },
        "Resource": {
          "type": "string",
          "description": "该错误相关的桶或对象资源。\n"
        }
      }
    },
    "GetBucketVersioningResponseBody": {
      "properties": {
        "VersioningConfiguration": {
          "$ref": "#/definitions/SetBucketVersioningRequestBody"
        }
      }
    },
    "SetBucketVersioningRequestBody": {
      "xml": {
        "name": "VersioningConfiguration"
      },
      "description": "多版本配置的根节点。\n",
      "required": [
        "Status"
      ],
      "properties": {
        "Status": {
          "description": "标识桶的多版本状态。\n",
          "type": "string",
          "enum": [
            "Enabled",
            "Suspended"
          ]
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
