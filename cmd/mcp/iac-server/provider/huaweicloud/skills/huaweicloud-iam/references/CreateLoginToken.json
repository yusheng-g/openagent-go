          "type": "string",
          "example": "IAMUserB",
          "description": "被委托方用户名。"
        },
        "password_expires_at": {
          "type": "string",
          "description": "被委托方用户的密码过期时间。"
        },
        "id": {
          "type": "string",
          "example": "05fdcf44990033a21fbec00e2873a...",
          "description": "被委托方用户ID。"
        }
      },
      "description": ""
    },
    "LoginTokenDomain": {
      "properties": {
        "name": {
          "type": "string",
          "example": "domain002",
          "description": "被委托方用户所属账号名称。"
        },
        "id": {
          "type": "string",
          "example": "05fdcf2c188033a70f78c00e6cbd0...",
          "description": "被委托方用户所属账号ID。"
        }
      },
      "description": ""
    },
    "LoginTokenAssumedBy": {
      "properties": {
        "user": {
          "description": "被委托方用户信息。",
          "$ref": "#/definitions/LoginTokenUser"
        }
      },
      "description": ""
    },
    "LoginTokenSecurityToken": {
      "required": [
        "access",
        "id",
        "secret"
      ],
      "properties": {
        "access": {
          "type": "string",
          "example": "LUJHNN4WB569PGAPBDFT",
          "description": "AK。"
        },
        "secret": {
          "type": "string",
          "example": "7qtrm2cku0XubixiVkBOcvMfpnu7H2mLNCUsuFR8",
          "description": "SK。"
        },
        "id": {
          "type": "string",
          "example": "gQpjbi1ub3J0a..",
          "description": "securitytoken,即临时身份的安全token。\n\n支持使用自定义代理用户或普通用户获取的securitytoken换取logintoken,详情请参见:[通过token获取临时访问密钥和securitytoken](https://apiexplorer.developer.huaweicloud.com/apiexplorer/doc?product=IAM&api=CreateTemporaryAccessKeyByToken)。\n\n支持委托的方式,但获取securitytoken时,请求体中必须填写session_user.name参数,详情请参见:[通过委托获取临时访问密钥和securitytoken](https://apiexplorer.developer.huaweicloud.com/apiexplorer/doc?product=IAM&api=CreateTemporaryAccessKeyByAgency)。"
        },
        "duration_seconds": {
          "type": "integer",
          "format": "int32",
          "example": 600,
          "description": "自定义代理登录票据logintoken的有效时间,时间单位为秒。默认10分钟,取值范围10min~12h,且取值不能大于临时安全凭证securitytoken的过期时间。",
          "minimum": 600,
          "maximum": 43200,
          "default": 600
        }
      },
      "description": ""
    },
    "LoginToken": {
      "required": [
        "domain_id",
        "expires_at",
        "method",
        "session_id",
        "user_id",
        "user_name"
      ],
      "properties": {
        "domain_id": {
          "type": "string",
          "example": "05fdcf2c188033a70f78c00e6cbd0...",
          "description": "账号ID。"
        },
        "expires_at": {
          "type": "string",
          "example": "2019-09-02T08:18:38.562000Z",
          "description": "logintoken的过期时间,默认10min。"
        },
        "method": {
          "type": "string",
          "example": "token",
          "description": "认证方法。当认证用户为华为云用户时,该字段内容为“token”,当认证用户为自定义代理用户时,该字段内容为“federation_proxy”。"
        },
        "user_id": {
          "type": "string",
          "description": "用户ID。"
        },
        "user_name": {
          "type": "string",
          "description": "用户名。"
        },
        "session_id": {
          "type": "string",
          "example": "0eb62fa2e9124375ba0e114e8f149...",
          "description": "会话ID。"
        },
        "session_user_id": {
          "type": "string",
          "example": "0eb62fa2esdfcsf24455e114e8f149...",
          "description": "自定义代理用户ID。"
        },
        "session_name": {
          "type": "string",
          "example": "SessionUserName",
          "description": "自定义代理用户名。\n> - [通过委托获取临时访问密钥和securitytoken](https://apiexplorer.developer.huaweicloud.com/apiexplorer/doc?product=IAM&api=CreateTemporaryAccessKeyByAgency)且请求体中填写session_user.name参数时,会返回该字段。该字段的值即为session_user.name所填写的值。"
        },
        "assumed_by": {
          "description": "被委托方用户信息。\n> - [通过委托获取临时访问密钥和securitytoken](https://apiexplorer.developer.huaweicloud.com/apiexplorer/doc?product=IAM&api=CreateTemporaryAccessKeyByAgency)且请求体中填写session_user.name参数时,会返回该字段。",
          "$ref": "#/definitions/LoginTokenAssumedBy"
        }
      },
      "description": ""
    },
