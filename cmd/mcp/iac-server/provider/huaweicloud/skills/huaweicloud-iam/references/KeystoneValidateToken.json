                          "region_id": "*",
                          "url": "https://bss.myhuaweicloud.com/v1.0"
                        }
                      ],
                      "id": "c6db69fabbd549908adcb861c7e47ca4",
                      "name": "bssv1",
                      "type": "bssv1"
                    }
                  ],
                  "domain": {
                    "id": "d78cbac186b744899480f25bd022f468",
                    "name": "IAMDomain"
                  },
                  "roles": [
                    {
                      "id": "0",
                      "name": "te_admin"
                    },
                    {
                      "id": "0",
                      "name": "secu_admin"
                    },
                    {
                      "id": "0",
                      "name": "te_agency"
                    }
                  ],
                  "issued_at": "2020-01-03T09:08:49.965000Z",
                  "user": {
                    "domain": {
                      "id": "d78cbac186b744899480f25bd022f468",
                      "name": "IAMDomain"
                    },
                    "id": "7116d09f88fa41908676fdd4b039e95b",
                    "name": "IAMUser",
                    "password_expires_at": ""
                  }
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/KeystoneValidateTokenResponseBody"
            },
            "headers": {
              "X-Subject-Token": {
                "type": "string",
                "description": "已校验的token。",
                "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXX..."
              }
            }
          },
          "401": {
            "description": "认证失败。"
          },
