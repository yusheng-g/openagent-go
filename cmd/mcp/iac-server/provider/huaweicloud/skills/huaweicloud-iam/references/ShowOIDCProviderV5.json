{
  "name": "ShowOIDCProviderV5",
  "summary": "查询指定OIDC提供商",
  "tags": "OIDC身份提供商管理",
  "productshort": "IAM",
  "region_id": "ae-ad-1",
  "paths": {
    "/v5/oidc-providers/{provider_id}": {
      "get": {
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "tags": [
          "OIDCIdentityProvider"
        ],
        "summary": "查询指定OIDC提供商",
        "description": "该接口可以用于查询 OpenID Connect (OIDC) 的身份提供商 (IdP) 详情。",
        "operationId": "ShowOIDCProviderV5",
        "parameters": [
          {
            "$ref": "#/components/parameters/ProviderId"
          }
        ],
        "responses": {
          "200": {
            "description": "请求成功。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "oidc_provider"
                  ],
                  "properties": {
                    "oidc_provider": {
                      "type": "object",
                      "required": [
                        "provider_id",
                        "name",
                        "url",
                        "urn",
                        "client_ids",
                        "thumbprints",
                        "tags",
                        "created_at",
                        "description"
                      ],
                      "properties": {
                        "provider_id": {
                          "type": "string",
                          "description": "**参数解释**:\nOIDC 身份提供商的 ID。\n\n**取值范围**:\n字符串长度在 1 到 64 之间,并且只能包含:字母、数字、中划线(-)。",
                          "pattern": "^[a-zA-Z0-9-]{1,64}$",
                          "x-api-type": "open-api"
                        },
                        "name": {
                          "type": "string",
                          "description": "**参数解释**:\nOIDC 身份提供商的名称。\n\n**取值范围**:\n字符串长度在 1 到 64 之间,并且只能包含:字母、数字、下划线(_)、中划线(-)。",
                          "pattern": "^[a-zA-Z0-9_\\-]{1,64}$",
                          "minLength": 1,
                          "maxLength": 64,
                          "x-api-type": "open-api"
                        },
                        "description": {
                          "type": "string",
                          "description": "**参数解释**:\n身份提供商描述。\n\n**取值范围**:\n字符串长度不超过 255,并且不能包含特定字符\"@\"、\"#\"、\"%\"、\"&\"、\"<\"、\">\"、\"\\\"、\"$\"、\"^\"和\"*\"。",
                          "maxLength": 255,
                          "pattern": "^[^@#%&<>\\\\\\$\\^\\*]*$"
                        },
                        "url": {
                          "type": "string",
                          "description": "**参数解释**:\nOIDC 身份提供商的 URL。\n\n**取值范围**:\n字符串长度在 1 到 255 之间。",
                          "minLength": 1,
                          "maxLength": 255,
                          "x-api-type": "open-api"
                        },
                        "urn": {
                          "type": "string",
                          "minLength": 16,
                          "maxLength": 1500,
                          "pattern": "^[A-Za-z0-9/=_:-]+$",
                          "description": "**参数解释**:\n统一资源名称。\n\n**取值范围**:\n字符串长度在 16 到 1500 之间,并且只能包含:字母、数字、字符\"/\"、\"=\"、\"_\"、\":\"、\"-\"。"
                        },
                        "client_ids": {
                          "type": "array",
                          "description": "**参数解释**:\n客户端 ID 列表。\n\n**取值范围**:\n数组长度在 1 到 100 之间;数组元素为字符串,长度在 1 到 255 之间。",
                          "minItems": 1,
                          "maxItems": 100,
                          "items": {
                            "minLength": 1,
                            "maxLength": 255,
                            "type": "string"
                          },
                          "x-api-type": "open-api"
                        },
                        "thumbprints": {
                          "type": "array",
                          "description": "**参数解释**:\nOIDC 身份提供商的服务器证书指纹列表。\n\n**取值范围**:\n数组长度在 1 到 5 之间;数组元素为长度为 64 的字符串,并且只能包含字母、数字。",
                          "maxItems": 5,
                          "items": {
                            "minLength": 64,
                            "maxLength": 64,
                            "pattern": "^[A-Za-z0-9]+$",
                            "type": "string"
                          },
                          "x-api-type": "open-api",
                          "minItems": 1
                        },
                        "tags": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "description": "**参数解释**:\n自定义标签信息。\n\n**取值范围**:\n不涉及。",
                            "required": [
                              "tag_key",
                              "tag_value"
                            ],
                            "properties": {
                              "tag_key": {
                                "type": "string",
                                "pattern": "^(?!\\s)(?!_sys_)[\\p{L}\\p{Z}\\p{N}_.:=+\\-@]*(?<!\\s)$",
                                "minLength": 1,
                                "maxLength": 64,
                                "description": "**参数解释**:\n标签键。\n\n**取值范围**:\n字符串长度在 1 到 64 之间,可以包含任意语种字母、数字、空格以及\"_\"、\".\"、\":\"、\"=\"、\"+\"、\"-\"、\"@\"符号;首尾不能包含空格,且不能以\"_sys_\"开头。"
                              },
                              "tag_value": {
                                "type": "string",
                                "pattern": "^[\\p{L}\\p{Z}\\p{N}_.:\\/=+\\-@]*$",
                                "minLength": 0,
                                "maxLength": 128,
                                "description": "**参数解释**:\n标签值。\n\n**取值范围**:\n字符串长度在 0 到 128 之间,可以包含任意语种字母、数字、空格以及\"_\"、\".\"、\":\"、\"/\"、\"=\"、\"+\"、\"-\"、\"@\"符号,可以为空字符串。"
                              }
                            }
                          },
                          "description": "**参数解释**:\n自定义标签列表。\n\n**取值范围**:\n数组长度不涉及。",
                          "minItems": 0,
                          "maxItems": 20,
                          "x-api-type": "open-api"
                        },
                        "created_at": {
                          "type": "string",
                          "format": "date-time",
                          "description": "**参数解释**:\n提供商创建时间。\n\n**取值范围**:\n不涉及"
                        }
                      },
                      "description": "**参数解释**:\nOIDC 提供商。\n\n**取值范围**:\n不涉及。"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "没有操作权限。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForbiddenErrorResp"
                }
              }
            }
          },
          "404": {
            "description": "未找到相应的资源。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundErrorResp"
                }
              }
            }
          }
        }
      }
    }
  },
