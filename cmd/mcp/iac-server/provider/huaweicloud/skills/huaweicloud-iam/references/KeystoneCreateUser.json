  "definitions": {
    "KeystoneCreateUserOption": {
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "example": "IAMUser",
          "description": "IAM用户名,长度1~64之间,只能包含如下字符:大小写字母、空格、数字或特殊字符(-_.)且不能以数字开头。"
        },
        "domain_id": {
          "type": "string",
          "example": "d78cbac186b744899480f25bd022f468",
          "description": "IAM用户所属账号ID。"
        },
        "password": {
          "type": "string",
          "format": "password",
          "example": "IAMPassword@",
          "description": "IAM用户密码。\n- 系统默认密码最小长度为6位字符,在6-32位之间支持用户自定义密码长度。\n- 至少包含以下四种字符中的两种: 大写字母、小写字母、数字和特殊字符。\n- 不能包含手机号和邮箱。\n- 必须满足账户设置中密码策略的要求。"
        },
        "enabled": {
          "type": "boolean",
          "example": true,
          "description": "是否启用IAM用户。true为启用,false为停用,默认为true。"
        },
        "description": {
          "type": "string",
          "example": "IAMDescription",
          "description": "IAM用户描述信息。"
        }
      },
      "description": ""
    },
    "KeystoneCreateUserResponseBody": {
      "required": [
        "user"
      ],
      "properties": {
        "user": {
          "description": "IAM用户信息。",
          "$ref": "#/definitions/KeystoneCreateUserResult"
        }
      },
      "description": ""
    },
    "KeystoneCreateUserRequestBody": {
      "required": [
        "user"
      ],
      "properties": {
        "user": {
          "description": "用户信息。",
          "$ref": "#/definitions/KeystoneCreateUserOption"
        }
      },
      "description": ""
    },
    "KeystoneCreateUserResult": {
      "required": [
        "domain_id",
        "enabled",
        "id",
        "links",
        "name",
        "password_expires_at"
      ],
      "properties": {
        "domain_id": {
          "type": "string",
          "example": "d78cbac186b744899480f25bd022f468",
          "description": "IAM用户所属账号ID。"
        },
        "name": {
          "type": "string",
          "example": "IAMUser",
          "description": "IAM用户名。"
        },
        "description": {
          "type": "string",
          "example": "IAMDescription",
          "description": "IAM用户描述信息。"
        },
        "pwd_status": {
          "type": "boolean",
          "example": false,
          "description": "IAM用户密码状态。true:需要修改密码,false:不需要修改密码。"
        },
        "password_expires_at": {
          "type": "string",
          "example": "null",
          "description": "IAM用户密码过期时间(UTC时间),“null”表示密码不过期。"
        },
        "links": {
          "description": "IAM用户的资源链接信息。",
          "$ref": "#/definitions/LinksSelf"
        },
        "id": {
          "type": "string",
          "example": "076652f08880266a1f0bc003ec005cd2",
          "description": "IAM用户ID。"
        },
        "enabled": {
          "type": "boolean",
          "example": false,
          "description": "IAM用户是否启用。true表示启用,false表示停用,默认为true。"
        }
      }
    },
