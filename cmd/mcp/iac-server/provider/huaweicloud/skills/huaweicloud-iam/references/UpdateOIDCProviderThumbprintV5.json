{
  "name": "UpdateOIDCProviderThumbprintV5",
  "summary": "替换OIDC提供商指纹列表",
  "tags": "OIDC身份提供商管理",
  "productshort": "IAM",
  "region_id": "ae-ad-1",
  "paths": {
    "/v5/oidc-providers/{provider_id}/thumbprint": {
      "put": {
        "x-support-sdk": "Y",
