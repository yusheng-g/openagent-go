        },
        "secret": {
          "type": "string",
          "example": "G8jME3FdItroUAxevyZy5EJJ00lJj6Y52NtVSMzr",
          "description": "获取的SK。"
        },
        "securitytoken": {
          "type": "string",
          "example": "gQpjbi1ub3J0aC00jN8BogWJ6OgFkxd_e---9bY_7QIw-92jIFQQ-A9RdR...",
          "description": "securitytoken是将所获的AK、SK等信息进行加密后的字符串。"
        }
      },
      "description": ""
    }
  },
