        ],
        "summary": "导入Metadata文件",
        "description": "该接口可以用于[管理员](https://support.huaweicloud.com/usermanual-iam/iam_01_0001.html)导入Metadata文件。\n\n账号在使用联邦认证功能前,需要先将Metadata文件导入到IAM中。Metadata文件是SAML 2.0协议约定的接口文件,包含访问接口地址和证书信息,请找企业管理员获取企业IdP的Metadata文件。\n\n该接口可以使用全局区域的Endpoint和其他区域的Endpoint调用。IAM的Endpoint请参见:[地区和终端节点](https://developer.huaweicloud.com/endpoint?IAM)。",
        "operationId": "CreateMetadata",
        "consumes": [],
        "produces": [],
        "parameters": [
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "拥有Security Administrator权限的token。",
            "required": true,
            "type": "string",
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCA38CAQExDTALBglghkgBZQMEAgEwgXXXXX...",
            "x-order": 1
          },
          {
            "name": "idp_id",
            "in": "path",
            "description": "身份提供商ID。",
            "required": true,
            "type": "string",
            "x-example": "ACME",
            "x-order": 2
          },
          {
            "name": "protocol_id",
            "in": "path",
            "description": "协议ID。",
            "required": true,
            "type": "string",
