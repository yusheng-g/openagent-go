              "type": "boolean",
              "example": false,
              "description": "是否开启操作保护,取值范围true或false。"
            },
            "admin_check": {
              "type": "string",
              "example": "off",
              "description": "是否指定人员验证。on为指定人员验证,必须填写scene参数。off为操作员验证。"
            },
            "scene": {
              "type": "string",
              "description": "操作保护指定人员验证方式,admin_check为on时,必须填写。包括mobile、email。"
            }
          }
        }
      }
    },
    "AllowUserBody": {
      "properties": {
        "manage_accesskey": {
          "type": "boolean",
          "example": true,
          "description": "是否允许子用户自行管理AK,取值范围true或false。"
        },
        "manage_email": {
          "type": "boolean",
          "example": true,
          "description": "是否允许子用户自己修改邮箱,取值范围true或false。"
        },
        "manage_mobile": {
          "type": "boolean",
          "example": true,
          "description": "是否允许子用户自己修改电话,取值范围true或false。"
        },
        "manage_password": {
          "type": "boolean",
          "example": false,
          "description": "是否允许子用户自己修改密码,取值范围true或false。"
        }
      },
      "description": "用户可以自主修改的属性。"
    },
