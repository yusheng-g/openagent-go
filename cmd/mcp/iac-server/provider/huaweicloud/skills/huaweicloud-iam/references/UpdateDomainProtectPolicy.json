      "required": [
        "operation_protection"
      ],
      "properties": {
        "operation_protection": {
          "type": "boolean",
          "example": true,
          "description": "是否开启操作保护,开启为\"true\",未开启为\"false\"。"
        },
        "allow_user": {
          "$ref": "#/definitions/AllowUserBody"
        },
        "mobile": {
          "type": "string",
          "description": "操作保护验证指定手机号码。示例:0086-123456789。"
