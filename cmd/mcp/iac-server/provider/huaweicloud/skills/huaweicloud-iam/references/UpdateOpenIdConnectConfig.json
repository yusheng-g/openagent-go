        },
        "response_mode": {
          "type": "string",
          "description": "授权请求返回方式, form_post 或 fragment ;编程访问和管理控制台访问方式值不为空,编程访问方式值可为空",
          "enum": [
            "fragment",
            "form_post"
          ]
        },
        "signing_key": {
          "type": "string",
          "description": "OpenID Connect身份提供商ID Token签名的公钥",
