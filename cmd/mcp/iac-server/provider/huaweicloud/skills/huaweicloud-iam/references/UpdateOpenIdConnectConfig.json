      "properties": {
        "access_mode": {
          "type": "string",
          "description": "访问方式:\nprogram_console: 支持编程访问和管理控制台访问方式;\nprogram: 支持编程访问方式"
        },
        "idp_url": {
          "type": "string",
          "description": "OpenID Connect身份提供商标识, 对应ID token 中 iss",
          "minLength": 10,
          "maxLength": 255
        },
        "client_id": {
          "type": "string",
          "description": "在OpenID Connect身份提供商注册的客户端ID",
          "minLength": 5,
          "maxLength": 255
        },
        "authorization_endpoint": {
          "type": "string",
          "description": "OpenID Connect身份提供商授权地址; 编程访问和管理控制台访问方式值不为空,编程访问方式值可为空",
          "minLength": 10,
          "maxLength": 255
        },
        "scope": {
          "type": "string",
          "example": "\"openid\", \"openid email\", \"openid profile\", \"openid email profile\"",
          "description": "授权请求信息范围,编程访问和管理控制台访问方式必选,编程访问方式不可选,可选值:openid 、email、profile,IDP自定义scope,字符集a-zA-Z_0-9 ,1-10个可选值组合空格分割,至少包括openid,顺序无关,总长度最长255字符,例如:\"openid\"、\"openid email\"、\"openid profile\" 、\"openid email profile\"",
