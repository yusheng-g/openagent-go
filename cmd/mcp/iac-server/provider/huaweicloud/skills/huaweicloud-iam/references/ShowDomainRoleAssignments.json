  "paths": {
    "/v3.0/OS-PERMISSION/role-assignments": {
      "get": {
        "tags": [
          "权限管理"
        ],
        "operationId": "ShowDomainRoleAssignments",
        "summary": "查询指定账号中的授权记录",
        "description": "该接口用于查询指定账号中的授权记录。\n该接口可以使用全局区域的Endpoint和其他区域的Endpoint调用。IAM的Endpoint请参见:[地区和终端节点](https://developer.huaweicloud.com/endpoint?IAM)。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "domain_id",
            "in": "query",
            "required": true,
            "description": "待查询账号ID。",
            "type": "string"
          },
          {
            "name": "role_id",
            "in": "query",
            "required": false,
            "description": "策略ID。",
            "type": "string"
          },
          {
            "name": "subject",
            "in": "query",
            "required": false,
            "description": "授权主体,取值范围:user、group、agency。该参数与subject.user_id、subject.group_id、subject.agency_id只能选择一个。",
            "type": "string"
          },
          {
            "name": "subject.user_id",
            "in": "query",
            "required": false,
            "description": "授权的IAM用户ID。",
            "type": "string"
          },
          {
            "name": "subject.group_id",
            "in": "query",
            "required": false,
            "description": "授权的用户组ID。",
            "type": "string"
          },
          {
            "name": "subject.agency_id",
            "in": "query",
            "required": false,
            "description": "授权的委托ID。",
            "type": "string"
          },
          {
            "name": "scope",
            "in": "query",
            "required": false,
            "description": "授权范围,取值范围:project、domain、enterprise_project。该参数与scope.project_id、scope.domain_id、scope.enterprise_projects_id只能选择一个。\n> - 如需查看全局服务授权记录,scope取值domain或填写scope.domain_id。\n> - 如需查看基于所有资源的授权记录,scope取值为domain,且is_inherited取值为true\n> - 如需查看基于项目的授权记录,scope取值为project或填写scope.project_id。\n> - 如需查看基于企业项目的授权记录,scope取值为enterprise_project或填写scope.enterprise_project_id。",
            "type": "string"
          },
          {
            "name": "scope.project_id",
            "in": "query",
            "required": false,
            "description": "授权的项目ID。",
            "type": "string"
          },
          {
            "name": "scope.domain_id",
            "in": "query",
            "required": false,
            "description": "待查询账号ID。",
            "type": "string"
          },
          {
            "name": "scope.enterprise_projects_id",
            "in": "query",
            "required": false,
            "description": "授权的企业项目ID。",
            "type": "string"
          },
          {
            "name": "is_inherited",
            "in": "query",
            "required": false,
            "description": "是否包含基于所有项目授权的记录,默认为false。当参数scope=domain或者scope.domain_id存在时生效。true:查询基于所有项目授权的记录。 false:查询基于全局服务授权的记录。",
            "type": "boolean"
          },
          {
            "name": "include_group",
            "in": "query",
            "required": false,
            "description": "是否包含基于IAM用户所属用户组授权的记录,默认为true。当参数subject=user或者subject.user_id存在时生效。true:查询基于IAM用户授权、IAM用户所属用户组授权的记录。 false:仅查询基于IAM用户授权的记录。",
            "type": "boolean"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "分页查询时数据的页数,查询值最小为1。需要与per_page同时存在。",
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "description": "分页查询时每页的数据个数,取值范围为[1,50]。需要与page同时存在。",
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "拥有Security Administrator或iam:permissions:listRoleAssignments权限的token。",
            "type": "string"
          }
        ],
        "responses": {
