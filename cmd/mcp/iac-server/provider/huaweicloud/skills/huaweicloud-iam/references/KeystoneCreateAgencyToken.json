                "error": {
                  "code": 401,
                  "message": "The X-Auth-Token is invalid!",
                  "title": "Unauthorized"
                }
              }
            }
          },
          "403": {
            "description": "没有操作权限。\n- 可能原因:被委托方B中用户B的用户token(即X-Auth-Token填写的token)缺少Agent Operator权限,请添加权限。",
            "examples": {
              "application/json": {
                "error": {
                  "code": 403,
                  "message": "You have no right to do this action",
                  "title": "Forbidden"
                }
              }
