  "paths": {
    "/v5/oidc-providers": {
      "post": {
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-api-type": "open-api",
        "tags": [
          "OIDCIdentityProvider"
        ],
        "summary": "创建OIDC提供商",
        "description": "该接口可以用于创建一个支持 OpenID Connect (OIDC) 的身份提供商 (IdP)。\n您通过此操作创建的 OIDC 提供商可用作信任委托的信任策略中的主体 (Principal),用于在华为云和 OIDC 提供商之间建立信任关系。\n您可以直接使用您的身份提供商去创建新的信任委托,要了解更多信息,请参阅 IAM 用户指南中的**身份提供商**章节。\n\n当您创建 IAM OIDC 提供商时,您需要指定以下内容:\n- 要信任的 OIDC 身份提供商的 URL。\n- 客户端 ID 列表(也称为受众 Audiences),用于识别允许使用该 OIDC 提供商进行身份验证的应用程序。\n- 附加到指定 IAM OIDC 提供商的标签列表。\n- OIDC 身份提供商使用的一个或多个服务器证书的指纹列表。\n\n**注意:**\nIAM 使用我们的信任根证书颁发机构 (CAs) 库来验证 JSON Web Key Set (JWKS) 端点的 TLS 证书,从而确保与 OIDC 身份提供商 (IdPs) 的通信安全。如果您的 OIDC IdP 依赖于不是由这些受信任 CA 之一签名的证书,那么我们才会使用 IdP 配置中设置的指纹来确保通信安全。",
        "operationId": "CreateOIDCProviderV5",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOIDCProviderReqBody"
              },
              "example": {
                "url": "string",
                "name": "string",
                "description": "string",
                "client_ids": [
                  "string"
                ],
                "thumbprints": [
                  "stringstringstringstringstringstringstringstringstringstringstri"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "请求成功。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "oidc_provider"
                  ],
                  "properties": {
                    "oidc_provider": {
                      "type": "object",
                      "required": [
                        "provider_id",
                        "name",
                        "url",
                        "urn",
                        "client_ids",
                        "thumbprints",
                        "created_at",
                        "description"
                      ],
                      "properties": {
                        "provider_id": {
                          "type": "string",
                          "description": "**参数解释**:\nOIDC 身份提供商的 ID。\n\n**取值范围**:\n字符串长度在 1 到 64 之间,并且只能包含:字母、数字、中划线(-)。",
                          "pattern": "^[a-zA-Z0-9-]{1,64}$",
                          "x-api-type": "open-api"
                        },
                        "name": {
                          "type": "string",
                          "description": "**参数解释**:\nOIDC 身份提供商的名称。\n\n**取值范围**:\n字符串长度在 1 到 64 之间,并且只能包含:字母、数字、下划线(_)、中划线(-)。",
                          "pattern": "^[a-zA-Z0-9_\\-]{1,64}$",
                          "minLength": 1,
                          "maxLength": 64,
                          "x-api-type": "open-api"
                        },
                        "description": {
                          "type": "string",
                          "description": "**参数解释**:\n身份提供商描述。\n\n**取值范围**:\n字符串长度不超过 255,并且不能包含特定字符\"@\"、\"#\"、\"%\"、\"&\"、\"<\"、\">\"、\"\\\"、\"$\"、\"^\"和\"*\"。",
                          "maxLength": 255,
                          "pattern": "^[^@#%&<>\\\\\\$\\^\\*]*$",
                          "x-api-type": "open-api"
                        },
                        "url": {
                          "type": "string",
                          "description": "**参数解释**:\nOIDC 身份提供商的 URL。\n\n**取值范围**:\n字符串长度在 1 到 255 之间。",
                          "minLength": 1,
                          "maxLength": 255,
                          "x-api-type": "open-api"
                        },
                        "urn": {
                          "type": "string",
                          "minLength": 16,
                          "maxLength": 1500,
                          "pattern": "^[A-Za-z0-9/=_:-]+$",
                          "description": "**参数解释**:\n统一资源名称。\n\n**取值范围**:\n字符串长度在 16 到 1500 之间,并且只能包含:字母、数字、字符\"/\"、\"=\"、\"_\"、\":\"、\"-\"。"
                        },
                        "client_ids": {
                          "type": "array",
                          "description": "**参数解释**:\n客户端 ID 列表。\n\n**取值范围**:\n数组长度在 1 到 100 之间;数组元素为字符串,长度在 1 到 255 之间。",
                          "minItems": 1,
                          "maxItems": 100,
                          "items": {
                            "minLength": 1,
                            "maxLength": 255,
                            "type": "string"
                          },
                          "x-api-type": "open-api"
                        },
                        "thumbprints": {
                          "type": "array",
                          "description": "**参数解释**:\nOIDC 身份提供商的服务器证书指纹列表。\n\n**取值范围**:\n数组长度在 1 到 5 之间;数组元素为长度为 64 的字符串,并且只能包含字母、数字。",
                          "maxItems": 5,
                          "items": {
                            "minLength": 64,
                            "maxLength": 64,
                            "pattern": "^[A-Za-z0-9]+$",
                            "type": "string"
                          },
                          "x-api-type": "open-api",
                          "minItems": 1
                        },
                        "created_at": {
                          "type": "string",
                          "format": "date-time",
                          "description": "**参数解释**:\n提供商创建时间。\n\n**取值范围**:\n不涉及"
                        }
                      },
                      "description": "**参数解释**:\nOIDC 提供商。\n\n**取值范围**:\n不涉及。",
                      "x-api-type": "open-api"
                    }
                  }
                }
              }
            }
          },
