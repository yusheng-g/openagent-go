                            "minLength": 1,
                            "maxLength": 255,
                            "x-api-type": "open-api"
                          },
                          "urn": {
                            "type": "string",
                            "minLength": 16,
                            "maxLength": 1500,
                            "pattern": "^[A-Za-z0-9/=_:-]+$",
                            "description": "**参数解释**:\n统一资源名称。\n\n**取值范围**:\n字符串长度在 16 到 1500 之间,并且只能包含:字母、数字、字符\"/\"、\"=\"、\"_\"、\":\"、\"-\"。"
                          },
                          "client_ids": {
                            "type": "array",
                            "description": "**参数解释**:\n客户端 ID 列表。\n\n**取值范围**:\n数组长度在 1 到 100 之间;数组元素为字符串,长度在 1 到 255 之间。",
                            "minItems": 1,
                            "maxItems": 100,
                            "items": {
                              "minLength": 1,
                              "maxLength": 255,
                              "type": "string"
                            },
                            "x-api-type": "open-api"
                          },
                          "thumbprints": {
