                            "maxItems": 5,
                            "items": {
                              "minLength": 64,
                              "maxLength": 64,
                              "pattern": "^[A-Za-z0-9]+$",
                              "type": "string"
                            },
                            "x-api-type": "open-api",
                            "minItems": 1
                          },
                          "created_at": {
                            "type": "string",
                            "format": "date-time",
                            "description": "**参数解释**:\n提供商创建时间。\n\n**取值范围**:\n不涉及。"
                          }
                        }
                      },
                      "description": "**参数解释**:\nOIDC 提供商列表。\n\n**取值范围**:\n不涉及。",
