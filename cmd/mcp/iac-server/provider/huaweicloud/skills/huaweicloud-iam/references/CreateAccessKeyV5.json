        "summary": "创建永久访问密钥",
        "description": "该接口可以用于给IAM用户创建永久访问密钥。\n\n访问密钥(Access Key ID/Secret Access Key,简称AK/SK),是您通过开发工具(API、CLI、SDK)访问的身份凭证,不用于登录控制台。系统通过AK识别访问用户的身份,通过SK进行签名验证,通过加密签名验证可以确保请求的机密性、完整性和请求者身份的正确性。",
        "parameters": [
          {
            "$ref": "#/components/parameters/UserId"
          }
        ],
        "x-request-examples-description-1": "给IAM用户创建永久访问密钥。",
        "x-request-examples-url-1": "POST https://{endpoint}/v5/users/{user_id}/access-keys",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-apiexplorer-hide": "N",
        "responses": {
          "201": {
            "description": "请求成功。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateAccessKeyResp"
                },
                "example": {
                  "access_key": {
                    "user_id": "user",
                    "access_key_id": "access",
                    "created_at": "2023-09-13T06:51:20.550Z",
                    "secret_access_key": "secret",
                    "status": "active"
                  }
                }
              }
