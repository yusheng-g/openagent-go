          "$ref": "#/definitions/TokenAuthIdentity"
        }
      },
      "description": ""
    },
    "TokenAuthIdentity": {
      "required": [
        "methods"
      ],
      "properties": {
        "methods": {
          "type": "array",
          "description": "认证方法,该字段内容为[\"token\"]。",
          "items": {
            "type": "string",
            "enum": [
              "token"
            ]
          },
          "maxItems": 1,
          "minItems": 1
        },
        "token": {
          "description": "IAM用户token或联邦用户的token或委托token,该参数中的“id”与请求头中的X-Auth-Token含义相同,待废弃。",
          "$ref": "#/definitions/IdentityToken"
        },
        "policy": {
          "description": "自定义策略的具体内容。",
