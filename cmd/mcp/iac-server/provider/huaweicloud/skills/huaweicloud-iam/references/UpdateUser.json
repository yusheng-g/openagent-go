    "UpdateUserOption": {
      "properties": {
        "access_mode": {
          "type": "string",
          "example": "default",
          "description": "IAM用户访问方式。\n- default:默认访问模式,编程访问和管理控制台访问。\n- programmatic:编程访问。\n- console:管理控制台访问。"
        },
        "name": {
          "type": "string",
          "example": "IAMUser",
          "description": "新IAM用户名,长度1~64之间,只能包含如下字符:大小写字母、空格、数字或特殊字符(-_.)且不能以数字开头。"
        },
        "password": {
          "type": "string",
          "format": "password",
          "example": "IAMNewPassword@",
          "description": "IAM用户新密码。\n- 系统默认密码最小长度为6字符,在6-32字符之间支持用户自定义密码长度。\n- 至少包含以下四种字符中的两种: 大写字母、小写字母、数字和特殊字符。\n- 必须满足账户设置中[密码策略](https://support.huaweicloud.com/usermanual-iam/iam_01_0607.html)的要求。\n- 新密码不能与当前密码相同。\n"
        },
        "email": {
          "type": "string",
          "example": "IAMEmail@huawei.com",
          "description": "IAM用户新邮箱,需符合邮箱格式,长度小于等于255字符。"
        },
        "areacode": {
          "type": "string",
          "example": "0086",
          "description": "国家码。必须与手机号同时存在。中国大陆为“0086”。"
        },
        "phone": {
          "type": "string",
          "example": "12345678910",
          "description": "IAM用户新手机号,纯数字,长度小于等于32字符。必须与国家码同时存在。"
        },
        "enabled": {
          "type": "boolean",
          "example": true,
          "description": "是否启用IAM用户。true为启用,false为停用,默认为true。"
        },
        "pwd_status": {
          "type": "boolean",
          "description": "IAM用户密码状态。true:需要修改密码,false:不需要修改密码。"
        },
        "xuser_type": {
          "type": "string",
          "example": "AGC",
          "description": "IAM用户在外部系统中的类型。长度小于等于64字符。xuser_type如果存在,则需要与同一租户中的xaccount_type、xdomain_type校验,须与xuser_id同时存在。\n>外部系统指与华为云对接的外部企业管理系统,xaccount_type、xaccount_id、xdomain_type、xdomain_id、xuser_type、xuser_id等参数值,无法在华为云获取,请咨询企业管理员。"
        },
        "xuser_id": {
          "type": "string",
          "example": "57e9bd87d4394fa380056250a7eb231b",
          "description": "IAM用户在外部系统中的ID。长度小于等于128字符,必须与xuser_type同时存在。\n>外部系统指与华为云对接的外部企业管理系统,xaccount_type、xaccount_id、xdomain_type、xdomain_id、xuser_type、xuser_id等参数值,无法在华为云获取,请咨询企业管理员。"
        },
        "description": {
          "type": "string",
          "example": "IAMDescription",
          "description": "IAM用户新描述信息。"
        }
