  "definitions": {
    "CustomStatement": {
      "required": [
        "Action",
        "Effect"
      ],
      "properties": {
        "Action": {
          "type": "array",
          "description": "授权项,指对资源的具体操作权限。\n> - 格式为:服务名:资源类型:操作,例:vpc:ports:create。\n> - 服务名为产品名称,例如ecs、evs和vpc等,服务名仅支持小写。 资源类型和操作没有大小写,要求支持通配符号*,无需罗列全部授权项。",
          "items": {
            "type": "string"
          }
        },
        "Effect": {
          "type": "string",
          "example": "Allow",
          "description": "作用。包含两种:允许(Allow)和拒绝(Deny),既有Allow又有Deny的授权语句时,遵循Deny优先的原则。",
          "enum": [
            "Allow",
            "Deny"
          ]
        },
        "Condition": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "description": "",
            "additionalProperties": {
              "description": "",
              "$ref": "#/definitions/ConditionAdditional"
            }
          }
        },
        "Resource": {
          "type": "object",
          "description": "资源。规则如下:\n> - 可填 * 的五段式:<service-name>:<region>:<account-id>:<resource-type>:<resource-path>,例:\"obs:*:*:bucket:*\"。\n> - region字段为*或用户可访问的region。service必须存在且resource属于对应service。"
        }
      },
      "description": ""
    },
    "ConditionAdditional": {
      "type": "array",
      "description": "",
      "items": {
        "type": "string"
      }
    },
    "ShowCustomPolicyResponseBody": {
      "required": [
        "role"
      ],
      "properties": {
        "role": {
          "description": "自定义策略信息。",
          "$ref": "#/definitions/ShowPolicyRoleResult"
        }
      },
      "description": ""
    },
    "ShowPolicyRoleResult": {
      "required": [
        "catalog",
        "description",
        "display_name",
        "domain_id",
        "id",
        "links",
        "name",
        "policy",
        "type"
      ],
      "properties": {
        "domain_id": {
          "type": "string",
          "example": "9698542758bc422088c0c3eabfc30d12",
          "description": "自定义策略所属账号ID。"
        },
        "references": {
          "type": "integer",
          "format": "int32",
          "example": 0,
          "description": "自定义策略的引用次数。"
        },
        "updated_time": {
          "type": "string",
          "example": "1579157459495",
          "description": "自定义策略更新时间。"
        },
        "created_time": {
          "type": "string",
          "example": "1577026425747",
          "description": "自定义策略创建时间。"
        },
        "description_cn": {
          "type": "string",
          "example": "中文描述",
          "description": "自定义策略的中文描述信息。"
        },
        "catalog": {
          "type": "string",
          "example": "CUSTOMED",
          "description": "自定义策略所在目录。"
        },
        "name": {
          "type": "string",
          "example": "custom_d78cbac186b744899480f25bd022f468_2",
          "description": "自定义策略名。"
        },
        "description": {
          "type": "string",
          "example": "IAMDescription",
          "description": "自定义策略的描述信息。"
        },
        "links": {
          "description": "自定义策略的资源链接信息。",
          "$ref": "#/definitions/LinksSelf"
        },
        "id": {
          "type": "string",
          "example": "608776087b7649ad92c6f11ffd5bf35a",
          "description": "自定义策略ID。"
        },
        "display_name": {
          "type": "string",
          "example": "IAMPolicy",
          "description": "自定义策略展示名。"
        },
        "type": {
          "type": "string",
          "example": "AX",
          "description": "自定义策略的显示模式。\n> - AX表示在domain层显示。\n> - XA表示在project层显示。\n> - 自定义策略的显示模式只能为AX或者XA,不能在domain层和project层都显示(AA),或者在domain层和project层都不显示(XX)。"
        },
        "policy": {
          "description": "自定义策略的具体内容。",
          "$ref": "#/definitions/CustomPolicy"
        }
      },
      "description": ""
    },
    "CustomPolicy": {
      "required": [
        "Statement",
        "Version"
      ],
      "properties": {
        "Version": {
          "type": "string",
          "example": "1.1",
          "description": "权限版本号,创建自定义策略时,该字段值填为“1.1”。\n> - 1.0:系统预置的角色。以服务为粒度,提供有限的服务相关角色用于授权。\n> - 1.1:策略。IAM最新提供的一种细粒度授权的能力,可以精确到具体服务的操作、资源以及请求条件等。",
          "default": "1.1"
        },
        "Statement": {
          "type": "array",
          "description": "授权语句,描述自定义策略的具体内容。",
          "items": {
            "$ref": "#/definitions/CustomStatement"
          }
        }
      },
      "description": ""
    },
    "LinksSelf": {
      "required": [
        "self"
      ],
      "properties": {
        "self": {
          "type": "string",
          "example": "https://iam.myhuaweicloud.com/v3/regions/la-south-2",
          "description": "资源链接地址。"
        }
      },
      "description": ""
    }
  },
