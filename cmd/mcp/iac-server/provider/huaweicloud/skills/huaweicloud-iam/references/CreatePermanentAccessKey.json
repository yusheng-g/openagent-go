                "error": {
                  "message": "akSkNumExceed",
                  "code": 400,
                  "title": "Bad Request"
                }
              }
            }
          },
          "401": {
            "description": "认证失败。"
          },
          "403": {
            "description": "没有操作权限。"
          },
          "500": {
            "description": "内部服务错误。"
          }
        },
        "deprecated": false,
        "x-name": "创建永久访问密钥",
        "x-constraint": "",
