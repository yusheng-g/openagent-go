                  "description": "IAMDescription",
                  "secret": "TTqAHPbhWorg9ozx8Dv9MUyzYnOKDppxzHto5g82",
                  "status": "active"
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/CreatePermanentAccessKeyResponseBody"
            }
          },
          "400": {
            "description": "参数无效。(包括密钥数量已达到上限。)",
