  "definitions": {
    "BatchAddServerNicOption": {
      "properties": {
        "subnet_id": {
          "type": "string",
          "example": "d32019d3-bc6e-4319-9c1d-6722fc136a23",
          "description": "云服务器添加网卡的信息。\n\n需要指定云服务器所属虚拟私有云下已创建的网络(network)的ID,UUID格式。",
          "x-huawei-extraAnnotation": ""
        },
        "port_id": {
          "type": "string",
          "example": "",
          "description": "网卡ID,UUID格式。 当该字段不为空时,表示挂载指定的网卡。port_id和subnet_id不能同时为空。\n网卡ID可以从虚拟私有云的“查询端口列表”章节查询到。\n约束:\n网卡状态必须为DOWN。\n网卡的vpcid必须和传入的vpcid一致。\n当port_id和subnet_id同时存在的时候,优先使用port_id。当选择port_id不为空时,代表此时使用的是弹性网卡,此时security_groups和ip_address等参数不生效。"
        },
        "security_groups": {
          "type": "array",
          "description": "添加网卡的安全组信息",
          "items": {
            "$ref": "#/definitions/ServerNicSecurityGroup"
          }
        },
        "ip_address": {
          "type": "string",
          "example": "1.1.1.1",
          "description": "IP地址,无该参数表示自动分配IP地址。"
        },
        "ipv6_enable": {
          "type": "boolean",
          "description": "是否支持ipv6。\n\n取值为true时,标识此网卡支持ipv6。",
          "x-huawei-extraAnnotation": ""
        },
        "ipv6_bandwidth": {
          "description": "绑定的共享带宽信息",
          "$ref": "#/definitions/Ipv6Bandwidth",
          "x-huawei-extraAnnotation": ""
        },
        "efi_enable": {
          "type": "boolean",
          "example": true,
          "description": "使能网卡的vRoCE能力,只支持从网卡,主网卡不支持。",
          "x-huawei-extraAnnotation": ""
        }
      },
      "description": ""
