            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateLaunchTemplateRequestBody"
            }
          }
        ],
        "x-huawei-security": {
          "policyCheck": {
            "adminRule": "rule:context_is_admin",
            "authRule": "rule:all_admins_or_owner or rule:normal_admin_user_t"
          },
          "pdpKey": "ecs:launchTemplates:create"
        },
        "responses": {
          "200": {
            "description": "执行成功,dryRun返回空结构。",
            "headers": {
              "X-Request-Id": {
                "type": "string",
                "description": "请求id"
              }
            },
            "schema": {
              "$ref": "#/definitions/CreateLaunchTemplateResponseBody"
            }
          }
        },
