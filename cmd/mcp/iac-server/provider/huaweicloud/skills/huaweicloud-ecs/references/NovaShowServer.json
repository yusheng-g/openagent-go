          "minimum": 0,
          "maximum": 4
        },
        "OS-EXT-STS:task_state": {
          "type": "string",
          "description": "扩展属性,云服务器任务状态。\n\n取值范围:\n\nSHOUTOFF, RESIZE, REBUILD, VERIFY_RESIZE, REVERT_RESIZE, PAUSED, MIGRATING, SUSPENDED, RESCUE, ERROR, DELETED,SOFT_DELETED,SHELVED,SHELVED_OFFLOADED\n\n取值范围请参考[云服务器状态](https://support.huaweicloud.com/api-ecs/ecs_08_0002.html)表3。",
          "enum": [
            "SHOUTOFF",
            " RESIZE",
            " REBUILD",
            " VERIFY_RESIZE",
            " REVERT_RESIZE",
            " PAUSED",
            " MIGRATING",
            " SUSPENDED",
            " RESCUE",
            " ERROR",
            " DELETED",
            "SOFT_DELETED",
            "SHELVED",
            "SHELVED_OFFLOADED"
          ]
        },
        "OS-EXT-STS:vm_state": {
          "type": "string",
          "description": "扩展属性,云服务器状态。\n\n取值范围:\n\nACTIVE,BUILDING,STOPPED,RESIZED,PAUSED,SUSPENDED,RESCUED,ERROR,DELETED,SOFT_DELETED,SHELVED,SHELVED_OFFLOADED\n\n云服务器状态说明请参考[云服务器状态](https://support.huaweicloud.com/api-ecs/ecs_08_0002.html)。",
          "enum": [
            "ACTIVE",
            "BUILDING",
            "STOPPED",
            "RESIZED",
            "PAUSED",
            "SUSPENDED",
            "RESCUED",
            "ERROR",
            "DELETED",
            "SOFT_DELETED",
            "SHELVED",
            "SHELVED_OFFLOADED"
          ]
