  "definitions": {
    "NovaCreateServersSchedulerHint": {
      "properties": {
        "group": {
          "type": "string",
          "description": "反亲和性组信息。\n\nUUID格式。"
        },
        "different_host": {
          "type": "array",
          "description": "与指定弹性云服务器满足反亲和性。 \n\n当前不支持该功能。",
          "items": {
            "type": "string",
            "description": ""
          },
          "x-admin": "False",
          "x-internal": "False"
        },
        "same_host": {
          "type": "array",
          "description": "与指定的弹性云服务器满足亲和性。\n\n 当前不支持该功能。",
          "items": {
            "type": "string",
            "description": ""
          },
          "x-admin": "False",
          "x-internal": "False"
        },
        "cidr": {
          "type": "string",
          "description": "将弹性云服务器scheduler到指定网段的host上,host网段的cidr。\n\n 当前不支持该功能。",
          "x-admin": "False",
          "x-internal": "False"
        },
        "build_near_host_ip": {
          "type": "string",
          "description": "将弹性云服务器scheduler到指定网段的host上,host IP地址。\n\n 当前不支持该功能。",
          "x-admin": "False",
          "x-internal": "False"
        },
        "tenancy": {
          "type": "string",
          "description": "在专属主机或共享池中创建弹性云服务器。默认为在共享池创建。\n值为: shared 或dedicated。\nshared:表示共享池。\ndedicated:表示专属主机。\n创建与查询此值均有效。",
          "x-admin": "False",
          "x-internal": "False"
        },
        "dedicated_host_id": {
          "type": "string",
          "description": "专属主机ID。\n此属性仅在tenancy值为dedicated时有效。\n不指定此属性,系统将自动分配租户可自动放置弹性云服务器的专属主机。\n创建与查询此值均有效。",
          "x-admin": "False",
          "x-internal": "False"
        }
      },
      "description": " 弹性云服务器调度信息。\n\n裸金属服务器场景不支持。"
    },
    "NovaLink": {
      "required": [
        "href",
        "rel"
      ],
      "properties": {
        "href": {
          "type": "string",
          "description": "相应资源的链接。"
        },
        "rel": {
          "type": "string",
          "description": "有三种取值。self:自助链接包含版本链接的资源。立即链接后使用这些链接。bookmark:书签链接提供了一个永久资源的永久链接,该链接适合于长期存储。alternate:备用链接可以包含资源的替换表示形式。例如,OpenStack计算映像可能在OpenStack映像服务中有一个替代表示。",
          "enum": [
            "self",
            "bookmark",
            "alternate",
            "describedby"
          ]
        }
      },
      "description": " "
    },
    "NovaCreateServersOption": {
      "required": [
        "flavorRef",
        "name",
        "networks"
      ],
      "properties": {
        "auto_terminate_time": {
          "type": "string",
          "example": "2020-01-19T03:30:52Z",
          "description": "弹性云服务器自动删除时间。\n\n时间格式例如:2020-01-19T03:30:52Z"
        },
        "imageRef": {
          "type": "string",
          "example": "3b8d6fef-af77-42ab-b8b7-5a7f0f0af8f2",
          "description": "镜像ID或者镜像资源的URL。\n\n- 镜像ID示例:3b8d6fef-af77-42ab-b8b7-5a7f0f0af8f2\n- 镜像URL示例:http://glance.openstack.example.com/images/3b8d6fef-af77-42ab-b8b7-5a7f0f0af8f2\n- 指定卷作为系统卷创弹性云服务器时,不需填写该参数;非卷创建弹性云服务器时需填写有效的UUID参数,否则API将返回400错误。\n\n> 说明:\n> - 对于部分规格的弹性云服务器,不能支持公有云平台提供的所有公共镜像。具体规格的镜像支持列表,请登录管理控制台,以“创建弹性云服务器”页面系统自动过滤的镜像信息为准,并在镜像服务页面查询镜像ID。\n> - 如果创建失败,请尝试修改参数配置。"
        },
        "flavorRef": {
          "type": "string",
          "example": "c1.2xlarge",
          "description": "规格ID或URL。"
        },
        "name": {
          "type": "string",
          "example": "test-server",
          "description": "弹性云服务器名称,长度大于0小于256字节。\n\n> 说明:\n> \n> 云服务器内部主机名(hostname)命名规则遵循 [RFC 952](https://tools.ietf.org/html/rfc952)和[RFC 1123](https://tools.ietf.org/html/rfc1123)命名规范,建议使用a-zA-z或0-9以及中划线\"-\"组成的名称命名,\"_\"将在弹性云服务器内部默认转化为\"-\"。",
          "minLength": 1,
          "maxLength": 255
        },
        "metadata": {
          "type": "object",
          "description": "用户自定义字段键值对。\n\n> - key的长度大于0小于256字节\n> - value的长度大于等于0小于256字节\n\n\n系统预留字段\n\n1. admin_pass:弹性云服务器密码\n \t\n    Windows弹性云服务器Administrator用户的密码。\n    > 说明:\n    > 创建密码方式鉴权的Windows弹性云服务器时为必选字段。",
          "additionalProperties": {
            "type": "string",
            "description": ""
          },
          "x-huawei-extraAnnotation": ""
        },
        "adminPass": {
          "type": "string",
          "example": "1qazXSW@",
          "description": "如果需要使用密码方式登录云服务器,可使用adminPass字段指定云服务器管理员帐户初始登录密码。其中,Linux管理员帐户为root,Windows管理员帐户为Administrator。"
        },
        "block_device_mapping_v2": {
          "type": "array",
          "description": "扩展属性,指定弹性云服务器存储设备的v2接口。是存储资源的新版本接口,指定卷场景不能批创弹性云服务器。\n\n裸金属服务器场景不支持。",
          "items": {
            "$ref": "#/definitions/NovaServerBlockDeviceMapping"
          }
        },
        "config_drive": {
          "type": "string",
          "description": "扩展属性,开启后在弹性云服务器创建时挂载config_drive向弹性云服务器内部传递信息。\n\n当前不支持该功能。",
          "x-huawei-extraAnnotation": "",
          "x-admin": "False",
          "x-internal": "False"
        },
        "security_groups": {
          "type": "array",
          "description": "扩展属性,指定弹性云服务器的安全组,默认为default。\n\n指定network创建弹性云服务器时该字段有效。对于已存在端口,安全组请求无效。",
          "items": {
            "$ref": "#/definitions/NovaServerSecurityGroup"
          }
        },
        "networks": {
          "type": "array",
          "description": "扩展属性,指定弹性云服务器的网卡信息。有多个租户网络时必须指定。 ",
          "items": {
            "$ref": "#/definitions/NovaServerNetwork"
          }
        },
        "key_name": {
          "type": "string",
