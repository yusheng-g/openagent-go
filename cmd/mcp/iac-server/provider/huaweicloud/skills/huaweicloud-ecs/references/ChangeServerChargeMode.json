  "definitions": {
    "ChangeServerChargeModeRequestBody": {
      "required": [
        "server_ids",
        "charge_mode"
      ],
      "properties": {
        "server_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "云服务器ID列表"
        },
        "charge_mode": {
          "type": "string",
          "example": "prePaid",
          "description": "更换后的计费模式:prePaid包周期计费模式"
        },
        "prepaid_options": {
          "description": "包周期选项",
          "$ref": "#/definitions/ChangeServerChargeModePrepaidOption"
        },
        "dry_run": {
          "type": "boolean",
          "example": false,
          "description": "是否预先校验此次请求。\ntrue: 发送检查请求,不触发真正的计费转换操作\nfalse: 发送正常请求,触发计费转换操作。\n默认值为false"
        }
      }
    },
    "ChangeServerChargeModePrepaidOption": {
      "required": [
        "period_type",
        "period_num"
      ],
      "properties": {
        "include_data_disks": {
          "type": "boolean",
          "example": false,
          "description": "是否连同支持的按需数据盘一起转为包周期。\n当参数为true,包括按需非共享的数据盘,不包括共享云硬盘,DSS和DESS硬盘\n默认值为false"
        },
        "include_publicips": {
          "type": "boolean",
          "example": false,
          "description": "是否连同弹性公网IP一起转为包周期\n只有“独享”、“按带宽计费”的弹性公网IP才可以转换为包周期计费模式\n默认值为false"
        },
        "period_type": {
          "type": "string",
          "example": "month",
          "description": "订购周期类型,取值范围:\nmonth-月\nyear-年"
        },
        "period_num": {
          "type": "string",
          "example": "1",
          "description": "订购周期的周期数。\n取值范围:\nperiod_type=month时,取值范围为[1,9]。\nperiod_type=year时,取值范围为[1,3]。"
        },
        "auto_pay": {
          "type": "boolean",
          "example": false,
          "description": "是否自动支付。\ntrue:自动支付,需要确保账户余额充足,如果余额不足则会生成异常订单,只能作废此订单\nfalse:只生成订单不扣费\n默认值为false"
        },
        "auto_renew": {
          "type": "boolean",
          "example": false,
          "description": "是否自动续费。默认值:false"
        }
      }
    },
    "changeServerChargeModeResult": {
      "required": [
        "order_id"
      ],
      "properties": {
        "order_id": {
          "type": "string",
          "example": "CS2209141549862WI",
          "description": "按需转包提交后返回的订单ID,用户可以使用该ID对订单结果进行查询。"
        }
      },
      "description": "按需转包响应返回体"
    }
  },
