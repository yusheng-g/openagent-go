{
  "name": "CreateImageCache",
  "summary": "创建镜像缓存",
  "tags": "镜像缓存管理",
  "productshort": "CCE",
  "region_id": "ae-ad-1",
  "paths": {
    "/v5/imagecaches": {
      "post": {
        "x-request-examples-url-1": "/v5/imagecaches",
        "x-request-examples-text-1": {
          "name": "test-imagecache1",
          "images": [
