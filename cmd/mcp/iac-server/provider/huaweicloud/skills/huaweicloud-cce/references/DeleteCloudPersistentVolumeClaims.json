  "paths": {
    "/api/v1/namespaces/{namespace}/cloudpersistentvolumeclaims/{name}": {
      "delete": {
        "tags": [
          "存储管理"
        ],
        "summary": "删除PVC(待废弃)",
        "description": "该API用于删除指定Namespace下的PVC(PersistentVolumeClaim)对象,并可以选择保留后端的云存储。该API待废弃,请使用Kubernetes PVC相关接口。\n>存储管理的URL格式为:https://{clusterid}.Endpoint/uri。其中{clusterid}为集群ID,uri为资源路径,也即API访问的路径。如果使用https://Endpoint/uri,则必须指定请求header中的X-Cluster-ID参数。",
        "operationId": "DeleteCloudPersistentVolumeClaims",
        "consumes": [],
        "produces": [],
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "需要删除的PersistentVolumClaim的名称。",
            "required": true,
            "type": "string",
            "x-order": 4
          },
          {
            "name": "namespace",
            "in": "path",
            "description": "指定PersistentVolumeClaim所在的命名空间。",
            "required": true,
            "type": "string",
            "x-order": 3
          },
          {
            "name": "deleteVolume",
            "type": "string",
            "in": "query",
            "description": "删除PersistentVolumeClaim后是否保留后端关联的云存储。false表示不删除,true表示删除,默认为false。"
          },
          {
            "name": "storageType",
            "in": "query",
            "type": "string",
            "description": "云存储的类型,和deleteVolume搭配使用。即deleteVolume和storageType必须同时配置。\n- bs:EVS云硬盘存储\n- nfs:SFS1.0弹性文件存储\n- obs:OBS对象存储\n- efs:SFS Turbo极速文件存储"
          },
          {
            "$ref": "#/parameters/param_header_content_type"
          },
          {
            "$ref": "#/parameters/param_header_x_auth_token"
          },
          {
            "$ref": "#/parameters/param_header_x_cluster_id"
          }
        ],
        "responses": {
          "200": {
            "description": "删除指定PersistentVolumeClaim作业下发成功。",
            "schema": {
              "$ref": "#/definitions/PersistentVolumeClaim"
            }
          }
        },
        "deprecated": false,
        "x-name": "删除PersistentVolumeClaim",
