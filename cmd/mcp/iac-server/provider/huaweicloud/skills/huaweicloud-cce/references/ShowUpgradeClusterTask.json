  "region_id": "ae-ad-1",
  "paths": {
    "/api/v3/projects/{project_id}/clusters/{cluster_id}/operation/upgrade/tasks/{task_id}": {
      "get": {
        "tags": [
          "集群升级"
        ],
        "operationId": "ShowUpgradeClusterTask",
        "summary": "获取集群升级任务详情",
        "description": "获取集群升级任务详情,任务ID由调用集群升级API后从响应体中uid字段获取。\n> - 集群升级涉及多维度的组件升级操作,强烈建议统一通过CCE控制台执行交互式升级,降低集群升级过程的业务意外受损风险;\n> - 当前集群升级相关接口受限开放。",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "$ref": "#/parameters/param_path_projectid"
          },
          {
            "$ref": "#/parameters/param_path_clusterid"
          },
          {
            "$ref": "#/parameters/param_path_taskid"
          }
        ],
        "responses": {
          "200": {
            "description": "表示获取集群升级任务详情成功。",
            "examples": {
              "application/json": {
                "kind": "UpgradeTask",
                "apiVersion": "v3",
                "metadata": {
                  "uid": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx",
                  "creationTimestamp": "2022-12-16 13:40:20.75671 +0800 CST",
                  "updateTimestamp": "2022-12-16 13:40:20.756712 +0800 CST"
                },
                "spec": {
                  "version": "v1.19.16-r4",
                  "targetVersion": "v1.23.5-r0"
                },
                "status": {
                  "phase": "Init",
                  "progress": "0.00",
                  "completionTime": "2022-12-16 13:40:20.756712 +0800 CST"
                }
              }
            },
            "schema": {
              "$ref": "#/definitions/UpgradeTaskResponseBody"
            }
          }
        },
        "x-constraint": "",
        "x-is-registered": "Y",
        "x-name": "获取集群升级任务详情",
        "x-order": 2,
        "x-publishpath": "",
        "x-scope": "Commercial",
        "x-support-sdk": "Y",
        "x-apiexplorer-hide": "false",
        "x-api-category": "cce",
        "x-open-region-cloud": "hws,hws_hk"
      }
    }
  },
  "definitions": {
    "UpgradeTaskStatus": {
      "description": "升级任务状态信息",
      "properties": {
        "phase": {
          "type": "string",
          "description": "升级任务状态.\n> Init:初始化\n> Queuing:等待\n> Running:运行中\n> Pause:暂停\n> Success:成功\n> Failed:失败"
        },
        "progress": {
          "type": "string",
          "description": "升级任务进度"
        },
        "completionTime": {
          "type": "string",
          "description": "升级任务结束时间"
        }
      }
    },
    "UpgradeTaskSpec": {
      "description": "升级任务属性",
      "properties": {
        "version": {
          "type": "string",
          "description": "升级前集群版本"
        },
        "targetVersion": {
          "type": "string",
          "description": "升级的目标集群版本"
        },
        "items": {
          "type": "object",
          "description": "升级任务附属信息"
        }
      }
    },
    "UpgradeTaskResponseBody": {
      "properties": {
        "apiVersion": {
          "type": "string",
          "description": "api版本,默认为v3"
        },
        "kind": {
          "type": "string",
          "description": "资源类型,默认为UpgradeTask"
        },
        "metadata": {
          "description": "升级任务元数据信息",
          "$ref": "#/definitions/UpgradeTaskMetadata"
        },
        "spec": {
          "description": "升级任务信息",
          "$ref": "#/definitions/UpgradeTaskSpec"
        },
        "status": {
          "description": "升级任务状态",
          "$ref": "#/definitions/UpgradeTaskStatus"
        }
      }
    },
    "UpgradeTaskMetadata": {
      "description": "升级任务元数据",
      "properties": {
        "uid": {
          "type": "string",
          "description": "升级任务ID"
        },
        "creationTimestamp": {
          "type": "string",
          "description": "任务创建时间"
        },
        "updateTimestamp": {
          "type": "string",
          "description": "任务更新时间"
        }
      }
    }
