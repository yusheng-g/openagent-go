{
  "name": "ShowClusterSupportConfiguration",
  "summary": "获取集群支持的可配置参数列表",
  "tags": "配置管理",
  "productshort": "CCE",
  "region_id": "ae-ad-1",
  "paths": {
    "/api/v3/clusters/configuration/detail": {
      "get": {
        "tags": [
          "配置管理"
        ],
        "summary": "获取集群支持的可配置参数列表",
        "description": "该API用于根据集群版本类型等查询集群支持的详细配置项,用于集群创建时指定。",
        "operationId": "ShowClusterSupportConfiguration",
        "parameters": [
          {
            "$ref": "#/parameters/param_header_content_type"
          },
          {
            "$ref": "#/parameters/param_header_x_auth_token"
          },
          {
            "name": "clusterType",
            "in": "query",
            "required": false,
            "description": "**参数解释**:\n该参数用于过滤集群架构\n**约束限制**:\n不涉及\n**取值范围**:\n- ARM64: 仅获取鲲鹏集群支持的配置项\n\n**默认取值**:\n不涉及",
            "type": "string"
          },
          {
            "name": "clusterVersion",
            "in": "query",
            "required": false,
            "description": "**参数解释**:\n该参数用于获取指定集群版本支持的配置项\n**约束限制**:\n不涉及\n**取值范围**:\n不涉及\n**默认取值**:\n不涉及",
            "type": "string"
          },
          {
            "name": "clusterID",
            "in": "query",
            "required": false,
            "description": "**参数解释**:\n该参数用于获取指定集群支持的配置项\n**约束限制**:\n不涉及\n**取值范围**:\n不涉及\n**默认取值**:\n不涉及",
            "type": "string"
          },
          {
            "name": "networkMode",
            "in": "query",
            "required": false,
            "description": "**参数解释**:\n该参数用于过滤掉集群网络模型相关配置项\n**约束限制**:\n不涉及\n**取值范围**:\n- eni: 过滤掉云原生网络2.0模型相关配置\n\n**默认取值**:\n不涉及",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "表示获取集群支持的可配置参数列表成功。",
            "schema": {
              "$ref": "#/definitions/ClusterConfigDetailRespBody"
            },
            "examples": {
              "application/json": {
                "eni": [
                  {
                    "name": "nic-minimum-target",
                    "default": 10,
                    "validAt": "immediately",
                    "empty": false,
                    "schema": "network",
                    "type": "str"
                  },
                  {
                    "name": "nic-warm-target",
                    "default": 2,
                    "validAt": "immediately",
                    "empty": false,
                    "schema": "network",
                    "type": "str"
                  }
                ],
                "kube-apiserver": [
                  {
                    "name": "default-not-ready-toleration-seconds",
                    "default": 300,
                    "validAt": "immediately",
                    "empty": true,
                    "schema": "kubernetes",
                    "type": "int"
                  }
                ]
              }
            }
          }
        },
        "x-constraint": "",
        "x-name": "获取集群支持的可配置参数列表",
        "x-order": 1,
        "x-publishpath": "ShowClusterSupportConfiguration",
        "x-scope": "Commercial",
        "x-support-sdk": "Y",
        "x-is-registered": "Y",
        "x-apiexplorer-hide": "false",
        "x-api-type": "open-api",
        "x-api-category": "cce"
      }
    }
  },
  "definitions": {
    "PackageOptions": {
      "description": "配置参数结构",
      "required": [
        "name",
        "type",
        "default",
        "validAt",
        "empty",
        "schema"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "**参数解释**:\n参数名称\n**取值范围**:\n不涉及"
        },
        "default": {
          "type": "object",
          "description": "**参数解释**:\n参数默认值,不指定时按默认值生效, 参数类型以实际返回为准,可能为integer,string或者boolean\n**取值范围**:\n不涉及"
        },
        "validAt": {
          "type": "string",
          "description": "**参数解释**:\n参数生效方式\n**取值范围**:\n- static:集群、节点池创建时生效,后续不可修改\n- immediately:集群、节点池运行中时可以修改,修改后生效",
          "enum": [
            "static",
            "immediately"
          ]
        },
        "empty": {
          "type": "boolean",
          "description": "**参数解释**:\n配置项是否可以为空\n**取值范围**:\n- true:配置项为空时,不使用默认值,为空值\n- false:配置项为空时,使用默认值"
        },
        "schema": {
          "type": "string",
          "description": "**参数解释**:\n参数分类\n**取值范围**:\n不涉及"
        },
        "type": {
          "type": "string",
          "description": "**参数解释**:\n参数类型\n**取值范围**:\n- str: 数据类型为字符串\n- int: 数据类型为整型\n- float: 数据类型为浮点型\n- bool: 数据类型为布尔型"
        }
      }
    },
    "ClusterConfigDetailRespBody": {
      "type": "object",
      "description": "**参数解释**:\n集群支持的配置项详情",
      "additionalProperties": {
        "type": "array",
        "description": "配置参数,由key/value组成。",
        "items": {
          "$ref": "#/definitions/PackageOptions"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {
