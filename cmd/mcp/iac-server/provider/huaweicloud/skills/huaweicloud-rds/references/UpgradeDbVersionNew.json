{
  "name": "UpgradeDbVersionNew",
  "summary": "升级内核小版本",
  "tags": "实例管理",
  "productshort": "RDS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v3/{project_id}/instances/{instance_id}/db-upgrade": {
      "post": {
        "tags": [
          "实例管理"
        ],
        "operationId": "UpgradeDbVersionNew",
        "summary": "升级内核小版本",
        "description": "对实例进行小版本升级。",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-constraint": "- 仅支持MySQL、PostgreSQL引擎。\n- RDS for PostgreSQL升级内核小版本时具有以下约束: 实例中存在异常节点,无法升级小版本。 不支持的小版本:\n- 对于 RDS for PostgreSQL 11版本,如果内核小版本小于11.2,则不支持小版本升级。\n- 只支持立即升级,不支持小版本延迟升级。",
        "parameters": [
          {
            "name": "x-auth-token",
            "in": "header",
            "description": "用户Token。",
            "type": "string",
            "x-example": "******",
            "required": true
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "语言",
            "type": "string",
            "x-example": "zh-cn",
            "enum": [
              "zh-cn",
              "en-us"
            ],
            "required": false
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "实例ID。",
            "required": true,
            "type": "string",
            "x-example": "e73893ef73754465a8bd2e0857bbf13ein01"
          },
          {
            "name": "UpgradeDbVersionNewRequestBody",
            "in": "body",
            "description": "请求体。",
            "required": false,
            "schema": {
              "$ref": "#/definitions/CustomerUpgradeDatabaseVersionReqNew"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/JobId"
            },
            "examples": {
              "application/json": {
                "job_id": "e7a7535b-eb9b-45ac-a83a-020dc5016d94"
              }
            }
          },
          "default": {
            "description": "Client or server error.",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "x-request-examples-description-1": "升级实例的小版本",
        "x-request-examples-url-1": "POST https://{Endpoint}/v3/0483b6b16e954cb88930a360d2c4e663/instances/cee5265e1e5845649e354841234567dfin01/db-upgrade",
        "x-request-examples-1": {
          "is_delayed": false,
          "second_switch": true
        }
      }
    }
  },
  "definitions": {
    "JobId": {
      "required": [
        "job_id"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "description": "任务ID。",
          "example": "6ad4eb1f-73bd-4876-aa31-aa9a1e41c4bc"
        }
      }
    },
    "ErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200022"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "实例名称已存在。"
        }
      }
    },
    "CustomerUpgradeDatabaseVersionReqNew": {
      "properties": {
        "is_delayed": {
          "type": "boolean",
          "description": "是否延迟至可维护时间段内升级。\n取值范围:\n- true:延迟升级。表示实例将在设置的可维护时间段内升级。\n- false:立即升级,默认该方式。"
        },
        "second_switch": {
          "type": "boolean",
          "description": "设置仅对RDS for MySQL数据库实例(主备)生效。主备实例升级过程中,备机升级成功后,会触发主备倒换继续升级主机,主机升级完成后,若主备可用区不同则触发第二次倒换,保证可用区不变。若主备可用区相同,该选项无效。\n取值范围:\n- true:默认该方式。表示升级过程中会进行二次倒换保证主备实例可用区不变。\n- false:升级过程中不进行第二次主备倒换,适合对主备所在可用区不敏感,对业务连续性敏感的客户。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
