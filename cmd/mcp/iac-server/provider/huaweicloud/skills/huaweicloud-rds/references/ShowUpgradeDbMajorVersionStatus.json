{
  "name": "ShowUpgradeDbMajorVersionStatus",
  "summary": "查询大版本检查状态或升级状态",
  "tags": "实例管理",
  "productshort": "RDS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v3/{project_id}/instances/{instance_id}/major-version/status": {
      "get": {
        "x-support-sdk": "Y",
        "x-constraint": "- 该接口仅支持PostgreSQL引擎。",
        "x-request-examples-url-1": "GET https://{endpoint}/v3/0483b6b16e954cb88930a360d2c4e663/instances/3aa441c4c98a4b36b100a7e3e87d17cein03/major-version/status?action=upgrade",
        "tags": [
          "实例管理"
        ],
        "description": "查询大版本检查状态或升级状态。",
        "operationId": "ShowUpgradeDbMajorVersionStatus",
        "summary": "查询大版本检查状态或升级状态",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "项目ID"
          },
          {
            "name": "instance_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "实例ID"
          },
          {
            "name": "action",
            "in": "query",
            "required": true,
            "description": "要查询的状态\ncheck:查询升级预检查的状态。\nupgrade:查询大板本升级的状态。",
            "type": "string"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "用户token",
            "type": "string"
          },
          {
            "name": "X-Language",
            "in": "header",
            "required": false,
            "description": "语言。默认en-us。",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/PostgresqlQueryUpgradeStatusResponse"
            },
            "examples": {
              "application/json": "{\n\t\"status\": \"success \",\n\"target_version\": \"14.4.1\",\n\"start_time\":\"2023-03-06T02:33:49+0800\",\n\"detail\": \" detail\": \"2023-03-06 18:33:26 --- pg_upgrade check task \t\t\t\t begin\\n2023-03-06 18:34:40 --- pg_upgrade check on master: \t\t\t [user_check_report]User check success \"\n}"
            }
          },
          "default": {
            "description": "Client or server error.",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "PostgresqlQueryUpgradeStatusResponse": {
      "type": "object",
      "required": [
        "status",
        "target_version",
        "start_time",
        "check_expiration_time",
        "detail"
      ],
      "properties": {
        "status": {
          "type": "string",
          "description": "实例大版本升级状态\n\" running\":预检查或大版本升级进行中\n\" success\":预检查或大版本升级成功\n\" failed\":预检查或大版本升级失败"
        },
        "target_version": {
          "type": "string",
          "description": "目标版本。"
        },
        "start_time": {
          "type": "string",
          "description": "开始时间,格式为“yyyy-mm-ddThh:mm:ssZ”。\n其中,T指某个时间的开始;Z指时区偏移量,例如偏移1个小时显示为+0100。"
        },
        "check_expiration_time": {
          "type": "string",
          "description": "检查成功时,检查报告到期时间,格式为“yyyy-mm-ddThh:mm:ssZ”。\n其中,T指某个时间的开始;Z指时区偏移量,例如偏移1个小时显示为+0100。\n该字段仅在action为check时返回。"
        },
        "detail": {
          "type": "string",
          "description": "预检查或升级报告信息。"
        }
      }
    },
    "ErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200022"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "实例名称已存在。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "rds.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "get",
  "uri": null
}