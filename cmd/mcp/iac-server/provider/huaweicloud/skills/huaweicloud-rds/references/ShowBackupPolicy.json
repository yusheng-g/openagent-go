        }
      }
    },
    "BackupPolicy": {
      "description": "备份策略信息。",
      "required": [
        "keep_days"
      ],
      "properties": {
        "keep_days": {
          "description": "指定已生成的备份文件可以保存的天数。\n\n取值范围:1~732。如果需要延长保留时间请联系客服人员申请,自动备份最长可以保留10年。",
          "type": "integer",
          "minimum": 0,
          "maximum": 2562
        },
        "start_time": {
          "description": "备份时间段。自动备份将在该时间段内触发。除关闭自动备份策略外,必选。\n\n取值范围:格式必须为hh:mm-HH:MM且有效,当前时间指UTC时间。\n\n- HH取值必须比hh大1。\n- mm和MM取值必须相同,且取值必须为00、15、30或45。",
          "type": "string",
          "example": "08:15-09:15"
        },
        "period": {
          "description": "备份周期配置。自动备份将在每星期指定的天进行。除关闭自动备份策略外,必选。\n\n取值范围:格式为逗号隔开的数字,数字代表星期。",
          "type": "string",
          "example": "1,2,3,4"
        }
      }
    },
    "GetBackupPolicyResponse": {
      "required": [
        "backup_policy"
      ],
      "properties": {
        "backup_policy": {
          "$ref": "#/definitions/BackupPolicy"
        }
      }
    }
