{
  "name": "BatchModifyPublication",
  "summary": "批量修改发布",
  "tags": "发布订阅(SQL Server)",
  "productshort": "RDS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v3/{project_id}/instances/{instance_id}/replication/publications": {
      "put": {
        "tags": [
          "发布订阅(SQL Server)"
        ],
        "operationId": "BatchModifyPublication",
        "summary": "批量修改发布",
        "description": "批量修改发布。只支持批量修改快照策略",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-file": "replicationSchedule",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "项目ID"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。",
            "type": "string",
            "required": true
          },
          {
            "name": "instance_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "实例ID"
          },
          {
            "name": "BatchModifyPublicationRequestBody",
            "description": "批量修改发布请求体。",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/BatchModifyPublicationsRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "success",
            "schema": {
              "$ref": "#/definitions/BatchModifyPublicationsResponseBody"
            },
            "examples": {
              "application/json": {
                "publications": [
                  {
                    "id": "a59096a6-143c-4478-bec6-92b6b516d138",
                    "result": "success"
                  }
                ]
              }
            }
          },
          "default": {
            "description": "error",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "x-request-examples-url-1": "PUT https://{endpoint}/v3/0483b6b16e954cb88930a360d2c4e663/instances/1aa833000a124455a6801e83cca37e6ein04/replication/publications",
        "x-request-examples-text-1": {
          "publication_ids": [
            "a59096a6-143c-4478-bec6-92b6b516d138"
          ],
          "job_schedule": {
            "id": "fdd139de-221d-4d18-909f-130e77b5b906"
          }
        }
      }
    }
  },
  "definitions": {
    "OperateUsedJobSchedule": {
      "description": "策略信息。",
      "properties": {
        "id": {
          "description": "策略id。",
          "type": "string",
          "example": "7be09cc4-c269-4f3a-9539-aaf2b40d79a0"
        },
        "job_schedule_type": {
          "description": "计划类型。默认值recurring。\n\nautomatically:SQL Server代理启动时自动启动。\ncpu_idle:CPU空闲时启动。\nrecurring:重复执行。\none_time:执行一次。",
          "type": "string"
        },
        "one_time_occurrence": {
          "description": "执行一次执行时间。",
          "$ref": "#/definitions/JobScheduleOneTimeOccurrenceInfo"
        },
        "frequency": {
          "description": "策略间隔周期(仅当策略id为空时必填)。",
          "$ref": "#/definitions/JobScheduleFrequencyInfo"
        },
        "daily_frequency": {
          "description": "策略每日频率(仅当策略id为空时必填)。",
          "$ref": "#/definitions/JobScheduleDailyFrequencyInfo"
        },
        "duration": {
          "description": "策略有效期(仅当策略id为空时必填)。",
          "$ref": "#/definitions/JobScheduleDurationInfo"
        }
      }
    },
    "ErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200022"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "实例名称已存在。"
        }
      }
    },
    "BatchOperateResponseInfo": {
      "properties": {
        "id": {
          "description": "订阅ID。",
          "type": "string",
          "example": "a59096a6-143c-4478-bec6-92b6b516d138"
        },
        "result": {
          "description": "执行结果。success,failure",
          "type": "string",
          "example": "failure"
        },
        "error_message": {
          "description": "失败报错。",
          "type": "string",
          "example": "参数错误。"
        }
      }
    },
    "JobScheduleOneTimeOccurrenceInfo": {
      "description": "执行一次执行时间。",
      "properties": {
        "active_start_date": {
          "description": "执行日期 yyyy-MM-dd。取值范围1990-01-01至2099-12-31",
          "type": "string",
          "example": "2023-01-01"
        },
        "active_start_time": {
          "description": "执行时间。HH:mm:ss",
          "type": "string",
          "example": "01:00:59"
        }
      }
    },
    "JobScheduleDurationInfo": {
      "description": "策略有效期。",
      "properties": {
        "active_start_date": {
          "description": "第一次执行日期 yyyy-MM-dd。取值范围1990-01-01至2099-12-31",
          "type": "string",
          "example": "2023-01-01"
        },
        "active_end_date": {
          "description": "最后一次执行日期。默认不会结束 yyyy-MM-dd",
          "type": "string",
          "example": "2099-12-31"
        }
      }
    },
    "JobScheduleDailyFrequencyInfo": {
      "description": "策略每日频率。",
      "properties": {
        "freq_subday_type": {
          "description": "每日频率类型 once:每日一次, multiple:每日多次。",
          "type": "string",
          "example": "once"
        },
        "active_start_time": {
          "description": "每日第一次执行时间。每日频率类型为每日一次时,则只执行这一次。 HH:mm:ss",
          "type": "string",
          "example": "01:00:59"
        },
        "active_end_time": {
          "description": "最后一次执行时间。每日执行多次时该参数必传,每日执行一次时不生效。 HH:mm:ss",
          "type": "string",
          "example": "23:59:59"
        },
        "freq_subday_interval": {
          "description": "执行间隔。每日执行多次时该参数必传,每日执行一次时不生效。取值范围1至99",
          "type": "integer",
          "example": "10"
        },
        "freq_interval_unit": {
          "description": "执行间隔的单位。每日执行多次时该参数必传,每日执行一次时不生效。 second:秒, minute:分, hour:时",
          "type": "string",
          "example": "minute"
        }
      }
    },
    "BatchModifyPublicationsRequestBody": {
      "description": "修改发布详情。",
      "required": [
        "publication_ids",
        "job_schedule"
      ],
      "properties": {
        "publication_ids": {
          "description": "修改的发布id列表。",
          "type": "array",
          "items": {
            "type": "string"
          },
          "example": [
            "7be09cc4-c269-4f3a-9539-aaf2b40d79a0"
          ]
        },
        "job_schedule": {
          "description": "快照策略。",
          "$ref": "#/definitions/OperateUsedJobSchedule"
        }
      },
      "type": "object"
    },
    "BatchModifyPublicationsResponseBody": {
      "description": "批量修改发布结果。",
      "properties": {
        "publications": {
          "description": "修改发布结果。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/BatchOperateResponseInfo"
          }
        }
      }
    },
    "JobScheduleFrequencyInfo": {
      "description": "策略间隔周期。",
      "properties": {
        "freq_type": {
          "description": "策略频率类型 daily:按天, weekly:按周, monthly_day:按月、每月按天, monthly_week:按月、每月按周。",
          "type": "string",
          "example": "daily"
        },
        "freq_interval": {
          "description": "执行间隔。取值范围1至99。",
          "type": "integer",
          "example": "5"
        },
        "freq_interval_weekly": {
          "description": "频率类型为按周时该参数必传,不为按周时不生效。\n每周执行哪几天。参数值:Monday,Tuesday ... Sunday",
          "type": "array",
          "items": {
            "type": "string",
            "example": "Monday"
          }
        },
        "freq_interval_day_monthly": {
          "description": "频率类型为按月、每月按天时该参数必传,不为按月、每月按天时时不生效。\n每月执行的日期。取值范围1-31。",
          "type": "integer",
          "example": "31"
        },
        "freq_interval_monthly": {
          "description": "频率类型为按月、每月按周时该参数必传,不为按月、每月按周时时不生效。\n每周执行哪几天。 Sunday, Monday,Tuesday ... Saturday, day, weekday, weekend",
          "type": "string",
          "example": "weekday"
        },
        "freq_relative_interval_monthly": {
          "description": "频率类型为按月、每月按周时该参数必传,不为按月、每月按周时时不生效。\n每月在哪周执行。 first, second, third, fourth, last",
          "type": "string",
          "example": "fourth"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "rds.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "put",
  "uri": null
}