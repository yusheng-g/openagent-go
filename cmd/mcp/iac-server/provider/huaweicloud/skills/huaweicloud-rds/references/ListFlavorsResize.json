  "definitions": {
    "ComputeFlavor": {
      "type": "object",
      "description": "查询数据库可变更规格接口,响应体中的计算规格详情",
      "required": [
        "id",
        "code",
        "vcpus",
        "ram",
        "az_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "规格ID,该字段唯一。"
        },
        "code": {
          "type": "string",
          "description": "资源规格编码。例如:rds.pg.m1.xlarge.rr。\n\n更多规格说明请参考数据库实例规格。\n\n“rds”代表RDS产品。\n“pg”代表数据库引擎。\n“m1.xlarge”代表性能规格,为高内存类型。\n“rr”表示只读实例(“.ha”表示主备实例)。"
        },
        "vcpus": {
          "type": "string",
          "description": "CPU大小。例如:1表示1U。"
        },
        "ram": {
          "type": "string",
          "description": "内存大小,单位为GB。"
        },
        "az_status": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "规格所在az的状态,包含以下状态:\n\nnormal:在售。\nunsupported:暂不支持该规格。\nsellout:售罄。"
        }
      }
    },
    "QueryFlavorsForResizeResponse": {
      "type": "object",
      "description": "查询数据库可变更规格响应体",
      "required": [
        "flavor_groups"
      ],
      "properties": {
        "flavor_groups": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ComputeFlavorGroup"
          },
          "description": "规格组列表\n\nnormal:通用增强型。\nnormal2:通用增强II型。\narmFlavors:鲲鹏通用增强型。\ndedicicateNormal(dedicatedNormalLocalssd):x86独享型。\narmLocalssd:鲲鹏通用型。\nnormalLocalssd:x86通用型。\ngeneral:通用型。\ndedicated\n对于PostgreSQL引擎:独享型"
        }
      }
    },
    "ComputeFlavorGroup": {
      "type": "object",
      "description": "查询数据库可变更规格接口中,规格组类型",
      "required": [
        "group_type",
        "compute_flavors"
      ],
      "properties": {
        "group_type": {
          "type": "string",
          "description": "性能规格,包含以下状态:\n\nnormal:通用增强型。\nnormal2:通用增强II型。\narmFlavors:鲲鹏通用增强型。\ndedicicateNormal(dedicatedNormalLocalssd):x86独享型。\narmLocalssd:鲲鹏通用型。\nnormalLocalssd:x86通用型。\ngeneral:通用型。\ndedicated\n对于PostgreSQL引擎:独享型"
        },
        "compute_flavors": {
          "type": "array",
          "description": "计算规格列表",
          "items": {
            "$ref": "#/definitions/ComputeFlavor"
          }
        }
      }
    },
    "ErrorRsp": {
      "description": "失败时返回的对象。",
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "minLength": 8,
          "maxLength": 36
        },
        "error_msg": {
          "description": "错误描述。",
          "type": "string",
          "minLength": 2,
          "maxLength": 512
        }
      }
    }
