          "example": "CURRENT"
        },
        "updated": {
          "type": "string",
          "description": "版本更新时间。\n格式为“yyyy-mm-dd Thh:mm:ssZ”。\n其中,T指某个时间的开始;Z指UTC时间。",
          "example": "2019-01-15T12:00:00Z"
