  "tags": "实例管理",
  "productshort": "RDS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v3/{project_id}/instances/{instance_id}/major-version/inspection-histories": {
      "get": {
        "x-support-sdk": "Y",
