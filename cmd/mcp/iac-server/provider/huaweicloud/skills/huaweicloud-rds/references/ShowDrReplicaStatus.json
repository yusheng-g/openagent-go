              "application/json": {
                "replica_state": "0",
                "wal_write_receive_delay_in_mb": "10.0",
                "wal_write_replay_delay_in_mb": "10.0",
                "wal_receive_replay_delay_in_ms": "0"
              }
            }
          },
          "default": {
            "description": "Client or server error.",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "x-request-examples-url-1": "GET https://rds.cn-north-1.myhuaweicloud.com/v3/0483b6b16e954cb88930a360d2c4e663/instances/dsfae23fsfdsae3435in03/disaster-recovery"
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200022"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "实例名称已存在。"
        }
      }
    },
    "DrReplicationStatus": {
      "properties": {
        "replica_state": {
          "type": "string",
          "description": "同步状态,取值范围是0或-1,0表示正常,-1表示异常。"
        },
        "wal_write_receive_delay_in_mb": {
          "type": "string",
          "description": "发送延迟大小(MB),即主实例当前wal日志写入位点与灾备实例当前接收wal日志位点的差值。"
        },
        "wal_write_replay_delay_in_mb": {
          "type": "string",
          "description": "端到端延迟大小(MB),即主实例当前wal日志写入位点与灾备实例当前回放wal日志位点的差值。"
        },
        "wal_receive_replay_delay_in_ms": {
          "type": "string",
          "description": "回放延迟时间(ms),即数据在灾备上回放的延迟时间。"
        }
      },
      "required": [
        "replica_state",
        "wal_write_receive_delay_in_mb",
        "wal_write_replay_delay_in_mb",
        "wal_receive_replay_delay_in_ms"
      ]
