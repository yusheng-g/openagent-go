  "definitions": {
    "ErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200022"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "实例名称已存在。"
        }
      }
    },
    "SqlserverDatabaseForDetail": {
      "description": "数据库信息。",
      "required": [
        "name",
        "character_set",
        "state"
      ],
      "properties": {
        "name": {
          "description": "数据库名称。",
          "type": "string"
        },
        "character_set": {
          "description": "数据库使用的字符集,例如Chinese_PRC_CI_AS等。",
          "type": "string"
        },
        "state": {
          "description": "数据库状态。取值如下:\n\nCreating:表示创建中。\nRunning:表示使用中。\nDeleting:表示删除中。\nNotExists:表示不存在。",
          "type": "string"
        }
      }
    },
    "ListRemoteDbRequestBody": {
      "description": "查询远程SQL Server数据库请求参数。",
      "required": [
        "server_ip",
        "server_port",
        "login_user_name",
        "login_user_password"
      ],
      "properties": {
        "server_ip": {
          "description": "服务器ip。",
          "type": "string",
          "example": "192.168.0.1"
        },
        "server_port": {
          "description": "端口号。",
          "type": "string",
          "example": "1433"
        },
        "login_user_name": {
          "description": "登录名。",
          "type": "string",
          "example": "rdsuser"
        },
        "login_user_password": {
          "description": "登录密码。要求密码长度在5~64位之间。",
          "type": "string",
          "example": "password"
        },
        "offset": {
          "description": "索引位置,偏移量。从第一条数据偏移offset条数据后开始查询,默认为0(偏移0条数据,表示从第一条数据开始查询),必须为数字,不能为负数。",
          "type": "integer",
          "example": 0
        },
        "limit": {
          "description": "查询记录数。默认为10,不能为负数,最小值为1,最大值为100。",
          "type": "integer",
          "example": 100
        }
      }
    },
    "ListSqlserverDatabaseResponseBody": {
      "required": [
        "databases",
        "total_count"
      ],
      "properties": {
        "databases": {
          "description": "数据库信息。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/SqlserverDatabaseForDetail"
          }
        },
        "total_count": {
          "description": "总数。",
          "type": "integer"
        }
      }
    }
