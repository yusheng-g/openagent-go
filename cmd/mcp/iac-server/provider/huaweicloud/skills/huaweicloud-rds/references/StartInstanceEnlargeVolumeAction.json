        "operationId": "StartInstanceEnlargeVolumeAction",
        "summary": "扩容数据库实例的磁盘空间",
        "description": "扩容数据库实例的磁盘空间。",
        "x-support-sdk": "Y",
        "x-constraint": "- 备实例大小和主实例大小一致,当主实例扩容时,会同时扩容备实例。\n- 实例状态为“服务中”时可以进行扩容。",
        "parameters": [
          {
            "name": "x-auth-token",
            "in": "header",
            "description": "用户Token。",
            "type": "string",
            "x-example": "******",
            "required": false
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "语言",
            "type": "string",
            "x-example": "zh-cn",
            "enum": [
              "zh-cn",
              "en-us"
            ],
            "required": false
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
