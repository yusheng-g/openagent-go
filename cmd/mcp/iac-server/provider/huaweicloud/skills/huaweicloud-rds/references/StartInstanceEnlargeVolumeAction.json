  "definitions": {
    "ErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200022"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "实例名称已存在。"
        }
      }
    },
    "EnlargeVolumeRequestBody": {
      "required": [
        "enlarge_volume"
      ],
      "properties": {
        "enlarge_volume": {
          "type": "object",
          "$ref": "#/definitions/EnlargeVolumeObject"
        }
      }
    },
    "EnlargeVolumeResponse": {
      "required": [
        "job_id"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "description": "扩容数据库磁盘空间的任务id。\n仅磁盘扩容按需实例时会返回该参数。",
          "example": "dff1d289-4d03-4942-8b9f-463ea07c000d"
        },
        "order_id": {
          "type": "string",
          "description": "订单号,磁盘扩容包年包月时返回该参数。"
        }
      }
    },
    "EnlargeVolumeObject": {
      "description": "扩容实例磁盘时必填。",
      "required": [
        "size"
      ],
      "properties": {
        "size": {
          "type": "integer",
          "description": "每次扩容最小容量为10GB,实例所选容量大小必须为10的整数倍,取值范围:40GB~4000GB。\n- MySQL部分用户支持11GB~10000GB,如果您想开通该功能,请联系客服。\n- PostgreSQL部分用户支持40GB~15000GB,如果您想开通该功能,请联系客服。",
          "example": 400
        },
        "is_auto_pay": {
          "type": "boolean",
          "description": "变更包周期实例的规格时可指定,表示是否自动从客户的账户中支付。\n- true,为自动支付。\n- false,为手动支付,默认该方式。",
          "example": "true"
        }
      }
    }
