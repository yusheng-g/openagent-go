{
  "name": "CreatePostgresqlDatabase",
  "summary": "创建数据库",
  "tags": "管理数据库和用户(PostgreSQL)",
  "productshort": "RDS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v3/{project_id}/instances/{instance_id}/database": {
      "post": {
        "tags": [
          "管理数据库和用户(PostgreSQL)"
        ],
        "operationId": "CreatePostgresqlDatabase",
        "summary": "创建数据库",
        "description": "在指定实例中创建数据库。",
        "x-support-sdk": "Y",
        "x-constraint": "- 实例在创建、变更规格、修改端口、冻结、异常等状态下不能执行该操作。\n- 如果通过V3接口之外的方式创建数据库,如自行登录节点或通过客户端工具创建数据库,数据库名称校验规则与V3接口不一致,调用V3接口执行数据库相关操作时可能会导致接口调用失败。",
        "parameters": [
          {
            "name": "x-auth-token",
            "in": "header",
            "description": "用户Token。",
            "type": "string",
            "x-example": "******",
            "required": false
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "语言",
            "type": "string",
            "x-example": "zh-cn",
            "required": false
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "实例ID。",
            "required": true,
            "type": "string",
            "x-example": "e73893ef73754465a8bd2e0857bbf13ein01"
          },
          {
            "name": "CreateDatabaseRequest",
            "in": "body",
            "description": "请求体。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/PostgresqlDatabaseForCreation"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/DBMSuccessRsp"
            },
            "examples": {
              "application/json": {
                "resp": "successful"
              }
            }
          },
          "default": {
            "description": "Client or server error.",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "x-request-examples-url-1": "POST https://rds.cn-north-1.myhuaweicloud.com/v3/054e292c9880d4992f02c0196d3ea468/instances/3d39c18788b54a919bab633874c159dfin01/database",
        "x-request-examples-1": {
          "name": "rds_test",
          "owner": "test",
          "template": "template0",
          "character_set": "UTF8",
          "lc_collate": "en_US.UTF-8",
          "lc_ctype": "en_US.UTF-8",
          "is_revoke_public_privilege": true,
          "comment": "comment"
        }
      }
    }
  },
  "definitions": {
    "DBMSuccessRsp": {
      "required": [
        "resp"
      ],
      "properties": {
        "resp": {
          "description": "操作结果。",
          "type": "string",
          "example": "successful"
        }
      }
    },
    "ErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200022"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "实例名称已存在。"
        }
      }
    },
    "PostgresqlDatabaseForCreation": {
      "description": "数据库信息。",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "description": "数据库名称。\n\n数据库名称长度可在1~63个字符之间,由字母、数字、或下划线组成,不能包含其他特殊字符,不能以“pg”和数字开头,且不能和RDS for PostgreSQL模板库重名。\n\nRDS for PostgreSQL模板库包括postgres, template0 ,template1。",
          "type": "string"
        },
        "character_set": {
          "description": "数据库字符集。默认UTF8。",
          "type": "string"
        },
        "owner": {
          "description": "数据库所属用户,缺省时默认是root,不能和系统用户重名,且必须是已存在的用户。\n\n系统用户包括“rdsAdmin”,“ rdsMetric”, “rdsBackup”, “rdsRepl”,“ rdsProxy”, “rdsDdm”。",
          "type": "string"
        },
        "template": {
          "description": "数据库模板名称,可选值template0,template1。默认template1。",
          "type": "string"
        },
        "lc_collate": {
          "description": "数据库排序集。默认en_US.UTF-8。\n\n- 须知:\n不同的排序规则下,相同字符串的比较其结果可能是不同的。\n例如,在en_US.utf8下, select 'a'>'A';执行结果为false,但在'C'下,select 'a'>'A';结果为true。如果数据库从“O”迁移到PostgreSQL,数据库排序集需使用'C'才能得到一致的预期。支持的排序规则可以查询系统表 pg_collation。",
          "type": "string"
        },
        "lc_ctype": {
          "description": "数据库分类集。默认en_US.UTF-8。",
          "type": "string"
        },
        "is_revoke_public_privilege": {
          "description": "是否回收public schema的PUBLIC CREATE权限。\ntrue,表示回收该权限。\nfalse,表示不回收该权限。\n缺省时默认是false。",
          "type": "boolean"
        },
        "comment": {
          "description": "数据库备注。\n取值范围:长度1~512个字符。",
          "type": "string"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "rds.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "post",
  "uri": null
}