  "definitions": {
    "ErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200022"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "实例名称已存在。"
        }
      }
    },
    "RestoreTableInfo": {
      "required": [
        "oldName",
        "newName"
      ],
      "properties": {
        "oldName": {
          "description": "旧表名",
          "type": "string"
        },
        "newName": {
          "description": "新表名",
          "type": "string"
        }
      }
    },
    "RestoreTablesRequestBody": {
      "required": [
        "restoreTime",
        "restoreTables"
      ],
      "properties": {
        "restoreTime": {
          "description": "恢复时间戳",
          "type": "integer",
          "format": "int64"
        },
        "restoreTables": {
          "description": "表信息",
          "type": "array",
          "items": {
            "$ref": "#/definitions/RestoreDatabasesInfo"
          }
        },
        "is_fast_restore": {
          "description": "是否使用极速恢复,可先根据”获取实例是否能使用极速恢复“接口判断本次恢复是否能使用极速恢复。\n如果实例使用了XA事务,采用极速恢复的方式会导致恢复失败!",
          "type": "boolean"
        }
      }
    },
    "OldJobId": {
      "required": [
        "jobId"
      ],
      "properties": {
        "jobId": {
          "type": "string",
          "description": "任务ID。",
          "example": "6ad4eb1f-73bd-4876-aa31-aa9a1e41c4bc"
        }
      }
    },
    "RestoreDatabasesInfo": {
      "required": [
        "database",
        "tables"
      ],
      "properties": {
        "database": {
          "description": "库名",
          "type": "string"
        },
        "tables": {
          "description": "表信息",
          "type": "array",
          "items": {
            "$ref": "#/definitions/RestoreTableInfo"
          }
        }
      }
    }
