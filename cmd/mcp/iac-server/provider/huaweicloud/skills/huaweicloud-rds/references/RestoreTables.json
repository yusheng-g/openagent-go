            }
          }
        },
        "x-request-examples-description-1": "MySQL实例",
        "x-request-examples-url-1": "POST https://rds.cn-north-1.myhuaweicloud.com/v3/054e292c9880d4992f02c0196d3ea468/instances/d8e6ca5a624745bcb546a227aa3ae1cfin01/restore/tables",
        "x-request-examples-1": {
