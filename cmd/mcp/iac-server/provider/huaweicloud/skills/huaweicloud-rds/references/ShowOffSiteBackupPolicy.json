  "definitions": {
    "GetOffSiteBackupPolicy": {
      "description": "备份策略对象,包括备份类型、备份保留天数、目标区域ID和目标project ID。",
      "properties": {
        "backup_type": {
          "description": "指定备份的类型。取值如下:\n\n- auto:自动全量备份。\n- incremental:自动增量备份。\n- manual:手动备份,仅SQL Server返回该备份类型 。",
          "type": "string"
        },
        "keep_days": {
          "description": "备份文件可以保存的天数。",
          "type": "integer"
        },
        "destination_region": {
          "type": "string",
          "description": "设置跨区域备份策略的目标区域ID。"
        },
        "destination_project_id": {
          "type": "string",
          "description": "设置跨区域备份策略的目标project ID。"
        }
      }
    },
