        },
        "database": {
          "type": "string",
          "description": "所属数据库。"
        },
        "users": {
          "type": "string",
          "description": "帐号。"
        },
        "query_sample": {
          "type": "string",
          "description": "执行语法。"
        },
        "client_ip": {
          "type": "string",
          "description": "IP地址。"
        },
        "type": {
          "type": "string",
          "description": "语句类型。"
        }
      }
    },
    "SlowLogStatisticsForLtsRequest": {
      "type": "object",
      "description": "查询实例的慢日志对象",
      "required": [
        "start_time",
        "end_time"
      ],
      "properties": {
        "start_time": {
          "description": "开始日期,格式为“yyyy-mm-ddThh:mm:ssZ”。\n其中,T指某个时间的开始;Z指时区偏移量,例如北京时间偏移显示为+0800。",
          "type": "string"
        },
        "end_time": {
          "description": "结束时间,格式为“yyyy-mm-ddThh:mm:ssZ”。\n其中,T指某个时间的开始;Z指时区偏移量,例如北京时间偏移显示为+0800。只能查询当前时间前一个月内的慢日志。",
          "type": "string"
        },
        "offset": {
          "description": "索引位置,偏移量。默认为0,表示从第一条数据开始查询。",
          "type": "integer"
        },
        "limit": {
          "description": "每页多少条记录(查询结果),取值范围是1~100,不填时默认为10。",
          "type": "integer"
        },
        "type": {
          "description": "语句类型,取空值,表示查询所有语句类型。",
          "type": "string",
          "enum": [
            "INSERT",
            "UPDATE",
            "SELECT",
            "DELETE",
            "CREATE",
            "ALL"
          ]
        },
        "database": {
          "description": "数据库名称。",
          "type": "string"
        },
        "sort": {
          "description": "指定排序字段。\"executeTime\",表示按照执行时间降序排序。字段为空或传入其他值,表示按照执行次数降序排序。",
          "type": "string"
        },
        "order": {
          "description": "排序顺序。默认desc。",
          "type": "string",
          "enum": [
            "desc",
            "asc"
          ]
        }
      }
    }
  },
