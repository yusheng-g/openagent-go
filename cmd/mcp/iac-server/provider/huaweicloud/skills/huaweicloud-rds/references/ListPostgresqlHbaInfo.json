        },
        "mask": {
          "type": "string",
          "description": "掩码,默认为空字符串"
        },
        "method": {
          "type": "string",
          "description": "认证方式。枚举:reject、md5、scram-sha-256"
        },
        "priority": {
          "type": "integer",
          "format": "int32",
          "description": "优先级,表示配置的先后"
        }
      }
    }
