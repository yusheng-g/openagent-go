    "PostgresqlHbaConf": {
      "type": "object",
      "required": [
        "type",
        "database",
        "user",
        "address",
        "method",
        "priority"
      ],
      "properties": {
        "type": {
          "type": "string",
          "description": "连接类型,枚举,host、hostssl、hostnossl"
        },
        "database": {
          "type": "string",
          "description": "数据库名,除template0,template1的数据库名,多个以逗号隔开"
        },
        "user": {
          "type": "string",
          "description": "用户名,all,除内置用户(rdsAdmin, rdsMetric, rdsBackup, rdsRepl, rdsProxy)以外,多个以逗号隔开"
        },
        "address": {
          "type": "string",
