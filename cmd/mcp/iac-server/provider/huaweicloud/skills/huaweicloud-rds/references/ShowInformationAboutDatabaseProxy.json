{
  "name": "ShowInformationAboutDatabaseProxy",
  "summary": "查询数据库代理信息",
  "tags": "数据库代理(PostgreSQL)",
  "productshort": "RDS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v3/{project_id}/instances/{instance_id}/proxy": {
      "get": {
        "tags": [
          "数据库代理(PostgreSQL)"
        ],
        "operationId": "ShowInformationAboutDatabaseProxy",
        "summary": "查询数据库代理信息",
        "description": "查询指定实例的数据库代理详细信息。",
        "x-support-sdk": "Y",
        "x-constraint": "- 该接口仅支持PostgreSQL 11、PostgreSQL 12查询数据库代理详情。\n- 数据库实例必须已开启数据库代理 。",
        "parameters": [
          {
            "name": "x-auth-token",
            "in": "header",
            "description": "用户Token。",
            "type": "string",
            "x-example": "******",
            "required": false
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "语言",
            "type": "string",
            "x-example": "zh-cn",
            "enum": [
              "zh-cn",
              "en-us"
            ],
            "required": false
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "实例ID。",
            "required": true,
            "type": "string",
            "x-example": "e73893ef73754465a8bd2e0857bbf13ein01"
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/QueryProxyInformationResponse"
            },
            "examples": {
              "application/json": {
                "proxy": {
                  "pool_id": "c6ee492784b640e694f1da0201cd82c8po03",
                  "status": "open",
                  "address": "192.168.0.60",
