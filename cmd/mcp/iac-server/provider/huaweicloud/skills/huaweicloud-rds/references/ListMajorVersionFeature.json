          "items": {
            "type": "string"
          }
        },
        "support_file_stream": {
          "type": "boolean",
          "description": "是否支持FileStream特性。"
        },
        "support_tde": {
          "type": "boolean",
          "description": "是否支持透明数据加密。"
        },
        "support_always_on": {
          "type": "boolean",
          "description": "是否支持Always On。"
        },
        "support_read_only": {
          "type": "boolean",
          "description": "是否支持只读。"
        }
      }
    }
  },
