    "/v3/{project_id}/instances/{instance_id}/replication/subscriptions": {
      "post": {
        "tags": [
          "发布订阅(SQL Server)"
        ],
        "operationId": "CreateSubscription",
        "summary": "创建订阅",
        "description": "创建订阅",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-file": 20250222,
        "produces": [
          "application/json"
