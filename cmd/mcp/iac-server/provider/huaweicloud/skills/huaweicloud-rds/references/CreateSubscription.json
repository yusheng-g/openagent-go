            "description": "语言。默认en-us。",
            "type": "string"
          },
          {
            "name": "instance_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "实例ID"
          },
          {
            "name": "CreateSubscriptionRequestBody",
            "description": "创建订阅请求体。",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreateSubscriptionRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "success",
