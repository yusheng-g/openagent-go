{
  "name": "ListUpgradeHistories",
  "summary": "查询实例大版本升级历史信息",
  "tags": "实例管理",
  "productshort": "RDS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v3/{project_id}/instances/{instance_id}/major-version/upgrade-histories": {
      "get": {
        "x-support-sdk": "Y",
        "x-constraint": "- 该接口仅支持PostgreSQL引擎。 - 实例在创建、变更规格、修改端口、冻结、异常等状态下不能执行该操作。",
        "x-request-examples-url-1": "GET https://{endpoint}/v3/0483b6b16e954cb88930a360d2c4e663/instances/3aa441c4c98a4b36b100a7e3e87d17cein03/major-version/upgrade-histories?offset=0&limit=10",
        "tags": [
          "实例管理"
        ],
        "description": "查询实例大版本升级历史信息。",
        "operationId": "ListUpgradeHistories",
        "summary": "查询实例大版本升级历史信息",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "项目ID"
          },
          {
            "name": "instance_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "实例ID"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "索引位置,偏移量。从第一条数据偏移offset条数据后开始查询,默认为0(偏移0条数据,表示从第一条数据开始查询),必须为数字,不能为负数。",
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "查询记录数。默认为10,不能为负数,最小值为1,最大值为100。",
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "description": "排序方式。\nDESC,降序。\nASC,升序。\n默认降序。",
            "type": "string"
          },
          {
            "name": "sort_field",
            "in": "query",
            "required": false,
            "description": "排序字段。\nstart_time 开始时间。\nend_time 结束时间。\n默认开始时间。",
            "type": "string"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "required": true,
            "description": "用户token",
            "type": "string"
          },
          {
            "name": "X-Language",
            "in": "header",
            "required": false,
            "description": "语言。默认en-us。",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/PostgresqlQueryUpgradeHistoryResponse"
            },
            "examples": {
              "application/json": "{\n\t\"total_count\": 1,\n\t\" upgrade_reports\": [\n\t\t{\n\t\t\t\"id\": \"1a8fda5a-17a6-ebc4-bf1f-97ae837f432b\",\n\t\t\t\"start_time\": \"2023-03-06T02:45:49+0800\",\n\t\t\t\"end_time\": \"2023-03-06T02:50:49+0800\",\n\t\t\t\"src_instance_id\": \"dccacebb7b884ee18bc5c02c918ef2b0in03\",\n\t\t\t\"src_database_version\": \"13.9\",\n\t\t\t\"dst_instance_id\": \"6b5750504be1403191c4f00e4ffaee5ein03\",\n\t\t\t\"dst_database_version\": \"14.6\",\n\t\t\t\"result\": \"success\",\n\t\t\t\"is_private_ip_changed\": true,\n\t\t\t\"private_ip_change_time\": \"2023-03-06T03:10:49+0800\",\n\t\t\t\"statistics_collection_mode\": \"before_change_private_ip\",\n\t\t\t\"detail\": \"2023-03-06 18:33:26 --- pg_upgrade upgrade task \t\t \t begin\"\n\t\t}\n\t]\n}"
            }
          },
          "default": {
            "description": "Client or server error.",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200022"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "实例名称已存在。"
        }
      }
    },
    "PostgresqlQueryUpgradeHistoryResponse": {
      "type": "object",
      "required": [
        "total_count",
        "upgrade_reports"
      ],
      "properties": {
        "total_count": {
          "type": "integer",
          "format": "int32",
          "description": "总记录数。"
        },
        "upgrade_reports": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/upgradeReports"
          },
          "description": "升级报告信息。"
        }
      }
    },
    "upgradeReports": {
      "type": "object",
      "required": [
        "id",
        "start_time",
        "end_time",
        "src_instance_id",
        "src_database_version",
        "dst_instance_id",
        "dst_database_version",
        "result",
        "is_private_ip_changed",
        "private_ip_change_time",
        "statistics_collection_mode",
        "detail"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "升级报告ID。"
        },
        "start_time": {
          "type": "string",
          "description": "升级开始时间,格式为“yyyy-mm-ddThh:mm:ssZ”。\n其中,T指某个时间的开始;Z指时区偏移量,例如偏移1个小时显示为+0100。"
        },
        "end_time": {
          "type": "string",
          "description": "升级结束时间,格式为“yyyy-mm-ddThh:mm:ssZ”。\n其中,T指某个时间的开始;Z指时区偏移量,例如偏移1个小时显示为+0100。"
        },
        "src_instance_id": {
          "type": "string",
          "description": "原实例ID。"
        },
        "src_database_version": {
          "type": "string",
          "description": "原数据库版本。"
        },
        "dst_instance_id": {
          "type": "string",
          "description": "目标实例ID。"
        },
        "dst_database_version": {
          "type": "string",
          "description": "目标数据库版本。"
        },
        "result": {
          "type": "string",
          "description": "升级结果。\nsuccess,表示成功。\nfailed,表示失败。\nrunning, 表示升级中。"
        },
        "is_private_ip_changed": {
          "type": "boolean",
          "description": "实例内网IP是否改变。\ntrue,表示改变。\nfalse,表示不改变。"
        },
        "private_ip_change_time": {
          "type": "string",
          "description": "实例内网IP修改时间,格式为“yyyy-mm-ddThh:mm:ssZ”。\n其中,T指某个时间的开始;Z指时区偏移量,例如偏移1个小时显示为+0100。"
        },
        "statistics_collection_mode": {
          "type": "string",
          "description": "统计信息收集模式。\nbefore_change_private_ip,修改实例内网IP前收集。\nafter_change_private_ip,修改实例内网IP后收集。"
        },
        "detail": {
          "type": "string",
          "description": "升级报告详情。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "rds.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "get",
  "uri": null
}