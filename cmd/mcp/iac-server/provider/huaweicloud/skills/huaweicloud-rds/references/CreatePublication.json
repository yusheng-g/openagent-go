{
  "name": "CreatePublication",
  "summary": "创建发布",
  "tags": "发布订阅(SQL Server)",
  "productshort": "RDS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v3/{project_id}/instances/{instance_id}/replication/publications": {
      "post": {
        "tags": [
          "发布订阅(SQL Server)"
        ],
        "operationId": "CreatePublication",
        "summary": "创建发布",
        "description": "创建发布",
        "x-is-registered": "Y",
        "x-support-sdk": "Y",
        "x-file": "replicationOption",
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "项目ID"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。",
            "type": "string",
            "required": true
          },
          {
            "name": "instance_id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "实例ID"
          },
          {
            "name": "CreatePublicationRequestBody",
            "description": "创建发布请求体。",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CreatePublicationsRequestBody"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "success",
            "schema": {
              "$ref": "#/definitions/ReplicationJobResponse"
            },
            "examples": {
              "application/json": {
                "job_id": "7be09cc4-c269-4f3a-9539-aaf2b40d79a0"
              }
            }
          },
          "default": {
            "description": "error",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "x-request-examples-url-1": "POST https://{endpoint}/v3/0483b6b16e954cb88930a360d2c4e663/instances/1aa833000a124455a6801e83cca37e6ein04/replication/publications",
        "x-request-examples-text-1": {
          "publication_name": "pub_dbtest0103a",
          "publication_database": "test_db",
          "is_create_snapshot_immediately": true,
          "job_schedule": {
            "id": "fdd139de-221d-4d18-909f-130e77b5b906"
          },
          "tables": [
            {
              "table_name": "test0103a",
              "schema": "dbo",
              "article_properties": {
                "destination_object_name": "test0103b",
                "destination_object_owner": "dbo",
                "insert_delivery_format": "call_procedure",
                "insert_stored_procedure": "procdure_when_insert",
                "update_delivery_format": "update",
                "delete_delivery_format": "do_not_delete"
              }
            }
          ]
        }
      }
    }
  },
  "definitions": {
    "SubscriptionOption": {
      "description": "订阅选项。",
      "properties": {
        "independent_agent": {
          "description": "独立的分发代理。\n\ntrue:使用。\nfalse:不使用。",
          "type": "boolean",
          "default": true
        },
        "snapshot_always_available": {
          "description": "快照始终可用。需要“独立的分发代理”。\n\ntrue:可用。\nfalse:不可用。",
          "type": "boolean",
          "default": true
        },
        "replicate_ddl": {
          "description": "复制架构更改。\n\ntrue:可更改。\nfalse:不可更改。",
          "type": "boolean",
          "default": true
        },
        "allow_initialize_from_backup": {
          "description": "允许使用备份文件初始化。\n\ntrue:允许。\nfalse:不允许。",
          "type": "boolean",
          "default": false
        }
      }
    },
    "ErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200022"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "实例名称已存在。"
        }
      }
    },
    "JobScheduleOneTimeOccurrenceInfo": {
      "description": "执行一次执行时间。",
      "properties": {
        "active_start_date": {
          "description": "执行日期 yyyy-MM-dd。取值范围1990-01-01至2099-12-31",
          "type": "string",
          "example": "2023-01-01"
        },
        "active_start_time": {
          "description": "执行时间。HH:mm:ss",
          "type": "string",
          "example": "01:00:59"
        }
      }
    },
    "JobScheduleDurationInfo": {
      "description": "策略有效期。",
      "properties": {
        "active_start_date": {
          "description": "第一次执行日期 yyyy-MM-dd。取值范围1990-01-01至2099-12-31",
          "type": "string",
          "example": "2023-01-01"
        },
        "active_end_date": {
          "description": "最后一次执行日期。默认不会结束 yyyy-MM-dd",
          "type": "string",
          "example": "2099-12-31"
        }
      }
    },
    "ReplicationJobResponse": {
      "type": "object",
      "properties": {
        "job_id": {
          "type": "string",
          "description": "任务id。",
          "example": "7be09cc4-c269-4f3a-9539-aaf2b40d79a0"
        }
      },
      "required": [
        "job_id"
      ]
    },
    "PublicationTableInfoRequest": {
      "description": "发布表详情。",
      "required": [
        "table_name"
      ],
      "properties": {
        "table_name": {
          "description": "表名。\n\n表名长度可在1~64个字符之间,由字母、数字或下划线组成,不能包含其他特殊字符",
          "type": "string",
          "example": "TABLE_TEST_1"
        },
        "schema": {
          "description": "命名空间。默认值dbo。",
          "type": "string",
          "example": "dbo"
        },
        "columns": {
          "description": "发布的字段(不传或为空说明选择所有字段)。\n\n字段名称长度可在1~64个字符之间,由字母、数字或下划线组成,不能包含其他特殊字符",
          "type": "array",
          "items": {
            "type": "string",
            "example": [
              "ID",
              "NAME"
            ]
          }
        },
        "primary_key": {
          "description": "主键。",
          "type": "array",
          "items": {
            "type": "string",
            "example": [
              "ID"
            ]
          }
        },
        "filter_statement": {
          "description": "筛选语句。不能包含英文单引号'。",
          "type": "string",
          "example": "WHERE [ID] > 1"
        },
        "filter": {
          "description": "筛选器(仅当筛选语句为空时生效,筛选语句和筛选器都为空时说明没有筛选条件)。",
          "$ref": "#/definitions/PublicationTableFilterInfoRequest"
        },
        "article_properties": {
          "description": "项目属性。",
          "$ref": "#/definitions/ArticlePropertiesRequest"
        }
      },
      "type": "object"
    },
    "CreatePublicationsRequestBody": {
      "description": "创建发布详情。",
      "required": [
        "publication_name",
        "publication_database",
        "is_create_snapshot_immediately",
        "job_schedule",
        "tables"
      ],
      "properties": {
        "publication_name": {
          "description": "发布名称。\n\n发布名称长度可在5~64个字符之间,由字母、数字或下划线组成,不能包含其他特殊字符。",
          "type": "string",
          "example": "publication_name"
        },
        "publication_database": {
          "description": "发布数据库名。",
          "type": "string",
          "example": "DATABASE_NAME"
        },
        "is_create_snapshot_immediately": {
          "description": "是否立即创建快照。",
          "type": "boolean",
          "example": true
        },
        "subscription_options": {
          "description": "订阅选项。",
          "$ref": "#/definitions/SubscriptionOption"
        },
        "job_schedule": {
          "description": "策略详情。",
          "$ref": "#/definitions/OperateUsedJobScheduleCreate"
        },
        "is_select_all_table": {
          "description": "是否选择所有数据表。",
          "type": "boolean",
          "example": true
        },
        "extend_tables": {
          "description": "全选所有表后需要去除的表。",
          "type": "array",
          "items": {
            "type": "string",
            "example": [
              "table1",
              "table2"
            ]
          }
        },
        "tables": {
          "description": "发布数据表。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/PublicationTableInfoRequest"
          }
        }
      },
      "type": "object"
    },
    "ArticlePropertiesRequest": {
      "description": "项目属性。",
      "properties": {
        "destination_object_name": {
          "description": "目标对象名称。",
          "type": "string",
          "example": "DESTINATION_TABLE_TEST_1"
        },
        "destination_object_owner": {
          "description": "目标对象命名空间。",
          "type": "string",
          "example": "dbo"
        },
        "insert_delivery_format": {
          "description": "插入交付格式。",
          "type": "string",
          "enum": [
            "do_not_insert",
            "insert",
            "insert_without_column_list",
            "call_procedure"
          ]
        },
        "insert_stored_procedure": {
          "description": "插入存储过程。插入交付格式填call_procedure时该项必填。",
          "type": "string"
        },
        "update_delivery_format": {
          "description": "更新交付格式。",
          "type": "string",
          "enum": [
            "do_not_update",
            "update",
            "call_procedure",
            "mcall_procedure",
            "xcall_procedure",
            "scall_procedure"
          ]
        },
        "update_stored_procedure": {
          "description": "更新存储过程。更新交付格式填(m/x/s)call_procedure时该项必填。",
          "type": "string"
        },
        "delete_delivery_format": {
          "description": "删除交付格式。",
          "type": "string",
          "enum": [
            "do_not_delete",
            "delete",
            "call_procedure",
            "xcall_procedure"
          ]
        },
        "delete_stored_procedure": {
          "description": "删除存储过程。删除交付格式填(x)call_procedure时该项必填。",
          "type": "string"
        }
      },
      "type": "object"
    },
    "JobScheduleDailyFrequencyInfo": {
      "description": "策略每日频率。",
      "properties": {
        "freq_subday_type": {
          "description": "每日频率类型 once:每日一次, multiple:每日多次。",
          "type": "string",
          "example": "once"
        },
        "active_start_time": {
          "description": "每日第一次执行时间。每日频率类型为每日一次时,则只执行这一次。 HH:mm:ss",
          "type": "string",
          "example": "01:00:59"
        },
        "active_end_time": {
          "description": "最后一次执行时间。每日执行多次时该参数必传,每日执行一次时不生效。 HH:mm:ss",
          "type": "string",
          "example": "23:59:59"
        },
        "freq_subday_interval": {
          "description": "执行间隔。每日执行多次时该参数必传,每日执行一次时不生效。取值范围1至99",
          "type": "integer",
          "example": "10"
        },
        "freq_interval_unit": {
          "description": "执行间隔的单位。每日执行多次时该参数必传,每日执行一次时不生效。 second:秒, minute:分, hour:时",
          "type": "string",
          "example": "minute"
        }
      }
    },
    "OperateUsedJobScheduleCreate": {
      "description": "策略信息。",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "description": "策略id。",
          "type": "string",
          "example": "7be09cc4-c269-4f3a-9539-aaf2b40d79a0"
        },
        "job_schedule_type": {
          "description": "计划类型。默认值recurring。\n\nautomatically:SQL Server代理启动时自动启动。\ncpu_idle:CPU空闲时启动。\nrecurring:重复执行。\none_time:执行一次。",
          "type": "string"
        },
        "one_time_occurrence": {
          "description": "执行一次执行时间。",
          "$ref": "#/definitions/JobScheduleOneTimeOccurrenceInfo"
        },
        "frequency": {
          "description": "策略间隔周期(仅当策略id为空时必填)。",
          "$ref": "#/definitions/JobScheduleFrequencyInfo"
        },
        "daily_frequency": {
          "description": "策略每日频率(仅当策略id为空时必填)。",
          "$ref": "#/definitions/JobScheduleDailyFrequencyInfo"
        },
        "duration": {
          "description": "策略有效期(仅当策略id为空时必填)。",
          "$ref": "#/definitions/JobScheduleDurationInfo"
        }
      }
    },
    "PublicationTableFilterInfoRequest": {
      "description": "表筛选器。",
      "properties": {
        "relation": {
          "description": "筛选关系。 \n为空时表示当前为最下级筛选器,不为空时表示当前项还有下级筛选器\n不为空时取值范围:AND, OR",
          "type": "string",
          "example": "and"
        },
        "column": {
          "description": "筛选字段(仅当筛选关系为空时生效,且筛选关系为空时必传)。",
          "type": "string",
          "example": "ID"
        },
        "condition": {
          "description": "筛选条件(仅当筛选关系为空时生效,且筛选关系为空时必传)。\n取值范围: =, !=, >, <, >=, <=, LIKE, NOT LIKE, IN",
          "type": "string",
          "example": ">"
        },
        "value": {
          "description": "筛选值(仅当筛选关系为空时生效,且筛选关系为空时必传)。",
          "type": "string",
          "example": "1"
        },
        "filters": {
          "description": "下级筛选器(仅当筛选关系不为空时生效,且筛选关系不为空时必传)。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/PublicationTableFilterInfoRequest"
          }
        }
      },
      "type": "object"
    },
    "JobScheduleFrequencyInfo": {
      "description": "策略间隔周期。",
      "properties": {
        "freq_type": {
          "description": "策略频率类型 daily:按天, weekly:按周, monthly_day:按月、每月按天, monthly_week:按月、每月按周。",
          "type": "string",
          "example": "daily"
        },
        "freq_interval": {
          "description": "执行间隔。取值范围1至99。",
          "type": "integer",
          "example": "5"
        },
        "freq_interval_weekly": {
          "description": "频率类型为按周时该参数必传,不为按周时不生效。\n每周执行哪几天。参数值:Monday,Tuesday ... Sunday",
          "type": "array",
          "items": {
            "type": "string",
            "example": "Monday"
          }
        },
        "freq_interval_day_monthly": {
          "description": "频率类型为按月、每月按天时该参数必传,不为按月、每月按天时时不生效。\n每月执行的日期。取值范围1-31。",
          "type": "integer",
          "example": "31"
        },
        "freq_interval_monthly": {
          "description": "频率类型为按月、每月按周时该参数必传,不为按月、每月按周时时不生效。\n每周执行哪几天。 Sunday, Monday,Tuesday ... Saturday, day, weekday, weekend",
          "type": "string",
          "example": "weekday"
        },
        "freq_relative_interval_monthly": {
          "description": "频率类型为按月、每月按周时该参数必传,不为按月、每月按周时时不生效。\n每月在哪周执行。 first, second, third, fourth, last",
          "type": "string",
          "example": "fourth"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "rds.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "post",
  "uri": null
}