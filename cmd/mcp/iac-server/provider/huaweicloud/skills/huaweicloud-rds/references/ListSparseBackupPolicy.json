  "definitions": {
    "SparseBackupPolicy": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "参数解释:\n\n备份策略ID。\n\n取值范围:\n\n不涉及。",
          "example": "58224169-73f0-466f-99e9-5760ed7ace7e"
        },
        "period": {
          "type": "string",
          "description": "参数解释:\n\n备份周期配置。\n\n取值范围:\n\n格式为“日期 月份 星期”形式的Cron表达式,时区为UTC时区。\n日期支持范围为1~31、特殊字符*(表示任意值)、特殊字符L(表示最后一天)。填写1~31或L时支持填写多个,以逗号隔开。\n月份支持范围为1~12、特殊字符*(表示任意值)。\n星期支持范围为1~7(1表示星期一,2表示星期二,依次类推)、特殊字符*(表示任意值)。填写1~7数字时支持填写多个,以逗号隔开。",
          "example": "* * 1,2,3,4,5,6,7"
        },
        "keep_days": {
          "type": "integer",
          "description": "参数解释:\n\n备份文件可以保存的天数。\n\n取值范围:\n\n1~3660。",
          "example": 7
        },
        "start_time": {
          "type": "string",
          "description": "参数解释:\n\n全量备份时间段。自动备份将在该时间段内触发。\n\n取值范围:\n\n格式为hh:mm-HH:MM,为UTC时间。\nHH的值比hh大1。\nmm和MM的值相同,且取值必须为00。",
          "example": "08:15-09:15"
        }
      }
    },
    "ListSparseBackupPolicyResp": {
      "type": "object",
      "properties": {
        "policies": {
          "type": "array",
