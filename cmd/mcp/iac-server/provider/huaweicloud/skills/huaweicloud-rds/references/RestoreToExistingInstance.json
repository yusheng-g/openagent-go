  "paths": {
    "/v3/{project_id}/instances/recovery": {
      "post": {
        "tags": [
          "备份与恢复"
        ],
        "operationId": "RestoreToExistingInstance",
        "summary": "恢复到已有实例",
        "description": "恢复到已有实例。",
        "x-support-sdk": "Y",
        "x-constraint": "- 恢复到已有实例时,该接口存在如下约束:\n  - 源实例和目标实例的数据库类型必须一致,如都是MySQL。\n  - MySQL和PostgreSQL源实例和目标实例的数据库版本必须一致,如都是MySQL 5.7或PostgreSQL 9.5,SQL Server支持同版本或者高版本,SQL Server版本约束,详见表1。\n  - 目标实例的数据卷总大小,大于或等于源实例的数据卷总大小。\n  - 不支持跨区域恢复操作。\n- 恢复到当前实例时,该接口存在如下约束:\n\n  该接口仅支持实例的数据库引擎Microsoft SQL Server。",
        "parameters": [
          {
            "name": "x-auth-token",
            "in": "header",
            "description": "用户Token。",
            "type": "string",
            "x-example": "******",
            "required": false
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "语言",
            "type": "string",
            "x-example": "zh-cn",
            "required": false
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "RestoreToExistingInstanceRequest",
            "in": "body",
