  },
  "definitions": {
    "RestoreToExistingInstanceRequestBody": {
      "required": [
        "source",
        "target"
      ],
      "properties": {
        "source": {
          "description": "恢复数据源对象。",
          "required": [
            "instance_id"
          ],
          "properties": {
            "instance_id": {
              "description": "实例ID。",
              "type": "string"
            },
            "type": {
              "description": "表示恢复方式,枚举值:\n\n- “backup”,表示使用备份文件恢复,按照此方式恢复时,“type”字段为非必选,“backup_id”必选。\n- “timestamp”,表示按时间点恢复,按照此方式恢复时,“type”字段必选,“restore_time”必选。",
              "type": "string",
              "enum": [
                "backup",
                "timestamp"
              ]
            },
            "backup_id": {
              "description": "用于恢复的备份ID。当使用备份文件恢复时需要指定该参数。",
              "type": "string"
            },
            "restore_time": {
              "description": "恢复数据的时间点,格式为UNIX时间戳,单位是毫秒,时区为UTC。",
              "type": "integer",
              "format": "int64"
            },
            "database_name": {
              "description": "仅适用于SQL Server引擎,当有此参数时表示支持局部恢复和重命名恢复,恢复数据以局部恢复为主。不填写该字段时,默认恢复全部数据库。\n- 新数据库名称不可与源实例或目标实例数据库名称重名,新数据库名称为空,默认按照原数据库名进行恢复。\n- 新数据库名不能包含rdsadmin、master、msdb、tempdb、model或resource字段(不区分大小写)。\n- 数据库名称长度在1~64个字符之间,包含字母、数字、下划线或中划线,不能包含其他特殊字符。",
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "example": {
                "oldDbName": "newDbName"
              }
            }
          }
        },
        "target": {
          "description": "恢复目标对象。",
          "required": [
            "instance_id"
          ],
          "properties": {
            "instance_id": {
              "description": "恢复目标实例ID。",
              "type": "string"
            }
          }
        }
      }
    },
    "JobId": {
      "required": [
        "job_id"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "description": "任务ID。",
          "example": "6ad4eb1f-73bd-4876-aa31-aa9a1e41c4bc"
        }
      }
    },
    "ErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200022"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "实例名称已存在。"
        }
      }
    }
  },
