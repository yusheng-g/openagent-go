              "$ref": "#/definitions/RestoreToExistingInstanceRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/JobId"
            },
            "examples": {
              "application/json": {
                "job_id": "04efe8e2-9255-44ae-a98b-d87cae411890"
              }
            }
          },
          "default": {
            "description": "Client or server error.",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "x-request-examples-description-1": "使用备份文件恢复(Microsoft SQL Server)",
        "x-request-examples-url-1": "POST https://rds.cn-north-1.myhuaweicloud.com/v3/054e292c9880d4992f02c0196d3ea468/instances/recovery",
        "x-request-examples-1": {
