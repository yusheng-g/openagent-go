  "definitions": {
    "ConfigurationSummary": {
      "description": "参数模板信息。",
      "required": [
        "id",
        "name",
        "datastore_version_name",
        "datastore_name",
        "created",
        "updated",
        "user_defined"
      ],
      "properties": {
        "id": {
          "description": "参数组ID。",
          "type": "string"
        },
        "name": {
          "description": "参数组名称。",
          "type": "string"
        },
        "description": {
          "description": "参数组描述。",
          "type": "string"
        },
        "datastore_version_name": {
          "description": "引擎版本。",
          "type": "string"
        },
        "datastore_name": {
          "description": "引擎名。",
          "type": "string",
          "enum": [
            "mysql",
            "postgresql",
            "sqlserver",
            "mariadb"
          ]
        },
        "created": {
          "description": "创建时间,格式为\"yyyy-MM-ddTHH:mm:ssZ\"。\n\n其中,T指某个时间的开始;Z指时区偏移量,例如北京时间偏移显示为+0800。",
          "type": "string"
        },
        "updated": {
          "description": "更新时间,格式为\"yyyy-MM-ddTHH:mm:ssZ\"。\n\n其中,T指某个时间的开始;Z指时区偏移量,例如北京时间偏移显示为+0800。",
          "type": "string"
        },
        "user_defined": {
          "description": "是否是用户自定义参数模板:\n\n- false,表示为系统默认参数模板。\n- true,表示为用户自定义参数模板。",
          "type": "boolean"
        }
      }
    },
    "ErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200022"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "实例名称已存在。"
        }
      }
    },
    "ConfigurationsListResponse": {
      "required": [
        "configurations"
      ],
      "properties": {
        "configurations": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ConfigurationSummary"
          }
        }
      }
    }
  },
