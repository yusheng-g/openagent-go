        "x-support-sdk": "Y",
        "x-constraint": "- MySQL:仅支持5.6,5.7。\n- Microsoft SQL Server:仅支持2014 SE、2014 EE、2016 SE、2016 EE、2008 R2 EE、2008 R2 WEB、2014 WEB、2016 WEB。",
        "parameters": [
          {
            "name": "x-auth-token",
            "in": "header",
            "description": "用户Token。",
            "type": "string",
            "x-example": "******"
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "语言",
            "type": "string",
            "x-example": "zh-cn",
            "enum": [
              "zh-cn",
              "en-us"
            ]
          },
          {
            "name": "project_id",
