{
  "name": "ListErrorLogsNew",
  "summary": "查询数据库错误日志",
  "tags": "获取日志信息",
  "productshort": "RDS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v3.1/{project_id}/instances/{instance_id}/errorlog": {
      "get": {
        "tags": [
          "获取日志信息"
        ],
        "operationId": "ListErrorLogsNew",
        "summary": "查询数据库错误日志",
        "description": "查询数据库错误日志。(与原v3接口相比修改offset,符合华为云服务开放 API遵从性规范3.0)",
        "x-support-sdk": "Y",
        "parameters": [
          {
            "name": "x-auth-token",
            "in": "header",
            "description": "用户Token。",
            "type": "string",
            "x-example": "******"
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "语言",
            "type": "string",
            "x-example": "zh-cn"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "实例ID。",
            "required": true,
            "type": "string",
            "x-example": "e73893ef73754465a8bd2e0857bbf13ein01"
          },
          {
            "name": "start_date",
            "in": "query",
            "type": "string",
            "description": "开始时间,格式为“yyyy-mm-ddThh:mm:ssZ”。\n其中,T指某个时间的开始;Z指时区偏移量,例如北京时间偏移显示为+0800。",
            "required": true,
            "x-example": "2018-08-06T10:41:14+0800"
          },
          {
            "name": "end_date",
            "in": "query",
            "type": "string",
            "description": "结束时间,格式为“yyyy-mm-ddThh:mm:ssZ”。\n其中,T指某个时间的开始;Z指时区偏移量,例如北京时间偏移显示为+0800。\n只能查询当前时间前一个月内的错误日志。",
            "required": true,
            "x-example": "2018-08-07T10:41:14+0800"
          },
          {
            "name": "offset",
            "in": "query",
            "type": "integer",
            "format": "int64",
            "description": "索引位置,偏移量。从第一条数据偏移offset条数据后开始查询,默认为0(偏移0条数据,表示从第一条数据开始查询),必须为数字,不能为负数。"
          },
          {
            "name": "limit",
            "in": "query",
            "type": "integer",
            "format": "int64",
            "description": "每页多少条记录,取值范围是1~100,不填时默认为10。"
          },
          {
            "name": "level",
            "in": "query",
            "type": "string",
            "description": "日志级别,默认为ALL。",
            "enum": [
              "ALL",
              "INFO",
              "LOG",
              "WARNING",
              "ERROR",
              "FATAL",
              "PANIC",
              "NOTE"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/ListErrorLogResponseBody"
            },
            "examples": {
              "application/json": {
                "error_log_list": [
                  {
                    "time": "2018-12-04T14:24:42",
                    "level": "ERROR",
                    "content": "Slave I/O for channel '': error connecting to master 'rdsRepl@172.16.30.111:3306' - retry-time: 60  retries: 1, Error_code: 203"
                  },
                  {
                    "time": "2018-12-04T14:24:42",
                    "level": "ERROR",
                    "content": "Slave I/O for channel '': error connecting to master 'rdsRepl@172.11.11.111:8081' - retry-time: 60  retries: 1, Error_code: 203"
                  }
                ],
                "total_record": 2
              }
            }
          },
          "default": {
            "description": "Client or server error.",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "x-request-examples-description-1": "",
        "x-request-examples-url-1": "GET https://rds.cn-north-1.myhuaweicloud.com/v3.1/054e292c9880d4992f02c0196d3ea468/instances/3d39c18788b54a919bab633874c159dfin01/errorlog?start_date=2018-08-06T10:41:14+0800&end_date=2018-08-07T10:41:14+0800"
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200022"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "实例名称已存在。"
        }
      }
    },
    "ErrorLog": {
      "description": "错误日志信息。",
      "required": [
        "time",
        "level",
        "content"
      ],
      "properties": {
        "time": {
          "type": "string",
          "description": "日期时间UTC时间。"
        },
        "level": {
          "type": "string",
          "description": "日志级别。"
        },
        "content": {
          "type": "string",
          "description": "错误日志内容。"
        }
      }
    },
    "ListErrorLogResponseBody": {
      "required": [
        "error_log_list",
        "total_record"
      ],
      "properties": {
        "error_log_list": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ErrorLog"
          }
        },
        "total_record": {
          "type": "integer",
          "description": "总记录数。"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "rds.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v3",
  "method": "get",
  "uri": null
}