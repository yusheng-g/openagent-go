        "agent_not_running": {
          "description": "代理未运行的时长(以小时为单位)。",
          "type": "integer",
          "example": "100"
        },
        "pending_cmd_count": {
          "description": "订阅未执行的命令数。",
          "type": "integer",
          "example": "100"
        },
        "estimated_process_time": {
          "description": "预计执行完未执行的命令数所需时间(以秒为单位)。",
          "type": "integer",
          "example": "100"
        }
      }
