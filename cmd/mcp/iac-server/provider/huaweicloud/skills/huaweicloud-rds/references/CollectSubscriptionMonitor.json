      "description": "采集订阅监控响应信息。",
      "properties": {
        "status": {
          "description": "订阅关联的快照代理的运行状态。取值如下:\n\nstarted:已启动。\nsucceeded:成功。\nin_progress:正在运行。\nidle:空闲。\nretrying:重试中。\nfailed:失败。",
          "type": "string",
          "example": "started"
        },
        "latency": {
          "description": "数据更改的最长延迟时间(以秒为单位)。",
          "type": "integer",
          "example": "30"
        },
        "last_dist_sync": {
          "description": "上一次分发代理运行时间。格式为“yyyy-mm-ddThh:mm:ssZ”。\n其中,T指某个时间的开始;Z指时区偏移量,例如北京时间偏移显示为+0800。",
          "type": "string",
          "example": "2023-01-05T08:00:00+0800"
