      "post": {
        "tags": [
          "管理数据库和用户(PostgreSQL)"
        ],
        "operationId": "CreatePostgresqlDatabaseSchema",
        "summary": "创建数据库SCHEMA",
        "description": "在指定实例的数据库中, 创建数据库schema。",
        "x-support-sdk": "Y",
        "x-constraint": "实例在创建、变更规格、修改端口、冻结、异常等状态下不能执行该操作。",
        "parameters": [
          {
            "name": "x-auth-token",
            "in": "header",
            "description": "用户Token。",
            "type": "string",
            "x-example": "******"
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "语言",
            "type": "string",
            "x-example": "zh-cn"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "实例ID。",
            "required": true,
            "type": "string",
            "x-example": "e73893ef73754465a8bd2e0857bbf13ein01"
          },
          {
            "name": "DbSchemaReq",
            "in": "body",
            "description": "请求体。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/PostgresqlDatabaseSchemaReq"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "schema": {
              "$ref": "#/definitions/DBMSuccessRsp"
            },
            "examples": {
              "application/json": {
                "resp": "successful"
              }
            }
          },
          "default": {
            "description": "Client or server error.",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "x-request-examples-description-1": "",
        "x-request-examples-url-1": "POST https://rds.cn-north-1.myhuaweicloud.com/v3/054e292c9880d4992f02c0196d3ea468/instances/3d39c18788b54a919bab633874c159dfin01/schema",
        "x-request-examples-1": {
          "db_name": "rds_test",
          "schemas": [
            {
              "schema_name": "rds",
              "owner": "teste123"
            },
            {
              "schema_name": "rds001",
              "owner": "teste123"
            }
          ]
        }
      }
    }
  },
  "definitions": {
    "DBMSuccessRsp": {
      "required": [
        "resp"
      ],
      "properties": {
        "resp": {
          "description": "操作结果。",
          "type": "string",
          "example": "successful"
        }
      }
    },
    "ErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200022"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "实例名称已存在。"
        }
      }
    },
    "PostgresqlCreateSchemaReq": {
      "required": [
        "schema_name",
        "owner"
      ],
      "properties": {
        "schema_name": {
          "description": "schema名称。\n\nschema名称在1到63个字符之间,由字母、数字、或下划线组成,不能包含其他特殊字符,不能以“pg”和数字开头,且不能和RDS for PostgreSQL模板库和已存在的schema重名。\nRDS for PostgreSQL模板库包括postgres, template0 ,template1。\n\n已存在的schema包括public,information_schema。",
          "type": "string"
        },
        "owner": {
          "description": "数据库属主用户。\n\n数据库属主名称在1到63个字符之间,不能以“pg”和数字开头,不能和系统用户名称相同。\n\n系统用户包括“rdsAdmin”,“ rdsMetric”, “rdsBackup”, “rdsRepl”,“ rdsProxy”, “rdsDdm”。",
          "type": "string"
        }
      }
    },
    "PostgresqlDatabaseSchemaReq": {
      "description": "创建数据库schema信息。",
      "required": [
        "db_name",
        "schemas"
      ],
      "properties": {
        "db_name": {
          "description": "数据库名称。\n\n数据库名称在1到63个字符之间,由字母、数字、或下划线组成,不能包含其他特殊字符,不能以“pg”和数字开头,且不能和RDS for PostgreSQL模板库重名。\n\nRDS for PostgreSQL模板库包括postgres, template0 ,template1。",
          "type": "string"
        },
        "schemas": {
          "description": "每个元素都是与数据库相关联的schmea信息。单次请求最多支持20个元素。",
          "type": "array",
          "items": {
            "$ref": "#/definitions/PostgresqlCreateSchemaReq"
          }
        }
      }
    }
  },
