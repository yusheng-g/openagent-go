            "server_port": 1433,
            "login_user_name": "rdsuser",
            "login_user_password": "password"
          }
        }
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200022"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "实例名称已存在。"
        }
      }
    },
    "ValidateInstanceConnectionRequestBody": {
      "description": "用户登录连接测试信息。",
      "properties": {
        "target_instance_id": {
          "description": "连接目标实例id",
          "type": "string",
          "example": "1aa833000a124455a6801e83cca37e6ein04"
        },
        "user_info": {
          "description": "用户登录信息(此项仅在target_instance_id为空时生效)",
          "$ref": "#/definitions/ValidateConnectionUserInfo"
        }
      }
    },
    "CommonResp": {
      "type": "object",
      "required": [
        "resp"
      ],
      "properties": {
        "resp": {
          "type": "string",
          "description": "响应结果"
        }
      }
    },
    "ValidateConnectionUserInfo": {
      "description": "连接测试用户登录信息。",
      "properties": {
        "server_ip": {
          "description": "服务器ip。",
          "type": "string",
          "example": "192.168.0.1"
        },
        "server_port": {
          "description": "端口号。",
          "type": "integer",
          "example": "1433"
        },
        "login_user_name": {
          "description": "登录名。",
          "type": "string",
          "example": "rdsuser"
        },
        "login_user_password": {
          "description": "登录密码。要求密码长度在5~64位之间。",
          "type": "string",
          "example": "password"
        }
      }
