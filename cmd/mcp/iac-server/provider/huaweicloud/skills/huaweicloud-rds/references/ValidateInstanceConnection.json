          },
          "default": {
            "description": "error",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "x-request-examples-description-1": "RDS for SQL Server实例间的连通性测试",
        "x-request-examples-url-1": "POST https://{endpoint}/v3/0483b6b16e954cb88930a360d2c4e663/instances/1aa833000a124455a6801e83cca37e6ein04/replication/login_test",
        "x-request-examples-text-1": {
          "target_instance_id": "1aa833000a124455a6801e83cca37e6ein04"
        },
        "x-request-examples-description-2": "RDS for SQL Server实例与客户自建SQL Server数据库的连通性测试",
        "x-request-examples-url-2": "POST https://{endpoint}/v3/0483b6b16e954cb88930a360d2c4e663/instances/1aa833000a124455a6801e83cca37e6ein04/replication/login_test",
        "x-request-examples-text-2": {
          "user_info": {
