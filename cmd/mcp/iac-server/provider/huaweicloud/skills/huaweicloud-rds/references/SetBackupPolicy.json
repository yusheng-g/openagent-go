{
  "name": "SetBackupPolicy",
  "summary": "设置自动备份策略",
  "tags": "备份与恢复",
  "productshort": "RDS",
  "region_id": "ae-ad-1",
  "paths": {
    "/v3/{project_id}/instances/{instance_id}/backups/policy": {
      "put": {
        "tags": [
          "备份与恢复"
        ],
        "operationId": "SetBackupPolicy",
        "summary": "设置自动备份策略",
        "description": "设置自动备份策略。",
        "x-support-sdk": "Y",
        "parameters": [
          {
            "name": "x-auth-token",
            "in": "header",
            "description": "用户Token。",
            "type": "string",
            "x-example": "******"
          },
          {
            "name": "X-Language",
            "in": "header",
            "description": "语言",
            "type": "string",
            "x-example": "zh-cn"
          },
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。",
            "required": true,
            "type": "string",
            "x-example": "619d3e78f61b4be68bc5aa0b59edcf7b"
          },
          {
            "name": "instance_id",
            "in": "path",
            "description": "实例ID。",
            "required": true,
            "type": "string",
            "x-example": "e73893ef73754465a8bd2e0857bbf13ein01"
          },
          {
            "name": "SetBackupPolicyRequest",
            "in": "body",
            "description": "请求体。",
            "required": true,
            "schema": {
              "$ref": "#/definitions/SetBackupPolicyRequestBody"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success."
          },
          "default": {
            "description": "Client or server error.",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            }
          }
        },
        "x-request-examples-description-1": "更新自动备份策略",
        "x-request-examples-url-1": "PUT https://rds.cn-north-1.myhuaweicloud.com/v3/054e292c9880d4992f02c0196d3ea468/instances/3d39c18788b54a919bab633874c159dfin01/backups/policy",
        "x-request-examples-1": {
          "backup_policy": {
            "keep_days": 7,
            "start_time": "19:00-20:00",
            "period": "1,2"
          }
        },
        "x-request-examples-description-2": "关闭自动备份策略",
        "x-request-examples-url-2": "PUT https://rds.cn-north-1.myhuaweicloud.com/v3/054e292c9880d4992f02c0196d3ea468/instances/3d39c18788b54a919bab633874c159dfin01/backups/policy",
        "x-request-examples-2": {
          "backup_policy": {
            "keep_days": 0
          },
          "reserve_backups": false
        }
      }
    }
  },
  "definitions": {
    "SetBackupPolicyRequestBody": {
      "required": [
        "backup_policy"
      ],
      "properties": {
        "backup_policy": {
          "$ref": "#/definitions/BackupPolicy"
        },
        "reserve_backups": {
          "type": "boolean",
          "description": "仅关闭备份策略时有效。\n\n- true(默认),表示保留自动备份和差异备份。\n- false,表示关闭备份策略的同时,删除已有的自动备份和差异备份。"
        }
      }
    },
    "ErrorResponse": {
      "required": [
        "error_code",
        "error_msg"
      ],
      "properties": {
        "error_code": {
          "description": "错误码。",
          "type": "string",
          "example": "DBS.200022"
        },
        "error_msg": {
          "description": "错误消息。",
          "type": "string",
          "example": "实例名称已存在。"
        }
      }
    },
    "BackupPolicy": {
      "description": "备份策略信息。",
      "required": [
        "keep_days"
      ],
      "properties": {
        "keep_days": {
          "description": "指定已生成的备份文件可以保存的天数。\n\n取值范围:1~732。如果需要延长保留时间请联系客服人员申请,自动备份最长可以保留10年。",
          "type": "integer",
          "minimum": 0,
          "maximum": 2562
        },
        "start_time": {
          "description": "备份时间段。自动备份将在该时间段内触发。除关闭自动备份策略外,必选。\n\n取值范围:格式必须为hh:mm-HH:MM且有效,当前时间指UTC时间。\n\n- HH取值必须比hh大1。\n- mm和MM取值必须相同,且取值必须为00、15、30或45。",
          "type": "string",
          "example": "08:15-09:15"
        },
        "period": {
          "description": "备份周期配置。自动备份将在每星期指定的天进行。除关闭自动备份策略外,必选。\n\n取值范围:格式为逗号隔开的数字,数字代表星期。",
          "type": "string",
          "example": "1,2,3,4"
        }
      }
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "rds.ae-ad-1.myhuaweicloud.com",
  "base_path": "/",
