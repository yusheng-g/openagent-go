    "ModifyMySqlProxyRouteModeRequest": {
      "type": "object",
      "properties": {
        "master_weight": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "数据库主实例读权重。\n    - 当route_mode选择0(权重负载)时,该字段取值范围为0~1000。\n    - 当route_mode选择1或2(负载均衡)时,该字段不生效。"
        },
        "readonly_instances": {
          "items": {
            "required": [
              "id",
              "weight"
            ],
            "$ref": "#/definitions/InstancesWeight"
          },
          "description": "数据库节点的读权重设置。\n\n    - 只能为只读实例选择权重。\n    - 该列表可以为空列表。",
          "type": "array"
        },
        "route_mode": {
          "type": "integer",
          "format": "int32",
          "example": 0,
          "description": "数据库代理路由模式。\n取值范围:\n    0:表示权重负载模式。\n    1:表示负载均衡模式(数据库主实例不接受读请求)。\n    2:表示负载均衡模式(数据库主实例接受读请求)。\n\n    - 如需使用负载均衡模式,请联系客服申请"
        }
      },
      "required": [
        "master_weight",
        "readonly_instances",
        "route_mode"
      ],
      "description": "修改数据库代理路由模式请求体。"
    },
