  "definitions": {
    "Virsubnet": {
      "required": [
        "id",
        "name",
        "description",
        "dns_nameservers",
        "zone_id",
        "vpc_id",
        "status",
        "project_id",
        "scope",
        "subnet_cidrs",
        "tags",
        "extra_dhcp_opts",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "**参数解释**:\n子网的资源ID。子网创建成功后,会生成一个子网 ID,是子网对应的唯一标识。\n**取值范围**:\n带“-”的标准UUID格式。",
          "x-admin": "False",
          "x-internal": "False"
        },
        "name": {
          "type": "string",
          "description": "**参数解释**:\n子网的名称。\n**取值范围**:\n1-64个字符,支持数字、字母、中文字符、_(下划线)、-(中划线)、.(点)。",
          "x-admin": "False",
          "x-internal": "False"
        },
        "description": {
          "type": "string",
          "description": "**参数解释**:\n子网的描述信息。\n**取值范围**:\n0-255个字符,不能包含“<”和“>”。",
          "x-admin": "False",
          "x-internal": "False"
        },
        "dns_nameservers": {
          "type": "array",
          "description": "**参数解释**:\n子网的DNS服务器地址列表。\n**取值范围**:\n不涉及。",
          "items": {
            "type": "string"
          },
          "x-admin": "False",
          "x-internal": "False"
        },
        "zone_id": {
          "type": "string",
          "description": "**参数解释**:\n子网的可用区ID。\n**取值范围**:\n不涉及。",
          "x-admin": "False",
          "x-internal": "False"
        },
        "vpc_id": {
          "type": "string",
          "description": "**参数解释**:\n子网所属VPC的资源ID。\n**取值范围**:\n不涉及。",
          "x-admin": "False",
          "x-internal": "False"
        },
        "status": {
          "type": "string",
          "description": "**参数解释**:\n子网的状态。\n**取值范围**:\n- ACTIVE:表示子网已挂载到VPC上。\n- UNKNOWN:表示子网还未挂载到VPC上。\n- ERROR:表示子网状态故障。",
          "x-admin": "False",
          "x-internal": "False"
        },
        "project_id": {
          "type": "string",
          "description": "**参数解释**:\n子网所属的项目ID。\n**取值范围**:\n不涉及。",
          "x-admin": "False",
          "x-internal": "False"
        },
        "scope": {
          "type": "string",
          "description": "**参数解释**:\n子网的作用域(边缘云场景)。\n**取值范围**:\n- center:表示作用域为中心。\n- {publicBorderGroup}:表示作用域为具体的公网边界组。公网边界组限制子网的可用区范围,可关联多个边缘可用区。"
        },
        "subnet_cidrs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SubnetCidr"
          },
          "description": "**参数解释**:\nOpenStack Neutron子网信息。\n**取值范围**:\n不涉及。"
        },
        "tags": {
          "type": "array",
          "description": "**参数解释**:\n子网的标签信息,包括标签键和标签值,可用来分类和标识资源。详情请参见Tag对象。\n**取值范围**:\n不涉及。",
          "items": {
            "$ref": "#/definitions/ResponseTag"
          },
          "x-admin": "False",
          "x-internal": "False"
        },
        "extra_dhcp_opts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SubnetExtraDhcpOpt"
          },
          "description": "**参数解释**:\n子网的DHCP属性,支持配置NTP地址、DNS域名或租约到期时间。\n**取值范围**:\n不涉及。",
          "x-admin": "False",
          "x-internal": "False"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "**参数解释**:\n子网的创建时间。\n**取值范围**:\nUTC时间格式,yyyy-MM-ddTHH:mm:ss。",
          "x-admin": "False",
          "x-internal": "False"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "**参数解释**:\n子网的更新时间。\n**取值范围**:\nUTC时间格式,yyyy-MM-ddTHH:mm:ss。",
          "x-admin": "False",
          "x-internal": "False"
        }
      },
      "type": "object"
    },
    "SubnetCidr": {
      "type": "object",
      "required": [
        "id",
        "ip_version",
        "cidr",
        "gateway_ip",
        "enable_dhcp"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "**参数解释**:\nOpenStack Neutron子网的资源ID。\n**取值范围**:\n带“-”的标准UUID格式。"
        },
        "ip_version": {
          "type": "string",
          "description": "**参数解释**:\nOpenStack Neutron子网的IP版本。\n**取值范围**:\n- 4:IPv4子网。\n- 6:IPv6子网。"
        },
        "cidr": {
          "type": "string",
          "description": "**参数解释**:\nOpenStack Neutron子网的IP网段。\n**取值范围**:\nCIDR格式,如IPv4网段:192.168.23.0/24,IPv6网段:2420:2023:410:d5d::/64。"
        },
        "gateway_ip": {
          "type": "string",
          "description": "**参数解释**:\nOpenStack Neutron子网的网关IP地址。\n**取值范围**:\n不涉及。"
        },
        "enable_dhcp": {
          "type": "boolean",
          "description": "**参数解释**:\nOpenStack Neutron子网是否开启DHCP功能。\n**取值范围**:\n- true:开启DHCP功能。\n- false:未开启DHCP功能。"
        }
      }
    },
    "ShowVirsubnetRespBody": {
      "type": "object",
      "required": [
        "request_id",
        "virsubnet"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "description": "**参数解释**:\n请求ID。\n**取值范围**:\n不涉及。"
        },
        "virsubnet": {
          "description": "**参数解释**:\n查询子网详情的响应体。\n**取值范围**:\n不涉及。",
          "$ref": "#/definitions/Virsubnet"
        }
      }
    },
    "SubnetExtraDhcpOpt": {
      "type": "object",
      "required": [
        "opt_name",
        "opt_value",
        "ip_version"
      ],
      "properties": {
        "opt_name": {
          "type": "string",
          "description": "**参数解释**:\n子网配置的NTP地址、DNS域名或租约到期时间的名称。\n**取值范围**:\n- 42:表示子网ntp地址。\n- 15:表示DNS配置的域名,用于向DNS服务器获取IP地址。\n- 51:表示IPv4子网租约到期时间。\n- 651:表示IPv6子网租约到期时间。"
        },
        "opt_value": {
          "type": "string",
          "description": "**参数解释**:\n子网配置的NTP地址、DNS域名或租约到期时间。\n**取值范围**:\n- opt_name配置为“42”,则表示是子网ntp地址,目前只支持IPv4地址,每个IP地址以逗号隔开,IP地址个数不能超过4个,不能存在相同地址。\n- opt_name配置为“15”,则该值表示是DNS配置的域名,用于向DNS服务器获取IP地址。域名只能由字母,数字,中划线组成,中划线不能在开头或末尾。域名可以包含多个字符串,单个字符串不超过63个字符,字符串间以点分隔。域名长度不超过254个字符。\n- opt_name配置为“51”,则该值表示是IPv4子网租约到期时间,取值格式有两种,取-1,表示无限租约;数字+h,数字范围是1~175200,比如5h,默认值为87600h。\n- opt_name配置为“651”,则该值表示是IPv6子网租约到期时间,取值格式有两种,取-1,表示无限租约;数字+h,数字范围是1~175200,比如5h,默认值为2h。"
        },
        "ip_version": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n子网的IP版本。\n**取值范围**:\n- 4:默认值,IPv4。\n- 6:IPv6,只有opt_name是“651”时,ip_version为6。"
        }
      }
    },
    "ResponseTag": {
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "**参数解释**:\n标签键。\n**取值范围**:\n  - 最大长度128个unicode字符, key不能为空。\n  - 同一资源的key不能重复。\n  - 可以包含的字符范围:\n\t- 英文字母\n    - 数字\n    - 特殊字符:下划线(_)、点(.)、冒号(:)、加号(+)、中划线(-)、等号(=)\n    - 中文字符",
          "x-admin": "False",
          "x-internal": "False"
        },
        "value": {
          "type": "string",
          "description": "**参数解释**:\n标签值。\n**取值范围**:\n  - 每个值最大长度255个unicode字符,value可以为空。\n  - 可以包含的字符范围:\n\t- 英文字母\n    - 数字\n    - 特殊字符:下划线(_)、点(.)、冒号(:)、加号(+)、中划线(-)、等号(=)\n    - 中文字符",
          "x-admin": "False",
          "x-internal": "False"
        }
      },
      "type": "object"
    }
  },
  "version": "2.0",
  "parameters": {},
