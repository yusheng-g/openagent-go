    "SubnetCidr": {
      "type": "object",
      "required": [
        "id",
        "ip_version",
        "cidr",
        "gateway_ip",
        "enable_dhcp"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "**参数解释**:\nOpenStack Neutron子网的资源ID。\n**取值范围**:\n带“-”的标准UUID格式。"
        },
        "ip_version": {
          "type": "string",
          "description": "**参数解释**:\nOpenStack Neutron子网的IP版本。\n**取值范围**:\n- 4:IPv4子网。\n- 6:IPv6子网。"
        },
        "cidr": {
          "type": "string",
          "description": "**参数解释**:\nOpenStack Neutron子网的IP网段。\n**取值范围**:\nCIDR格式,如IPv4网段:192.168.23.0/24,IPv6网段:2420:2023:410:d5d::/64。"
        },
        "gateway_ip": {
          "type": "string",
          "description": "**参数解释**:\nOpenStack Neutron子网的网关IP地址。\n**取值范围**:\n不涉及。"
        },
        "enable_dhcp": {
          "type": "boolean",
          "description": "**参数解释**:\nOpenStack Neutron子网是否开启DHCP功能。\n**取值范围**:\n- true:开启DHCP功能。\n- false:未开启DHCP功能。"
        }
      }
    },
    "SubnetExtraDhcpOpt": {
      "type": "object",
      "required": [
        "opt_name",
        "opt_value",
        "ip_version"
      ],
      "properties": {
        "opt_name": {
          "type": "string",
          "description": "**参数解释**:\n子网配置的NTP地址、DNS域名或租约到期时间的名称。\n**取值范围**:\n- 42:表示子网ntp地址。\n- 15:表示DNS配置的域名,用于向DNS服务器获取IP地址。\n- 51:表示IPv4子网租约到期时间。\n- 651:表示IPv6子网租约到期时间。"
        },
        "opt_value": {
          "type": "string",
          "description": "**参数解释**:\n子网配置的NTP地址、DNS域名或租约到期时间。\n**取值范围**:\n- opt_name配置为“42”,则表示是子网ntp地址,目前只支持IPv4地址,每个IP地址以逗号隔开,IP地址个数不能超过4个,不能存在相同地址。\n- opt_name配置为“15”,则该值表示是DNS配置的域名,用于向DNS服务器获取IP地址。域名只能由字母,数字,中划线组成,中划线不能在开头或末尾。域名可以包含多个字符串,单个字符串不超过63个字符,字符串间以点分隔。域名长度不超过254个字符。\n- opt_name配置为“51”,则该值表示是IPv4子网租约到期时间,取值格式有两种,取-1,表示无限租约;数字+h,数字范围是1~175200,比如5h,默认值为87600h。\n- opt_name配置为“651”,则该值表示是IPv6子网租约到期时间,取值格式有两种,取-1,表示无限租约;数字+h,数字范围是1~175200,比如5h,默认值为2h。"
        },
        "ip_version": {
          "type": "integer",
          "format": "int32",
          "description": "**参数解释**:\n子网的IP版本。\n**取值范围**:\n- 4:默认值,IPv4。\n- 6:IPv6,只有opt_name是“651”时,ip_version为6。"
        }
      }
    },
