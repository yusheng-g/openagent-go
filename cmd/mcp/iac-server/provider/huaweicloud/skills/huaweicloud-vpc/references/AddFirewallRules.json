        },
        "protocol": {
          "type": "string",
          "description": "功能说明:ACL规则协议\n取值范围:支持tcp,udp,icmp,icmpv6或者协议号(0-255),any表示全部协议"
        },
        "ip_version": {
          "type": "integer",
          "format": "int32",
          "description": "功能说明:ACL规则的ip版本\n取值范围:4, 表示ipv4;6, 表示ipv6"
        },
        "source_ip_address": {
          "type": "string",
          "description": "功能说明:ACL规则源IP地址或者CIDR\n约束:source_ip_address和source_address_group_id不能同时设置"
        },
        "destination_ip_address": {
          "type": "string",
          "description": "功能说明:ACL规则目的IP地址或者CIDR\n约束:destination_ip_address和destination_address_group_id不能同时设置"
        },
        "source_port": {
          "type": "string",
          "description": "功能说明:ACL规则的源端口\n取值范围:支持端口号,一段端口范围,多个以逗号分隔\n约束:支持的端口组的数量默认为20"
        },
        "destination_port": {
          "type": "string",
          "description": "功能说明:ACL规则的目的端口\n取值范围:支持端口号,一段端口范围,多个以逗号分隔\n约束:支持的端口组的数量默认为20"
