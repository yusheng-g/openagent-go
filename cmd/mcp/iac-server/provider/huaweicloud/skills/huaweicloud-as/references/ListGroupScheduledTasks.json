  "definitions": {
    "ScheduledTasksResult": {
      "type": "object",
      "properties": {
        "page_info": {
          "description": "分页信息",
          "$ref": "#/definitions/PageInfo"
        },
        "scheduled_tasks": {
          "type": "array",
          "description": "计划任务列表",
          "items": {
            "$ref": "#/definitions/ScheduledTaskDetail"
          }
        }
      }
    },
    "PageInfo": {
      "type": "object",
      "properties": {
        "next_marker": {
          "type": "string",
          "description": "下一页的marker",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "IntegerRange": {
      "type": "object",
      "properties": {
        "max": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "伸缩组最大实例数"
        },
        "min": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "伸缩组最小实例数"
        },
        "desire": {
          "type": "integer",
          "format": "int32",
          "description": "伸缩组期望实例数"
        }
      }
    },
    "ScheduledTaskDetail": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "description": "计划任务ID",
          "pattern": "[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}"
        },
        "scaling_group_id": {
          "type": "string",
          "description": "伸缩组ID",
          "pattern": "[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}"
        },
        "name": {
          "type": "string",
          "description": "名称",
          "minLength": 1,
          "maxLength": 64
        },
        "scheduled_policy": {
          "$ref": "#/definitions/ScheduledTaskPolicy"
        },
        "instance_number": {
          "$ref": "#/definitions/IntegerRange"
        },
        "create_time": {
          "type": "string",
          "description": "创建时间"
        },
        "tenant_id": {
          "type": "string",
          "description": "租户ID"
        },
        "domain_id": {
          "type": "string",
          "description": "账号ID"
        },
        "update_time": {
          "type": "string",
          "description": "更新时间"
        }
      }
    },
    "ScheduledTaskPolicy": {
      "type": "object",
      "required": [
        "launch_time"
      ],
      "properties": {
        "start_time": {
          "type": "string",
          "description": "非必选,仅当recurrence_type不为空时生效,表示计划任务的生效开始时间,格式为yyyy-MM-ddTHH:mmZ,不填写时默认为任务创建成功的时间"
        },
        "end_time": {
          "type": "string",
          "description": "仅当recurrence_type不为空时生效且必选,表示计划任务的生效结束时间,格式为yyyy-MM-ddTHH:mmZ"
        },
        "launch_time": {
          "type": "string",
          "description": "必选,执行时间,采用UTC时间,recurrence_type不填写或为空时,格式为yyyy-MM-ddTHH:mmZ, recurrence_type不为空时,格式为 HH:mm"
        },
        "recurrence_type": {
          "type": "string",
          "description": "非必选,不填写时计划任务为定时执行, 填写时,为周期执行,且只能填写DAILY,WEEKLY,MONTHLY 中的一种,分别为按天,按周,按月周期执行",
          "enum": [
            "DAILY",
            "WEEKLY",
            "MONTHLY"
          ]
        },
        "recurrence_value": {
          "type": "string",
          "description": "仅当recurrence_type为WEEKLY,MONTHLY时必选,表示周期执行的具体日期,多个日期用,分割。recurrence_type为WEEKLY时,可填入1-7, recurrence_type为MONTHLY时,可填入1-31",
          "minLength": 1,
          "maxLength": 64
        }
      }
    }
  },
