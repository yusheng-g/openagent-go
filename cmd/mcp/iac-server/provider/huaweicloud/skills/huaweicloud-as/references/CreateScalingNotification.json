  "definitions": {
    "CreateNotificationOption": {
      "required": [
        "topic_scene",
        "topic_urn"
      ],
      "properties": {
        "topic_urn": {
          "type": "string",
          "description": "SMN服务中Topic的唯一的资源标识。"
        },
        "topic_scene": {
          "type": "array",
          "description": "通知场景,有以下五种类型。SCALING_UP:扩容成功。SCALING_UP_FAIL:扩容失败。SCALING_DOWN:减容成功。SCALING_DOWN_FAIL:减容失败。SCALING_GROUP_ABNORMAL:伸缩组发生异常",
          "items": {
            "type": "string",
            "enum": [
              "SCALING_UP",
              "SCALING_UP_FAIL",
              "SCALING_DOWN",
              "SCALING_DOWN_FAIL",
              "SCALING_GROUP_ABNORMAL"
            ]
          }
        }
      },
      "description": "配置伸缩组通知"
    },
    "CreateNotificationResult": {
      "properties": {
        "topic_urn": {
          "type": "string",
          "example": "urn:smn:regionId:b53e5554fad0494d96206fb84296510b:gsh",
          "description": "SMN服务中Topic的唯一的资源标识。"
        },
        "topic_scene": {
          "type": "array",
          "example": [
            "SCALING_UP",
            "SCALING_UP_FAIL",
            "SCALING_DOWN",
            "SCALING_DOWN_FAIL",
            "SCALING_GROUP_ABNORMAL"
          ],
          "description": "通知场景,有以下五种类型。SCALING_UP:扩容成功。SCALING_UP_FAIL:扩容失败。SCALING_DOWN:减容成功。SCALING_DOWN_FAIL:减容失败。SCALING_GROUP_ABNORMAL:伸缩组发生异常",
          "items": {
            "type": "string"
          }
        },
        "topic_name": {
          "type": "string",
          "example": "gsh",
          "description": "SMN服务中Topic的资源名称。"
        }
      },
      "description": "请求正常"
    }
