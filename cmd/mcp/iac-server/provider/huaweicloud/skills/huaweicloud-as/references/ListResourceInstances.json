        "x-request-examples-text-1": "{\n  offset: \"100\"\n  limit: \"100\"\n  action: \"filter\"\n  matches:\n  - key: \"resource_name\"\n    value: \"resource1\"\n  not_tags: \n  - key: \"key2\"\n    values: \"values2\"\n  tags:\n  - key: \"key1\"\n    values: \"values1\"\n}",
