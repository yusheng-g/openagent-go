  "definitions": {
    "ResourceTags": {
      "properties": {
        "key": {
          "type": "string",
          "description": "资源标签值。最大长度36个unicode字符。"
        },
        "value": {
          "type": "string",
          "description": "资源标签值。"
        }
      }
    },
    "Resources": {
      "properties": {
        "resource_id": {
          "type": "string",
          "description": "资源详情ID。"
        },
        "resource_detail": {
          "type": "string",
          "description": "资源详情。"
        },
        "tags": {
          "type": "array",
          "description": "标签列表,没有标签默认为空数组。",
          "items": {
            "$ref": "#/definitions/ResourceTags"
          }
        },
        "resource_name": {
          "type": "string",
          "description": "资源名称,没有默认为空字符串。"
        }
      }
    },
    "TagsMultiValue": {
      "type": "object",
      "required": [
        "key",
        "values"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "资源标签键。最大长度36个unicode字符。key不能为空。(搜索时不对此参数做校验)。最多为10个,不能为空或者空字符串。且不能重复。",
          "minLength": 1,
          "maxLength": 127
        },
        "values": {
          "type": "array",
          "description": "资源标签值列表,每个值最大长度43个unicode字符,每个key下最多为10个,同一个key中values不能重复。\n\n“*”为系统保留字符,如果value是以“*”开头表示按照“*”后面的值全模糊匹配。不能只传入“*”。\n如果values为空列表但不可缺省,则表示any_value(查询任意value)。value之间为或的关系",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 255
          }
        }
      }
    },
    "QueryTagsResult": {
      "properties": {
        "resources": {
          "type": "array",
          "description": "标签资源实例。",
          "items": {
            "$ref": "#/definitions/Resources"
          }
        },
        "total_count": {
          "type": "integer",
          "example": 2,
          "description": "总记录数。"
        },
        "marker": {
          "type": "string",
          "example": "2",
          "description": "分页位置标识。"
        }
      }
    },
    "Matches": {
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "键。暂限定为resource_name。",
          "minLength": 1,
          "maxLength": 127
        },
        "value": {
          "type": "string",
          "description": "值。为固定字典值。每个值最大长度255个unicode字符。若为空字符串、resource_id时为精确匹配。",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "description": ""
    },
    "QueryTagsOption": {
      "required": [
        "action"
      ],
      "properties": {
        "tags": {
          "type": "array",
          "example": [
            {
              "key": "key1",
              "values": [
                "*value1",
                "value2"
              ]
            }
          ],
          "description": "过滤条件,包含标签,最多包含10个Tag,结构体不能缺失。",
          "items": {
            "$ref": "#/definitions/TagsMultiValue"
          }
        },
        "tags_any": {
          "type": "array",
          "example": [
            {
              "key": "key1",
              "values": [
                "value1",
                "value2"
              ]
            }
          ],
          "description": "过滤条件,包含任意标签,最多包含10个Tag。",
          "items": {
            "$ref": "#/definitions/TagsMultiValue"
          }
        },
        "not_tags": {
          "type": "array",
          "example": [
            {
              "key": "key1",
              "values": [
                "*value1",
                "value2"
              ]
            }
          ],
          "description": "过滤条件,不包含标签,最多包含10个Tag。",
          "items": {
            "$ref": "#/definitions/TagsMultiValue"
          }
        },
        "not_tags_any": {
          "type": "array",
          "example": [
            {
              "key": "key1",
              "values": [
                "value1",
                "value2"
              ]
            }
          ],
          "description": "过滤条件,不包含任意标签,最多包含10个Tag。",
          "items": {
            "$ref": "#/definitions/TagsMultiValue"
          }
        },
        "limit": {
          "type": "string",
          "example": "100",
          "description": "查询记录数(action为count时无此参数)如果action为filter默认为1000,limit最多为1000,不能为负数,最小值为1。"
        },
        "marker": {
          "type": "string",
          "description": "分页位置标识(资源ID或索引位置)。"
        },
        "action": {
          "type": "string",
          "description": "操作标识(仅限filter,count):filter(过滤):即分页查询。count(查询总条数):按照条件将总条数返回即可。",
          "enum": [
            "filter",
            "count"
          ]
        },
        "offset": {
          "type": "string",
          "description": "(索引位置),从offset指定的下一条数据开始查询。查询第一页数据时,不需要传入此参数。查询后续页码数据时,将查询前一页数据时,不需要传入此参数。查询后续页码数据时,将查询前一页数据时响应体中的值带入此参数。必须为数字,不能为负数。action:count时,无此参数。action:filter时,默认为0"
        },
        "matches": {
          "type": "array",
          "example": [
            {
              "key": "resource_name",
              "values": "resource1"
            }
          ],
          "description": "模糊搜索字段。",
          "items": {
            "$ref": "#/definitions/Matches"
          }
        }
      },
      "description": "请求正常"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "as.af-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
