  "definitions": {
    "UpdateScheduledTaskOption": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "计划任务名称",
          "minLength": 1,
          "maxLength": 64
        },
        "scheduled_policy": {
          "$ref": "#/definitions/ScheduledTaskPolicy"
        },
        "instance_number": {
          "$ref": "#/definitions/IntegerRange"
        }
      }
    },
    "IntegerRange": {
      "type": "object",
      "properties": {
        "max": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "伸缩组最大实例数"
        },
        "min": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "伸缩组最小实例数"
        },
        "desire": {
          "type": "integer",
          "format": "int32",
          "description": "伸缩组期望实例数"
        }
      }
    },
    "ScheduledTaskPolicy": {
      "type": "object",
      "required": [
        "launch_time"
      ],
      "properties": {
        "start_time": {
          "type": "string",
          "description": "非必选,仅当recurrence_type不为空时生效,表示计划任务的生效开始时间,格式为yyyy-MM-ddTHH:mmZ,不填写时默认为任务创建成功的时间"
        },
        "end_time": {
          "type": "string",
          "description": "仅当recurrence_type不为空时生效且必选,表示计划任务的生效结束时间,格式为yyyy-MM-ddTHH:mmZ"
        },
        "launch_time": {
          "type": "string",
          "description": "必选,执行时间,采用UTC时间,recurrence_type不填写或为空时,格式为yyyy-MM-ddTHH:mmZ, recurrence_type不为空时,格式为 HH:mm"
        },
        "recurrence_type": {
          "type": "string",
          "description": "非必选,不填写时计划任务为定时执行, 填写时,为周期执行,且只能填写DAILY,WEEKLY,MONTHLY 中的一种,分别为按天,按周,按月周期执行",
          "enum": [
            "DAILY",
            "WEEKLY",
            "MONTHLY"
          ]
        },
        "recurrence_value": {
          "type": "string",
          "description": "仅当recurrence_type为WEEKLY,MONTHLY时必选,表示周期执行的具体日期,多个日期用,分割。recurrence_type为WEEKLY时,可填入1-7, recurrence_type为MONTHLY时,可填入1-31",
          "minLength": 1,
          "maxLength": 64
        }
      }
    }
  },
