  },
  "definitions": {
    "ScalingConfiguration": {
      "properties": {
        "scaling_configuration_id": {
          "type": "string",
          "description": "伸缩配置ID,全局唯一。",
          "pattern": "[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}"
        },
        "tenant": {
          "type": "string",
          "description": "租户ID。",
          "pattern": "[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}"
        },
        "scaling_configuration_name": {
          "type": "string",
          "example": "config_name_1",
          "description": "伸缩配置名称。"
        },
        "instance_config": {
          "$ref": "#/definitions/InstanceConfigResult"
        },
        "create_time": {
          "type": "string",
          "format": "date-time",
          "description": "创建伸缩配置的时间,遵循UTC时间。"
        },
        "scaling_group_id": {
          "type": "string",
          "description": "绑定该伸缩配置的伸缩组ID",
          "pattern": "[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}"
        }
      },
      "description": "伸缩配置详情"
    },
    "VmMetaData": {
      "properties": {
        "admin_pass": {
          "type": "string",
          "description": "如果需要使用密码方式登录云服务器,可使用adminPass字段指定云服务器管理员帐户初始登录密码。其中,Linux管理员帐户为root,Windows管理员帐户为Administrator。密码复杂度要求:- 长度为8-26位。- 密码至少必须包含大写字母、小写字母、数字和特殊字符(!@$%^-_=+[{}]:,./?)中的三种。- 密码不能包含用户名或用户名的逆序。- Windows系统密码不能包含用户名或用户名的逆序,不能包含用户名中超过两个连续字符的部分。"
        }
      },
      "description": "云服务器元数据"
    },
    "InstanceConfigResult": {
      "properties": {
        "flavorRef": {
          "type": "string",
          "description": "云服务器的规格ID。"
        },
        "imageRef": {
          "type": "string",
          "description": "镜像ID,同image_id。",
          "pattern": "[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}"
        },
        "disk": {
          "type": "array",
          "description": "磁盘组信息。",
          "items": {
            "$ref": "#/definitions/DiskResult"
          }
        },
        "key_name": {
          "type": "string",
          "description": "登录云服务器的SSH密钥名称。",
          "minLength": 1,
          "maxLength": 32
        },
        "key_fingerprint": {
          "type": "string",
          "description": "登录云服务器的SSH密钥指纹。"
        },
        "instance_name": {
          "type": "string",
          "description": "该参数为预留字段。"
        },
        "instance_id": {
          "type": "string",
          "description": "该参数为预留字段。"
        },
        "adminPass": {
          "type": "string",
          "description": "登录云服务器的密码,非明文回显。"
        },
        "personality": {
          "type": "array",
          "description": "个人信息",
          "items": {
            "$ref": "#/definitions/PersonalityResult"
          }
        },
        "public_ip": {
          "$ref": "#/definitions/PublicipResult"
        },
        "user_data": {
          "type": "string",
          "description": "cloud-init用户数据,base64格式编码。"
        },
        "metadata": {
          "$ref": "#/definitions/VmMetaData"
        },
        "security_groups": {
          "type": "array",
          "description": "安全组信息。",
          "items": {
            "$ref": "#/definitions/SecurityGroups"
          }
        },
        "server_group_id": {
          "type": "string",
          "description": "云服务器组ID。",
          "pattern": "[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}"
        },
        "tenancy": {
          "type": "string",
          "description": "在专属主机上创建弹性云服务器。"
        },
        "dedicated_host_id": {
          "type": "string",
          "description": "专属主机的ID。",
          "pattern": "[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}"
        },
        "market_type": {
          "type": "string",
          "description": "云服务器的计费模式,可以选择竞价计费或按需计费。"
        },
        "multi_flavor_priority_policy": {
          "type": "string",
          "description": "使用伸缩配置创建云主机的时候,多规格使用的优先级策略。\n\nPICK_FIRST(默认):选择优先,虚拟机扩容时规格的选择按照flavorRef列表的顺序进行优先级排序。\nCOST_FIRST:成本优化,虚拟机扩容时规格的选择按照价格最优原则进行优先级排序。"
        },
        "cpu_options": {
          "description": "是否关闭超线程,1是关闭,2是开启(默认)",
          "$ref": "#/definitions/CpuOptions"
        }
      },
      "description": "实例配置信息"
    },
    "SecurityGroups": {
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "example": "6c22a6c0-b5d2-4a84-ac56-51090dcc33be",
          "description": "安全组ID",
          "pattern": "[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}"
        }
      },
      "description": "安全组信息"
    },
    "DiskResult": {
      "type": "object",
      "properties": {
        "size": {
          "type": "integer",
          "description": "磁盘大小,容量单位为GB。"
        },
        "volume_type": {
          "type": "string",
          "description": "磁盘类型。",
          "enum": [
            "SATA",
            "SAS",
            "SSD",
            "co-pl",
            "uh-11",
            "GPSSD2",
            "ESSD2"
          ]
        },
        "disk_type": {
          "type": "string",
          "description": "系统盘还是数据盘,DATA表示为数据盘,SYS表示为系统盘。",
          "enum": [
            "SYS",
            "DATA"
          ]
        },
        "dedicated_storage_id": {
          "type": "string",
          "description": "磁盘所属的专属存储ID。",
          "pattern": "[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}"
        },
        "data_disk_image_id": {
          "type": "string",
          "description": "导入数据盘的数据盘镜像ID。",
          "pattern": "[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}"
        },
        "snapshot_id": {
          "type": "string",
          "description": "磁盘备份的快照ID。",
          "pattern": "[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}"
        },
        "metadata": {
          "description": "创建磁盘的元数据",
          "$ref": "#/definitions/MetaData"
        },
        "iops": {
          "type": "integer",
          "format": "int32",
          "description": "云硬盘iops"
        },
        "throughput": {
          "type": "integer",
          "format": "int32",
          "description": "云硬盘吞吐量"
        }
      },
      "description": "磁盘信息"
    },
    "PersonalityResult": {
      "properties": {
        "path": {
          "type": "string",
          "description": "注入文件路径信息。"
        },
        "content": {
          "type": "string",
          "description": "注入文件内容,base64格式编码。"
        }
      },
      "description": "个人信息"
    },
    "PublicipResult": {
      "properties": {
        "eip": {
          "description": "云服务器自动分配弹性IP时,创建弹性IP的配置参数。",
          "$ref": "#/definitions/EipResult"
        }
      },
      "description": "弹性IP信息"
    },
    "CpuOptions": {
      "type": "object",
      "properties": {
        "hw_cpu_threads": {
          "type": "integer",
          "format": "int32",
          "description": "是否关闭实例超线程,1是关闭,2是开启"
        }
      }
    },
    "MetaData": {
      "properties": {
        "__system__encrypted": {
          "type": "string",
          "description": "metadata中的表示加密功能的字段,0代表不加密,1代表加密。  该字段不存在时,云硬盘默认为不加密。\n说明:\n系统盘不支持加密。"
        },
        "__system__cmkid": {
          "type": "string",
          "description": "用户主密钥ID,是metadata中的表示加密功能的字段,与__system__encrypted配合使用。说明:- 系统盘不支持加密。- 请参考[查询密钥列表](https://apiexplorer.developer.huaweicloud.com/apiexplorer/doc?product=KMS&api=ListKeys&version=v2),通过HTTPS请求获取密钥ID。"
        }
      },
      "description": "创建磁盘的元数据"
    },
    "BandwidthResult": {
      "properties": {
        "size": {
          "type": "integer",
          "description": "带宽(Mbit/s)。",
          "minimum": 1,
          "maximum": 300
        },
        "share_type": {
          "type": "string",
          "description": "带宽的共享类型。共享类型枚举:PER,表示独享。目前只支持独享。",
          "enum": [
            "PER",
            "WHOLE"
          ]
        },
        "charging_mode": {
          "type": "string",
          "description": "带宽的计费类型。字段值为“bandwidth”,表示按带宽计费。字段值为“traffic”,表示按流量计费。",
          "enum": [
            "bandwidth",
            "traffic"
          ]
        },
        "id": {
          "type": "string",
          "description": "带宽ID,创建WHOLE类型带宽的弹性IP时指定的共享带宽。",
          "pattern": "[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}"
        }
      },
      "description": "带宽信息"
    },
    "EipResult": {
      "properties": {
        "ip_type": {
          "type": "string",
          "description": "IP地址类型。",
          "enum": [
            "5_bgp",
            "5_sbgp",
            "5_telcom",
            "5_union"
          ]
        },
        "bandwidth": {
          "description": "IP地址带宽参数。",
          "$ref": "#/definitions/BandwidthResult"
        }
      },
      "description": "eip信息"
    },
    "QueryScalingConfigResult": {
      "properties": {
        "scaling_configuration": {
          "description": "伸缩配置详情",
          "$ref": "#/definitions/ScalingConfiguration"
        }
      },
      "description": "请求成功"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "as.af-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "get",
  "uri": null
}