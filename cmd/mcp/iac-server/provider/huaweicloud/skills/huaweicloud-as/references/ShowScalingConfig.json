          },
          "502": {
            "description": "Bad Gateway 请求未完成。服务器从上游服务器收到一个无效的响应。"
          },
          "503": {
            "description": "Service Unavailable 请求未完成。系统暂时异常。"
          },
          "504": {
            "description": "Gateway Timeout 网关超时。"
          }
        },
        "x-is-registered": "Y",
        "x-request-examples-text-1": "该示例展示了查询ID为6afe46f9-7d3d-4046-8748-3b2a1085ad86的伸缩配置详情。",
        "x-request-examples-1": "该示例展示了查询ID为6afe46f9-7d3d-4046-8748-3b2a1085ad86的伸缩配置详情。",
        "x-support-sdk": "Y",
        "x-name": "查询弹性伸缩配置详情",
        "x-constraint": "",
