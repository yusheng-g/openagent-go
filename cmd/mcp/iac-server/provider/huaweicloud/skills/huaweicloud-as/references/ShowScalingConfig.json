          "406": {
            "description": "Not Acceptable 服务器生成的响应无法被客户端所接受。"
          },
          "407": {
            "description": "Proxy Authentication 用户必须首先使用代理服务器进行验证,这样请求才会被处理"
          },
          "408": {
            "description": "Request Timeout 请求超出了服务器的等待时间。"
          },
          "409": {
            "description": "Conflict 由于冲突,请求无法被完成。"
          },
          "500": {
            "description": "Internal Server Error 请求未完成。服务异常。"
          },
          "501": {
