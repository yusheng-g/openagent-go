  "definitions": {
    "UpdateScalingPolicyOption": {
      "type": "object",
      "properties": {
        "scaling_policy_name": {
          "type": "string",
          "description": "策略名称(1-64字符),可以用中文、字母、数字、下划线、中划线的组合。",
          "minLength": 1,
          "maxLength": 64
        },
        "scaling_policy_type": {
          "type": "string",
          "description": "策略类型。告警策略:ALARM(与alarm_id对应);定时策略:SCHEDULED(与scheduled_policy对应);周期策略:RECURRENCE(与scheduled_policy对应)",
          "enum": [
            "ALARM",
            "SCHEDULED",
            "RECURRENCE"
          ]
        },
        "alarm_id": {
          "type": "string",
          "description": "告警ID,即告警规则的ID,当scaling_policy_type为ALARM时该项必选,此时scheduled_policy不生效。创建告警策略成功后,会自动为该告警ID对应的告警规则的alarm_actions字段增加类型为autoscaling的告警触发动作。告警ID通过查询云监控告警规则列表获取,详见《云监控API参考》的“查询告警规则列表”。"
        },
        "scheduled_policy": {
          "description": "定时、周期任务策略,当scaling_policy_type为SCHEDULED或RECURRENCE时该项必选,此时alarm_id不生效。",
          "$ref": "#/definitions/ScheduledPolicy"
        },
        "scaling_policy_action": {
          "description": "策略执行具体动作",
          "$ref": "#/definitions/ScalingPolicyActionV1"
        },
        "cool_down_time": {
          "type": "integer",
          "description": "冷却时间,取值范围0-86400,默认为300,单位是秒。",
          "maximum": 86400
        }
      },
      "description": "修改伸缩策略"
    },
    "ScalingPolicyId": {
      "properties": {
        "scaling_policy_id": {
          "type": "string",
          "example": "0h327883-324n-4dzd-9c61-68d03ee191dd",
          "description": "伸缩策略ID。",
          "pattern": "[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}"
        }
      },
      "description": "创建伸缩策略"
    },
    "ScheduledPolicy": {
      "required": [
        "launch_time"
      ],
      "properties": {
        "launch_time": {
          "type": "string",
          "description": "触发时间,遵循UTC时间。如果scaling_policy_type为SCHEDULED,则格式为:YYYY-MM-DDThh:mmZ。如果scaling_policy_type为RECURRENCE,则格式为:hh:mm。"
        },
        "recurrence_type": {
          "type": "string",
          "description": "周期触发类型,scaling_policy_type为RECURRENCE时该项必选。Daily:每天执行一次。Weekly:每周指定天执行一次。Monthly:每月指定天执行一次。",
          "enum": [
            "Daily",
            "Weekly",
            "Monthly"
          ]
        },
        "recurrence_value": {
          "type": "string",
          "description": "周期触发任务数值,scaling_policy_type为RECURRENCE时该项必选。类型为Daily时,该字段为null,表示每天执行类型为Weekly时,该字段取值范围为1-7,1表示星期日,以此类推,以”,”分割,例如:1,3,5。类型为Monthly时,该字段取值范围为1-31,分别表示每月的日期,以“,”分割,例如:1,10,13,28。说明:- 当recurrence_type类型为Daily时,recurrence_value参数不生效。",
          "minLength": 1,
          "maxLength": 64
        },
        "start_time": {
          "type": "string",
          "description": "周期策略重复执行开始时间,遵循UTC时间。默认为当前时间,格式为:YYYY-MM-DDThh:mZ"
        },
        "end_time": {
          "type": "string",
          "description": "周期策略重复执行结束时间,遵循UTC时间,scaling_policy_type为RECURRENCE时该项必选。当为周期类型策略时,不得早于当前时间和开始时间。格式为:YYYY-MM-DDThh:mmZ"
        }
      },
      "description": "定时、周期任务策略"
    },
    "ScalingPolicyActionV1": {
      "properties": {
        "operation": {
          "type": "string",
          "example": "ADD",
          "description": "操作选项。ADD:添加实例。REMOVE/REDUCE:移除实例。SET:设置实例数为",
          "enum": [
            "ADD",
            "REMOVE",
            "REDUCE",
            "SET"
          ]
        },
        "instance_number": {
          "type": "integer",
          "format": "int32",
          "example": 1,
          "description": "操作实例个数,默认为1。当配额为默认配额时,取值范围如下:\n\noperation为SET时,取值范围为:0~300。\noperation为ADD或REMOVE/REDUCE时,取值范围为:1~300。\n说明:\n配置参数时,instance_number和instance_percentage参数只能选其中一个进行配置。"
        },
        "instance_percentage": {
          "type": "integer",
          "description": "操作实例百分比,将伸缩组容量增加、减少或设置为伸缩组当前实例个数的百分比。操作为ADD或REMOVE/REDUCE时取值范围为1到20000的整数,操作为SET时取值范围为0到20000的整数。当instance_number和instance_percentage参数均无配置时,则操作实例个数为1。配置参数时,instance_number和instance_percentage参数只能选其中一个进行配置。",
          "minimum": 0,
          "maximum": 100
        }
      },
      "description": "策略执行具体动作"
    }
  },
  "version": "2.0",
  "parameters": {},
  "host": "as.af-north-1.myhuaweicloud.com",
  "base_path": "/",
  "info_version": "v1",
  "method": "put",
  "uri": null
