        },
        "start_number": {
          "type": "integer",
          "format": "int32",
          "example": 0,
          "description": "查询的其实行号。"
        },
        "limit": {
          "type": "integer",
          "example": 20,
          "description": "查询记录数。",
          "minimum": 0,
          "maximum": 100
