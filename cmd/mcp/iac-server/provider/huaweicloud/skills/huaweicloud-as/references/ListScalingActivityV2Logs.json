          "items": {
            "$ref": "#/definitions/ModifyLb"
          }
        },
        "lb_bind_failed_list": {
          "type": "array",
          "description": "绑定失败的负载均衡器列表。",
          "items": {
            "$ref": "#/definitions/ModifyLb"
          }
        },
        "lb_unbind_success_list": {
          "type": "array",
          "description": "解绑成功的负载均衡器列表。",
          "items": {
            "$ref": "#/definitions/ModifyLb"
          }
        },
        "lb_unbind_failed_list": {
          "type": "array",
          "description": "解绑失败的负载均衡器列表。",
          "items": {
            "$ref": "#/definitions/ModifyLb"
          }
        },
        "type": {
          "type": "string",
          "description": "伸缩组活动类型"
        }
      },
      "description": "伸缩活动日志列表。"
    },
