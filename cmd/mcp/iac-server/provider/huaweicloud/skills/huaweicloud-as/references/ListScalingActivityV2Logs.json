        "instance_id": {
          "type": "string",
          "description": "云服务器id。",
          "pattern": "[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}"
        },
        "failed_reason": {
          "type": "string",
