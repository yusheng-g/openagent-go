          "items": {
            "$ref": "#/definitions/ScalingInstance"
          }
        },
        "instance_standby_list": {
          "type": "array",
          "description": "完成伸缩活动且被转入/移出备用状态的云服务器列表",
          "items": {
            "$ref": "#/definitions/ScalingInstance"
          }
        },
        "scaling_value": {
          "type": "integer",
          "format": "int32",
          "description": "伸缩活动中变化(增加或减少)的云服务器数量。"
        },
        "description": {
          "type": "string",
          "description": "伸缩活动的描述信息。"
        },
        "instance_value": {
          "type": "integer",
          "format": "int32",
          "description": "伸缩组当前instance值。"
        },
        "desire_value": {
          "type": "integer",
          "format": "int32",
          "description": "伸缩活动最终desire值。"
