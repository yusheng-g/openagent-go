          "type": "array",
          "description": "伸缩活动日志列表。",
          "items": {
            "$ref": "#/definitions/ScalingActivityLogV2"
          }
        }
      },
      "description": "伸缩活动日志列表."
    },
    "ScalingActivityLogV2": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "description": "伸缩活动状态:SUCCESS:成功。FAIL:失败。DOING:伸缩过程中。",
          "enum": [
            "SUCCESS",
            "FAIL",
            "DOING"
          ]
        },
        "start_time": {
          "type": "string",
          "format": "date-time",
          "description": "伸缩活动触发时间,遵循UTC时间。"
        },
        "end_time": {
          "type": "string",
          "format": "date-time",
          "description": "伸缩活动结束时间,遵循UTC时间。"
        },
        "id": {
          "type": "string",
          "description": "伸缩活动日志ID。",
          "pattern": "[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}"
        },
        "instance_removed_list": {
          "type": "array",
