          "items": {
            "$ref": "#/definitions/ScalingInstance"
          }
        },
        "instance_deleted_list": {
          "type": "array",
          "description": "完成伸缩活动且被移出弹性伸缩组并删除的云服务器名称列表,云服务器信息之间以逗号分隔。",
          "items": {
            "$ref": "#/definitions/ScalingInstance"
          }
        },
        "instance_added_list": {
          "type": "array",
          "description": "完成伸缩活动且被加入弹性伸缩组的云服务器名称列表,云服务器信息之间以逗号分割。",
          "items": {
            "$ref": "#/definitions/ScalingInstance"
          }
        },
        "instance_failed_list": {
          "type": "array",
