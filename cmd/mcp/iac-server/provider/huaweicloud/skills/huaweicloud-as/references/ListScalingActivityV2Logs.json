{
  "name": "ListScalingActivityV2Logs",
  "summary": "查询伸缩活动日志v2版本",
  "tags": "伸缩活动日志管理",
  "productshort": "AS",
  "region_id": "af-north-1",
  "paths": {
    "/autoscaling-api/v2/{project_id}/scaling_activity_log/{scaling_group_id}": {
      "get": {
        "tags": [
          "伸缩活动日志管理"
        ],
        "summary": "查询伸缩活动日志v2版本",
        "description": "根据输入条件过滤查询伸缩活动日志,支持查询实例伸缩、ELB迁移、实例备用等类型活动。查询结果分页显示。查询伸缩活动日志V2版本与V1版本区别在于,V2版本展示了更详细的实例伸缩日志,如ELB迁移日志,实例备用日志信息。可根据起始时间,截止时间,起始行号,记录数,伸缩活动类型等作为条件过滤查询。若不加过滤条件默认查询最多20条伸缩活动日志信息。",
        "operationId": "ListScalingActivityV2Logs",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "description": "项目ID。",
            "required": true,
            "type": "string",
            "x-order": 1,
            "x-example": "0513757xxxxxd5eb2f08xxxb93ef4f0f"
          },
          {
            "name": "scaling_group_id",
            "in": "path",
            "description": "伸缩组ID。",
            "required": true,
            "type": "string",
            "x-order": 2,
            "x-example": "66e0f775-c4ac-xxxx-xxxx-f93ba217aa5f"
          },
          {
            "name": "X-Auth-Token",
            "in": "header",
            "description": "用户Token。通过调用IAM服务获取用户Token接口获取(响应消息头中X-Subject-Token的值)。",
            "required": true,
            "type": "string",
            "x-order": 3,
            "x-example": "MIIDkgYJKoZIhvcNAQcCoIIDgzCCXXXXXX..."
          },
          {
            "name": "log_id",
            "in": "query",
            "description": "伸缩活动日志ID",
            "required": false,
            "type": "string"
          },
          {
            "name": "start_time",
            "in": "query",
            "description": "查询的起始时间,格式是“yyyy-MM-ddThh:mm:ssZ”。",
            "required": false,
            "type": "string",
            "x-order": 4,
            "x-example": "2019-03-18T16:00:11Z"
          },
          {
            "name": "end_time",
            "in": "query",
            "description": "查询的截止时间,格式是“yyyy-MM-ddThh:mm:ssZ”。",
            "required": false,
            "type": "string",
            "x-order": 5,
            "x-example": "2019-03-18T16:00:11Z"
          },
          {
            "name": "start_number",
            "in": "query",
            "description": "查询的起始行号,默认为0。",
            "required": false,
            "type": "integer",
            "default": 0,
            "maximum": 32768,
            "x-order": 6
          },
          {
            "name": "limit",
            "in": "query",
            "description": "查询记录数,默认20,最大100。",
            "required": false,
            "type": "integer",
            "default": 20,
            "maximum": 100,
            "x-order": 7,
            "x-example": 5
          },
          {
            "name": "type",
            "in": "query",
            "description": "查询的伸缩活动类型(查询多类型使用逗号分隔):\n- NORMAL:普通伸缩活动\n- MANNUAL_REMOVE:从伸缩组手动移除实例\n- MANNUAL_DELETE:从伸缩组手动移除并删除实例\n- MANNUAL_ADD:实例手动加入伸缩组。\n- ELB_CHECK_DELETE:ELB检查移除并删除实例。\n- AUDIT_CHECK_DELETE:通过审计openstack移除并删除实例。\n- DIFF:期望实例数与实际实例数不一致。\n- MODIFY_ELB:LB迁移。\n- ENTER_STANDBY:实例转入备用。\n- EXIT_STANDBY:实例移出备用。",
            "required": false,
            "type": "string",
            "enum": [
              "NORMAL",
              "MANNUAL_REMOVE",
              "MANNUAL_DELETE",
              "MANNUAL_ADD",
              "ELB_CHECK_DELETE",
              "AUDIT_CHECK_DELETE",
              "MODIFY_ELB"
            ],
            "x-order": 8,
            "x-example": "NORMAL"
          },
          {
            "name": "status",
            "in": "query",
            "description": "查询的伸缩活动状态:SUCCESS:成功;FAIL:失败;DOING:伸缩中",
            "required": false,
            "type": "string",
            "enum": [
              "SUCCESS",
              "FAIL",
              "DOING"
            ],
            "x-example": "DOING"
          }
        ],
        "responses": {
