        },
        "desire_instance_number": {
          "type": "integer",
          "format": "int32",
          "description": "伸缩组期望实例数。"
        },
        "min_instance_number": {
          "type": "integer",
          "format": "int32",
          "description": "伸缩组最小实例数。"
        },
        "max_instance_number": {
          "type": "integer",
          "format": "int32",
          "description": "伸缩组最大实例数"
        },
        "cool_down_time": {
          "type": "integer",
          "description": "冷却时间,单位是秒。",
          "maximum": 86400
        },
        "lb_listener_id": {
          "type": "string",
          "description": "经典型负载均衡监听器ID,多个负载均衡监听器ID以逗号分隔。",
          "minLength": 1,
          "maxLength": 32
        },
        "lbaas_listeners": {
          "type": "array",
          "description": "增强型负载均衡器信息,该参数为预留字段。",
          "items": {
            "$ref": "#/definitions/LbaasListenersResult"
          }
