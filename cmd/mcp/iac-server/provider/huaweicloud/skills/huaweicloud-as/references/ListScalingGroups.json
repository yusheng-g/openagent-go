          "pattern": "[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}"
        },
        "scaling_configuration_name": {
          "type": "string",
          "description": "伸缩配置名称。",
          "minLength": 1,
          "maxLength": 64
        },
