        "x-otc": "Y"
      }
    }
  },
  "definitions": {
    "ScalingGroupsResult": {
      "properties": {
        "total_number": {
          "type": "integer",
          "format": "int32",
          "description": "总记录数"
        },
        "start_number": {
          "type": "integer",
          "format": "int32",
          "description": "查询的开始记录号"
        },
        "limit": {
          "type": "integer",
          "format": "int32",
          "description": "查询记录数"
        },
        "scaling_groups": {
          "type": "array",
          "description": "伸缩组列表",
          "items": {
            "$ref": "#/definitions/ScalingGroups"
          }
        }
      },
      "description": "伸缩组列表"
    },
    "NetworksResult": {
      "properties": {
        "id": {
          "type": "string",
          "example": "a8327883-6b07-4497-9c61-68d03ee193a",
          "description": "网络ID",
          "pattern": "[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}"
        },
        "ipv6_enable": {
          "type": "boolean",
          "description": "是否启用IPv6。取值为true时,标识此网卡已启用IPv6。"
        },
        "ipv6_bandwidth": {
          "$ref": "#/definitions/Ipv6Bandwidth"
        },
        "allowed_address_pairs": {
          "type": "array",
