          },
          "503": {
            "description": "Service Unavailable 请求未完成。系统暂时异常。"
          },
          "504": {
            "description": "Gateway Timeout 网关超时。"
          }
        },
        "x-is-registered": "Y",
        "x-request-examples-description-1": "示例为查询满足条件“伸缩组名称为as-group-test且伸缩配置ID为1d281494-6085-4579-b817-c1f813be835f”的伸缩组列表。",
        "x-support-sdk": "Y",
        "x-name": "查询弹性伸缩组列表",
        "x-version": "v1",
        "x-scope": "Commercial",
        "x-iftype": "公开接口",
        "x-order": 2,
        "x-request-examples-url-1": "GET https://{Endpoint}/autoscaling-api/v1/{project_id}/scaling_group?scaling_group_name=as-group-test&scaling_configuration_id=1d281494-6085-4579-b817-c1f813be835f",
        "x-flow_control_group": "as",
        "x-tenant_flow_time": 1,
        "x-hk": "Y",
        "x-first_open_time": "2016-06-30",
        "x-tenant_flow_value": 78,
        "x-hybridcloud": "true",
        "x-source": "SelfDeveloped",
        "x-timeout": "10s",
        "x-tlf": "Y",
