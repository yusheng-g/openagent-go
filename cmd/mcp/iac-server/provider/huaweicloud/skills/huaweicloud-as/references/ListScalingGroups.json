        "cloud_location_id": {
          "type": "string",
          "description": "该参数为预留字段"
        },
        "enterprise_project_id": {
          "type": "string",
          "description": "企业项目ID",
          "pattern": "[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}"
        },
        "activity_type": {
          "type": "string",
          "description": "伸缩组活动类型"
        },
        "multi_az_priority_policy": {
          "type": "string",
