      "properties": {
        "ip_address": {
          "type": "string",
          "description": "是否开启源/目的检查开关。\n\n默认是开启,不允许置空。\n\n关闭:1.1.1.1/0\n开启:除“1.1.1.1/0”以外的其余值均按开启处理"
        }
      },
      "description": "是否开启源/目的检查开关。"
    },
    "Ipv6Bandwidth": {
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "IPv6共享带宽的ID。",
          "pattern": "[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}"
        }
      },
      "description": "IPv6信息"
    },
    "TagsSingleValue": {
      "type": "object",
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "资源标签键。最大长度36个unicode字符。key不能为空。(搜索时不对此参数做校验)。最多为10个,不能为空或者空字符串。且不能重复。"
        },
        "value": {
          "type": "string",
          "description": "资源标签值列表,每个值最大长度43个unicode字符,每个key下最多为10个,同一个key中values不能重复。\n\n“*”为系统保留字符,如果value是以“*”开头表示按照“*”后面的值全模糊匹配。不能只传入“*”。\n如果values为空列表但不可缺省,则表示any_value(查询任意value)。value之间为或的关系。"
        }
      },
      "description": "资源标签键"
    },
    "SecurityGroupsResult": {
      "properties": {
        "id": {
          "type": "string",
          "example": "8a4b1d5b-0054-419f-84b1-5c8a59ebc829",
          "description": "安全组ID",
          "pattern": "[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}"
        }
      },
      "description": "安全组信息"
    },
    "LbaasListenersResult": {
      "type": "object",
      "properties": {
        "listener_id": {
          "type": "string",
          "description": "监听器ID"
        },
        "pool_id": {
          "type": "string",
          "description": "后端云服务器组ID",
          "pattern": "[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}"
        },
        "protocol_port": {
          "type": "integer",
          "format": "int32",
          "description": "后端协议号,指后端云服务器监听的端口,取值范围[1,65535]",
          "minimum": 1,
          "maximum": 65535
        },
        "weight": {
          "type": "integer",
          "format": "int32",
          "description": "权重,指后端云服务器经分发得到的请求数量比例,取值范围[0,1],默认为1。"
        },
        "protocol_version": {
          "type": "string",
          "description": "指定ip协议版本",
          "enum": [
            "IPV4",
            "IPV6"
          ]
        }
      },
      "description": "增强型负载均衡器信息"
    },
    "ScalingGroups": {
      "type": "object",
      "properties": {
        "scaling_group_name": {
          "type": "string",
          "description": "伸缩组名称。"
        },
        "scaling_group_id": {
          "type": "string",
          "description": "伸缩组ID。",
          "pattern": "[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}"
        },
        "scaling_group_status": {
          "type": "string",
          "description": "伸缩组状态。",
          "enum": [
            "INSERVICE",
            "PAUSED",
            "ERROR",
            "DELETING",
            "FREEZED"
          ]
        },
        "scaling_configuration_id": {
          "type": "string",
