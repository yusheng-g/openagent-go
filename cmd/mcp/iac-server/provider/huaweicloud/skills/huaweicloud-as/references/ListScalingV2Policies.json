  "definitions": {
    "ScalingPolicyActionV2": {
      "properties": {
        "operation": {
          "type": "string",
          "example": "ADD",
          "description": "操作选项,默认为ADD。\n当scaling_resource_type为SCALING_GROUP,支持如下操作:\n- ADD:增加\n- REMOVE/REDUCE:减少\n- SET:设置为\n当scaling_resource_type为BANDWIDTH,支持如下操作:\n- ADD:增加\n- REDUCE:减少\n- SET:设置为",
          "enum": [
            "ADD",
            "REMOVE",
            "REDUCE",
            "SET"
          ]
        },
        "size": {
          "type": "integer",
          "example": 1,
          "description": "操作大小,取值范围为0到300的整数,默认为1。当scaling_resource_type为SCALING_GROUP时,size为实例个数,取值范围为0-300的整数,默认为1。当scaling_resource_type为BANDWIDTH时,size表示带宽大小,单位为Mbit/s,取值范围为1到300的整数,默认为1。当scaling_resource_type为SCALING_GROUP时,size和percentage参数只能选其中一个进行配置。",
          "minimum": 0,
          "maximum": 300
        },
        "percentage": {
          "type": "integer",
          "description": "操作百分比,取值为0到20000的整数。当scaling_resource_type为SCALING_GROUP时,size和instance_percentage参数均无配置,则size默认为1。当scaling_resource_type为BANDWIDTH时,不支持配置instance_percentage参数。",
          "minimum": 0,
          "maximum": 20000
        },
        "limits": {
          "type": "integer",
          "format": "int32",
          "example": 10,
          "description": "操作限制。当scaling_resource_type为BANDWIDTH,且operation不为SET时,limits参数生效,单位为Mbit/s。此时,当operation为ADD时,limits表示带宽可调整的上限;当operation为REDUCE时,limits表示带宽可调整的下限。"
        }
      },
      "description": "策略执行具体动作。"
    },
    "IntervalAlarmActionsV2": {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "description": "操作选项,默认为ADD。\n当scaling_resource_type为SCALING_GROUP,支持如下操作:\nADD:增加\nREMOVE/REDUCE:减少\nSET:设置为\n当scaling_resource_type为BANDWIDTH,支持如下操作:\nADD:增加\nREDUCE:减少"
        },
        "limits": {
          "type": "integer",
          "format": "int32",
          "description": "操作限制。当scaling_resource_type为BANDWIDTH,且operation不为SET时,limits参数生效,单位为Mbit/s。此时,当operation为ADD时,limits表示带宽可调整的上限;当operation为REDUCE时,limits表示带宽可调整的下限。"
        },
        "size": {
          "type": "integer",
          "format": "int32",
          "description": "操作大小,取值范围为0到300的整数,默认为1。当scaling_resource_type为SCALING_GROUP时,size为实例个数,取值范围为0-300的整数,默认为1。当scaling_resource_type为BANDWIDTH时,size表示带宽大小,单位为Mbit/s,取值范围为1到300的整数,默认为1。当scaling_resource_type为SCALING_GROUP时,size和percentage参数只能选其中一个进行配置。"
        },
        "lower_bound": {
          "type": "number",
          "format": "double"
        },
        "upper_bound": {
          "type": "number",
          "format": "double"
        },
        "percentage": {
          "type": "integer",
          "format": "int32",
          "description": "操作百分比,取值为0到20000的整数。当scaling_resource_type为SCALING_GROUP时,size和instance_percentage参数均无配置,则size默认为1。当scaling_resource_type为BANDWIDTH时,不支持配置instance_percentage参数。"
        }
      },
      "description": "操作告警区间"
    },
    "QueryScalingPolicyListV2Response": {
      "properties": {
        "total_number": {
          "type": "integer",
          "format": "int32",
          "example": 3,
          "description": "总记录数。"
        },
        "start_number": {
          "type": "integer",
          "format": "int32",
          "example": 0,
          "description": "查询的起始行号。"
        },
        "limit": {
          "type": "integer",
          "example": 20,
          "description": "查询记录数。",
          "minimum": 0,
          "maximum": 100
        },
        "scaling_policies": {
          "type": "array",
          "description": "伸缩策略列表",
          "items": {
            "$ref": "#/definitions/ScalingPoliciesV2"
          }
        }
      },
      "description": "请求正常"
    },
    "ScalingPolicyV2MetaData": {
      "properties": {
        "metadata_bandwidth_share_type": {
          "type": "string",
          "description": "伸缩带宽策略中带宽对应的共享类型"
        },
        "metadata_eip_id": {
          "type": "string",
          "description": "伸缩带宽策略中带宽对应的EIP的ID"
        },
        "metadata_eip_address": {
          "type": "string",
          "description": "伸缩带宽策略中带宽对应的EIP地址"
        }
      },
      "description": "附件信息"
    },
    "ScheduledPolicy": {
      "required": [
        "launch_time"
      ],
      "properties": {
        "launch_time": {
          "type": "string",
          "description": "触发时间,遵循UTC时间。如果scaling_policy_type为SCHEDULED,则格式为:YYYY-MM-DDThh:mmZ。如果scaling_policy_type为RECURRENCE,则格式为:hh:mm。"
        },
        "recurrence_type": {
          "type": "string",
          "description": "周期触发类型,scaling_policy_type为RECURRENCE时该项必选。Daily:每天执行一次。Weekly:每周指定天执行一次。Monthly:每月指定天执行一次。",
          "enum": [
            "Daily",
            "Weekly",
            "Monthly"
          ]
        },
        "recurrence_value": {
          "type": "string",
          "description": "周期触发任务数值,scaling_policy_type为RECURRENCE时该项必选。类型为Daily时,该字段为null,表示每天执行类型为Weekly时,该字段取值范围为1-7,1表示星期日,以此类推,以”,”分割,例如:1,3,5。类型为Monthly时,该字段取值范围为1-31,分别表示每月的日期,以“,”分割,例如:1,10,13,28。说明:- 当recurrence_type类型为Daily时,recurrence_value参数不生效。",
          "minLength": 1,
          "maxLength": 64
        },
        "start_time": {
          "type": "string",
          "description": "周期策略重复执行开始时间,遵循UTC时间。默认为当前时间,格式为:YYYY-MM-DDThh:mZ"
        },
        "end_time": {
          "type": "string",
          "description": "周期策略重复执行结束时间,遵循UTC时间,scaling_policy_type为RECURRENCE时该项必选。当为周期类型策略时,不得早于当前时间和开始时间。格式为:YYYY-MM-DDThh:mmZ"
        }
      },
      "description": "定时、周期任务策略"
    },
    "ScalingPoliciesV2": {
      "properties": {
        "scaling_policy_name": {
          "type": "string",
          "description": "伸缩策略名称。",
          "minLength": 1,
          "maxLength": 64
        },
        "scaling_policy_id": {
          "type": "string",
          "description": "伸缩策略ID。",
          "pattern": "[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}"
        },
        "scaling_resource_id": {
          "type": "string",
          "description": "伸缩资源ID。",
          "pattern": "[0-9a-z]{8}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{4}-[0-9a-z]{12}"
        },
        "scaling_resource_type": {
          "type": "string",
          "description": "伸缩资源类型。伸缩组:SCALING_GROUP。带宽:BANDWIDTH。",
          "enum": [
            "SCALING_GROUP",
            "BANDWIDTH"
          ]
        },
        "policy_status": {
          "type": "string",
          "description": "伸缩策略状态。INSERVICE:使用中。PAUSED:停止。EXECUTING:执行中。",
          "enum": [
            "INSERVICE",
            "PAUSED",
            "EXECUTING"
          ]
        },
        "scaling_policy_type": {
          "type": "string",
          "description": "伸缩策略类型:ALARM:告警策略,此时alarm_id有返回,scheduled_policy不会返回。SCHEDULED:定时策略,此时alarm_id不会返回,scheduled_policy有返回,并且recurrence_type、recurrence_value、start_time和end_time不会返回。RECURRENCE:周期策略,此时alarm_id不会返回,scheduled_policy有返回,并且recurrence_type、recurrence_value、start_time和end_time有返回。",
          "enum": [
            "ALARM",
            "SCHEDULED",
            "RECURRENCE",
            "INTERVAL_ALARM"
          ]
        },
        "alarm_id": {
          "type": "string",
          "description": "告警ID。",
          "minLength": 1,
          "maxLength": 64
        },
        "scheduled_policy": {
          "$ref": "#/definitions/ScheduledPolicy"
        },
        "scaling_policy_action": {
          "$ref": "#/definitions/ScalingPolicyActionV2"
        },
        "interval_alarm_actions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/IntervalAlarmActionsV2"
          }
        },
        "cool_down_time": {
          "type": "integer",
          "description": "冷却时间,取值范围0-86400,默认为300,单位是秒。",
          "maximum": 86400
        },
        "create_time": {
          "type": "string",
          "format": "date-time",
          "description": "创建伸缩策略时间,遵循UTC时间"
        },
        "meta_data": {
          "$ref": "#/definitions/ScalingPolicyV2MetaData"
        },
        "description": {
          "type": "string",
          "description": "伸缩策略描述(1-256个字符)"
        }
      },
      "description": "伸缩策略"
    }
  },
