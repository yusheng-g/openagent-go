# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# Build output
bin/
build/

# build.sh produces the default-named binary at the repo root.
# A branded build (OPENAGENT_BINARY_NAME=<name>) emits <name> instead;
# that is left for the developer to clean up.
/openagent

# WASM plugin binaries (compiled from examples/plugin/)
plugins/
*.wasm

# Rust
target/
Cargo.lock

# env file
.env

# kept under ./tmp for local reference; not versioned
tmp

# Editor/IDE
# .idea/
# .vscode/

# Frontend (Vue/Vite)
node_modules/
dist/
*.local
*.tsbuildinfo
.DS_Store

# temp scratch (handoff, ad-hoc notes)
.tmp/
